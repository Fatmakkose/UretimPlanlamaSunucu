@{
    ViewData["Title"] = "Yetkilendirme Paneli";
    var users = ViewBag.Users as List<UretimPlanlama.Controllers.AuthorizationController.UserAuthorizationViewModel> ?? new();
    var roles = ViewBag.Roles as List<UretimPlanlama.Controllers.AuthorizationController.RoleAuthorizationViewModel> ?? new();

    var roleDefaultPermissionsMapJson = System.Text.Json.JsonSerializer.Serialize(
        roles.ToDictionary(r => r.RoleName, r => r.MappedPermissions)
    );
}

<style>
    /* Premium Tab & Nav Styles */
    .auth-tab-container {
        margin-bottom: 25px;
    }
    
    .auth-tabs {
        display: flex;
        gap: 10px;
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 10px;
        margin-bottom: 20px;
    }
    
    .auth-tab-btn {
        background: none;
        border: none;
        padding: 12px 24px;
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-muted);
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .auth-tab-btn:hover {
        color: var(--text-main);
        background-color: rgba(0, 71, 187, 0.05);
    }
    
    .auth-tab-btn.active {
        color: white;
        background-color: var(--primary-color);
        box-shadow: 0 4px 12px rgba(0, 71, 187, 0.2);
    }

    .tab-content-panel {
        display: none;
        animation: fadeIn 0.4s ease-out;
    }

    .tab-content-panel.active {
        display: block;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Table & Card Styles */
    .premium-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
        margin-top: -10px;
    }

    .premium-table th {
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 12px 20px;
        border: none;
        text-align: left;
    }

    .premium-table tr.user-row {
        background: white;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .premium-table tr.user-row:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(0,0,0,0.05);
    }

    .premium-table td {
        padding: 16px 20px;
        vertical-align: middle;
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
    }

    .premium-table td:first-child {
        border-left: 1px solid var(--border-color);
        border-top-left-radius: 10px;
        border-bottom-left-radius: 10px;
    }

    .premium-table td:last-child {
        border-right: 1px solid var(--border-color);
        border-top-right-radius: 10px;
        border-bottom-right-radius: 10px;
    }

    /* Custom Toggles */
    .toggle-container {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .toggle-item {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #f8fafc;
        padding: 6px 12px;
        border-radius: 20px;
        border: 1px solid var(--border-color);
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-muted);
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }

    .toggle-item:hover {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: var(--text-main);
    }

    .toggle-item input[type="checkbox"] {
        appearance: none;
        width: 16px;
        height: 16px;
        border: 2px solid var(--text-muted);
        border-radius: 4px;
        outline: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        background: white;
    }

    .toggle-item input[type="checkbox"]:checked {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

    .toggle-item input[type="checkbox"]:checked::after {
        content: "\f00c";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        color: white;
        font-size: 0.65rem;
    }

    .toggle-item.checked {
        background-color: rgba(0, 71, 187, 0.08);
        border-color: rgba(0, 71, 187, 0.3);
        color: var(--primary-hover);
    }

    /* Search and Filter Box */
    .search-filter-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 15px;
    }

    .auth-search {
        position: relative;
        flex-grow: 1;
        max-width: 400px;
    }

    .auth-search i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
    }

    .auth-search input {
        width: 100%;
        background-color: white;
        border: 1px solid var(--border-color);
        padding: 10px 16px 10px 45px;
        border-radius: 8px;
        outline: none;
        font-size: 0.9rem;
        transition: all 0.2s;
    }

    .auth-search input:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(0, 71, 187, 0.1);
    }

    /* Role Cards */
    .role-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 24px;
        margin-top: 10px;
    }

    .role-card {
        background: white;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 6px rgba(0,0,0,0.01);
        padding: 24px;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 250px;
    }

    .role-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.04);
        border-color: rgba(0, 71, 187, 0.3);
    }

    .role-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .role-title-input {
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--text-main);
        border: 1px solid transparent;
        background: transparent;
        padding: 4px 8px;
        border-radius: 6px;
        width: 80%;
        transition: all 0.2s;
    }

    .role-title-input:focus {
        background: var(--bg-color);
        border-color: var(--border-color);
        outline: none;
    }

    .inherited-badge {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
    }
</style>

<div class="dashboard-header" style="margin-bottom: 25px;">
    <div class="header-title">
        <h1 style="font-size: 1.8rem; margin: 0; color: var(--text-main);">Sistem Yetkilendirme Paneli</h1>
    </div>
</div>

<!-- Global Success / Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div style="background-color: var(--success-bg); color: var(--success-text); padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid rgba(13, 148, 136, 0.2); display: flex; align-items: center; gap: 10px; animation: slideInUp 0.3s;">
        <i class="fa-solid fa-circle-check" style="font-size: 1.2rem;"></i> 
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="background-color: var(--danger-bg); color: var(--danger-text); padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid rgba(220, 38, 38, 0.2); display: flex; align-items: center; gap: 10px; animation: slideInUp 0.3s;">
        <i class="fa-solid fa-circle-exclamation" style="font-size: 1.2rem;"></i> 
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<div class="auth-tab-container">
    <div class="auth-tabs">
        <button class="auth-tab-btn active" onclick="switchTab(event, 'tab-users')">
            <i class="fa-solid fa-users"></i> Kullanıcı Yetkilendirmesi
        </button>
        <button class="auth-tab-btn" onclick="switchTab(event, 'tab-roles')">
            <i class="fa-solid fa-tags"></i> Rol ve Yetki Yönetimi
        </button>
    </div>

    <!-- TAB 1: USER AUTHORIZATION -->
    <div id="tab-users" class="tab-content-panel active">
        <div class="schedule-section">
            <div class="search-filter-bar">
                <div class="auth-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="userSearchInput" placeholder="Kullanıcı adı veya e-posta ile ara..." onkeyup="filterUsers()" />
                </div>
                <div style="display: flex; align-items: center; gap: 15px;">
                    <button type="button" class="btn-planner" onclick="openAddUserModal()" style="padding: 10px 18px; font-size: 0.85rem; font-weight: 700; border-radius: 8px; gap: 6px; display: inline-flex; align-items: center; justify-content: center; border: none; cursor: pointer;">
                        <i class="fa-solid fa-user-plus"></i> Yeni Kullanıcı Tanımla
                    </button>
                    <div style="color: var(--text-muted); font-size: 0.85rem; font-weight: 500;">
                        Toplam <span id="userCountSpan" style="color: var(--text-main); font-weight: 700;">@users.Count</span> kullanıcı listeleniyor.
                    </div>
                </div>
            </div>

            <div style="overflow-x: auto;">
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th style="width: 250px;">Kullanıcı</th>
                            <th style="width: 180px;">Sistem Rolü</th>
                            <th>Özel Yetkiler (Claims-Based)</th>
                            <th style="width: 120px; text-align: right;">Aksiyon</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody">
                        @foreach (var user in users)
                        {
                            <tr class="user-row" data-name="@user.FullName.ToLower()" data-email="@user.Email.ToLower()">
                                <form action="/Authorization/SaveUserPermissions" method="post">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 12px;">
                                            <img src="https://ui-avatars.com/api/?name=@user.FullName&background=0047bb&color=fff&size=40" alt="Avatar" style="border-radius: 50%; width: 40px; height: 40px; box-shadow: 0 2px 6px rgba(0,0,0,0.05);" />
                                            <div style="display: flex; flex-direction: column;">
                                                <span style="font-weight: 700; font-size: 0.95rem; color: var(--text-main);">@user.FullName</span>
                                                <span style="font-size: 0.75rem; color: var(--text-muted);">@user.Email</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <select name="assignedRole" class="form-control" style="padding: 6px 12px; font-size: 0.85rem;" onchange="handleRoleChange(this, '@user.UserId')">
                                            @foreach (var role in roles)
                                            {
                                                <!option value="@role.RoleName" @(user.AssignedRole == role.RoleName ? "selected" : "")>
                                                    @role.RoleName
                                                </!option>
                                            }
                                        </select>
                                        <div style="font-size: 0.7rem; color: var(--text-muted); margin-top: 4px; margin-left: 4px;">
                                            Unvan: <strong>@user.RoleTitle</strong>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="toggle-container">
                                            @{
                                                var permissions = new[] { 
                                                    new { Key = "View", Label = "Görüntüleme", Icon = "fa-eye" },
                                                    new { Key = "Write", Label = "Yazma", Icon = "fa-pen-to-square" },
                                                    new { Key = "Delete", Label = "Silme", Icon = "fa-trash-can" },
                                                    new { Key = "Admin", Label = "Yönetici", Icon = "fa-shield-halved" },
                                                    new { Key = "Page_Planlama", Label = "Planlama", Icon = "fa-chart-pie" },
                                                    new { Key = "Page_Depo", Label = "Depo", Icon = "fa-boxes-stacked" },
                                                    new { Key = "Page_Surec", Label = "Süreç Takip", Icon = "fa-truck-fast" },
                                                    new { Key = "Page_Siparis", Label = "Siparişler", Icon = "fa-cart-shopping" },
                                                    new { Key = "Page_Rapor", Label = "Raporlar", Icon = "fa-chart-line" }
                                                };
                                            }
                                            @foreach (var p in permissions)
                                            {
                                                var hasDirect = user.DirectPermissions.Contains(p.Key);
                                                var hasInherited = user.InheritedPermissions.Contains(p.Key);
                                                var isChecked = hasDirect || hasInherited || user.AssignedRole == "Admin";
                                                
                                                <label class="toggle-item @(isChecked ? "checked" : "")" id="lbl-@user.UserId-@p.Key" style="@(user.AssignedRole == "Admin" ? "opacity: 0.7; pointer-events: none;" : "")">
                                                    <input type="checkbox" name="permissions" value="@p.Key" @(isChecked ? "checked" : "") 
                                                           style="margin: 0;"
                                                           data-userid="@user.UserId"
                                                           data-permission="@p.Key"
                                                           data-inherited="@(hasInherited ? "true" : "false")"
                                                           onclick="toggleCheckClass(this, '@user.UserId', '@p.Key')"
                                                           @(user.AssignedRole == "Admin" ? "disabled" : "") />
                                                    <i class="fa-solid @p.Icon" style="font-size: 0.8rem;"></i>
                                                    <span>@p.Label</span>

                                                </label>
                                            }
                                        </div>
                                    </td>
                                    <td style="text-align: right;">
                                        <button type="submit" class="btn-planner" style="padding: 8px 14px; font-size: 0.8rem; font-weight: 700; border-radius: 6px; gap: 4px; display: inline-flex;">
                                            <i class="fa-solid fa-floppy-disk"></i> Kaydet
                                        </button>
                                    </td>
                                </form>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 2: ROLE MANAGEMENT -->
    <div id="tab-roles" class="tab-content-panel">
        <div class="dashboard-grid" style="grid-template-columns: 2fr 1fr; gap: 24px;">
            <!-- Left Side: Role List & Claim Configuration -->
            <div class="schedule-section">
                <div class="section-header" style="margin-bottom: 20px;">
                    <div>
                        <h2 style="font-size: 1.2rem; font-weight: 700;">Mevcut Roller ve İzinler</h2>
                        <p style="font-size: 0.85rem; color: var(--text-muted);">Her role atanan varsayılan erişim yetkilerini kontrol edin.</p>
                    </div>
                </div>

                <div class="role-grid">
                    @foreach (var role in roles)
                    {
                        <div class="role-card">
                            <form action="/Authorization/UpdateRolePermissions" method="post" style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
                                <input type="hidden" name="roleId" value="@role.RoleId" />
                                
                                <div>
                                    <div class="role-card-header">
                                        <input type="text" name="roleName" class="role-title-input" value="@role.RoleName" 
                                               @(role.RoleName == "Admin" || role.RoleName == "User" ? "readonly" : "") 
                                               title="@(role.RoleName == "Admin" || role.RoleName == "User" ? "Sistem rol adı değiştirilemez." : "Rol adını düzenlemek için tıklayın.")" />
                                        
                                        @if (role.RoleName == "Admin")
                                        {
                                            <span class="badge badge-high" style="font-size: 0.7rem; border-radius: 6px; padding: 4px 8px;">Kilitli</span>
                                        }
                                        else if (role.RoleName == "User")
                                        {
                                            <span class="badge badge-low" style="font-size: 0.7rem; border-radius: 6px; padding: 4px 8px;">Standart</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-scheduled" style="font-size: 0.7rem; border-radius: 6px; padding: 4px 8px;">Özel</span>
                                        }
                                    </div>
                                    
                                    <div style="border-top: 1px solid var(--border-color); padding: 15px 0 10px 0; margin-top: 5px;">
                                        <h4 style="margin: 0 0 10px 0; font-size: 0.8rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Default Yetkileri</h4>
                                        <div style="display: flex; flex-direction: column; gap: 10px;">
                                            @{
                                                var rolePermissions = new[] { 
                                                    new { Key = "View", Label = "Görüntüleme (Read)", Icon = "fa-eye" },
                                                    new { Key = "Write", Label = "Yazma / Kayıt (Write)", Icon = "fa-pen-to-square" },
                                                    new { Key = "Delete", Label = "Veri Silme (Delete)", Icon = "fa-trash-can" },
                                                    new { Key = "Admin", Label = "Sistem Yönetimi (Admin)", Icon = "fa-shield-halved" },
                                                    new { Key = "Page_Planlama", Label = "Planlama Sayfası", Icon = "fa-chart-pie" },
                                                    new { Key = "Page_Depo", Label = "Depo Sayfası", Icon = "fa-boxes-stacked" },
                                                    new { Key = "Page_Surec", Label = "Süreç Takip Sayfası", Icon = "fa-truck-fast" },
                                                    new { Key = "Page_Siparis", Label = "Siparişler Sayfası", Icon = "fa-cart-shopping" },
                                                    new { Key = "Page_Rapor", Label = "Raporlar Sayfası", Icon = "fa-chart-line" }
                                                };
                                            }
                                            @foreach (var p in rolePermissions)
                                            {
                                                var isChecked = role.MappedPermissions.Contains(p.Key) || role.RoleName == "Admin";
                                                <label class="toggle-item @(isChecked ? "checked" : "")" id="lbl-role-@role.RoleId-@p.Key" style="width: 100%; justify-content: flex-start; @(role.RoleName == "Admin" ? "opacity: 0.7; pointer-events: none;" : "")">
                                                    <input type="checkbox" name="permissions" value="@p.Key" @(isChecked ? "checked" : "") 
                                                           onclick="toggleRoleCheckClass(this, '@role.RoleId', '@p.Key')"
                                                           @(role.RoleName == "Admin" ? "disabled" : "") />
                                                    <i class="fa-solid @p.Icon" style="width: 18px;"></i>
                                                    <span>@p.Label</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div style="display: flex; gap: 10px; border-top: 1px solid var(--border-color); padding-top: 15px; margin-top: 15px;">
                                    <button type="submit" class="btn-planner" style="flex-grow: 1; justify-content: center; font-size: 0.8rem; padding: 8px 12px; border-radius: 6px;">
                                        <i class="fa-solid fa-save"></i> Değişiklikleri Kaydet
                                    </button>
                                    @if (role.RoleName != "Admin" && role.RoleName != "User")
                                    {
                                        <button type="button" class="btn-secondary" style="color: var(--danger-text); border-color: rgba(220, 38, 38, 0.2); padding: 8px 12px; border-radius: 6px;" onclick="confirmDeleteRole('@role.RoleId', '@role.RoleName')">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    }
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Side: Create New Role -->
            <div class="resources-section">
                <div class="section-header" style="margin-bottom: 20px;">
                    <div>
                        <h2 style="font-size: 1.2rem; font-weight: 700;">Yeni Rol Ekle</h2>
                        <p style="font-size: 0.85rem; color: var(--text-muted);">Sistemde kullanılmak üzere özel bir yetki grubu tanımlayın.</p>
                    </div>
                </div>

                <form action="/Authorization/CreateRole" method="post" style="display: flex; flex-direction: column; gap: 16px;">
                    <div class="form-group">
                        <label for="roleNameInput">Rol Adı</label>
                        <input type="text" id="roleNameInput" name="roleName" class="form-control" placeholder="Örn: Planlama Müdürü, Operatör..." required />
                        <span style="font-size: 0.75rem; color: var(--text-muted); margin-top: 5px; display: block; line-height: 1.3;">Harf, rakam ve boşluk içerebilir. Kaydetmeden önce rol ismini benzersiz yapın.</span>
                    </div>

                    <button type="submit" class="btn-optimize" style="margin-top: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 0.9rem; padding: 12px;">
                        <i class="fa-solid fa-plus"></i> Yeni Rol Oluştur
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Dialog for Role Deletion -->
<div id="deleteRoleModal" style="display: none; position: fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(15, 23, 42, 0.6); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: white; border-radius: 12px; border: 1px solid var(--border-color); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); width: 450px; padding: 24px; animation: slideInUp 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);">
        <h3 style="margin-top:0; font-size:1.2rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 10px;">
            <i class="fa-solid fa-circle-exclamation" style="color: var(--danger-text);"></i> Rolü Silmek İstiyor musunuz?
        </h3>
        <p style="color: var(--text-muted); font-size:0.85rem; line-height: 1.5; margin: 15px 0;">
            <strong id="deleteRoleNameText" style="color: var(--text-main);"></strong> rolü sistemden tamamen kaldırılacaktır. Bu role bağlı kullanıcıların varsayılan yetkileri etkilenebilir. Bu işlem geri alınamaz.
        </p>
        <form id="deleteRoleForm" action="/Authorization/DeleteRole" method="post" style="display: flex; justify-content: flex-end; gap: 12px; margin: 0;">
            <input type="hidden" name="roleId" id="deleteRoleIdInput" value="" />
            <button type="button" class="btn-secondary" onclick="closeDeleteModal()" style="font-size: 0.85rem; padding: 8px 16px;">İptal</button>
            <button type="submit" class="btn-planner" style="background: var(--danger-text); border-color: var(--danger-text); font-size: 0.85rem; padding: 8px 16px;">Evet, Rolü Sil</button>
        </form>
    </div>
</div>

<!-- Modal Dialog for User Creation -->
<div id="addUserModal" style="display: none; position: fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(15, 23, 42, 0.6); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: white; border-radius: 12px; border: 1px solid var(--border-color); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); width: 480px; padding: 28px; animation: slideInUp 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);">
        <h3 style="margin-top:0; margin-bottom: 20px; font-size:1.3rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 10px;">
            <i class="fa-solid fa-user-plus" style="color: var(--primary-color);"></i> Yeni Kullanıcı Tanımla
        </h3>
        
        <form action="/Authorization/CreateUser" method="post" style="display: flex; flex-direction: column; gap: 16px; margin: 0;">
            <div class="form-group">
                <label for="newFullName" style="font-weight: 600; font-size: 0.85rem; margin-bottom: 6px; display: block;">Adı Soyadı</label>
                <input type="text" id="newFullName" name="fullName" class="form-control" placeholder="Örn: Ahmet Yılmaz" required style="width: 100%; box-sizing: border-box; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color);" />
            </div>

            <div class="form-group">
                <label for="newEmail" style="font-weight: 600; font-size: 0.85rem; margin-bottom: 6px; display: block;">E-Posta Adresi</label>
                <input type="email" id="newEmail" name="email" class="form-control" placeholder="Örn: ahmet@kanunitekstil.com" required style="width: 100%; box-sizing: border-box; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color);" />
            </div>

            <div class="form-group">
                <label for="newPassword" style="font-weight: 600; font-size: 0.85rem; margin-bottom: 6px; display: block;">Geçici Şifre</label>
                <input type="password" id="newPassword" name="password" class="form-control" placeholder="Min. 6 karakter, büyük harf, rakam ve sembol" required style="width: 100%; box-sizing: border-box; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color);" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="form-group">
                    <label for="newAssignedRole" style="font-weight: 600; font-size: 0.85rem; margin-bottom: 6px; display: block;">Sistem Rolü</label>
                    <select id="newAssignedRole" name="assignedRole" class="form-control" style="width: 100%; box-sizing: border-box; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); height: auto;">
                        @foreach (var role in roles)
                        {
                            <option value="@role.RoleName">@role.RoleName</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="newRoleTitle" style="font-weight: 600; font-size: 0.85rem; margin-bottom: 6px; display: block;">Görev Unvanı</label>
                    <input type="text" id="newRoleTitle" name="roleTitle" class="form-control" placeholder="Örn: Operatör, Üretim Şefi" style="width: 100%; box-sizing: border-box; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color);" />
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 15px; border-top: 1px solid var(--border-color); padding-top: 18px;">
                <button type="button" class="btn-secondary" onclick="closeAddUserModal()" style="font-size: 0.85rem; padding: 8px 16px; border-radius: 6px;">İptal</button>
                <button type="submit" class="btn-planner" style="font-size: 0.85rem; padding: 8px 16px; border-radius: 6px; font-weight: 700;">Kullanıcıyı Oluştur</button>
            </div>
        </form>
    </div>
</div>

<script>
    // Tab switching engine
    function switchTab(evt, tabId) {
        // Deactivate all tabs
        const tabButtons = document.getElementsByClassName("auth-tab-btn");
        for (let i = 0; i < tabButtons.length; i++) {
            tabButtons[i].classList.remove("active");
        }
        
        const tabPanels = document.getElementsByClassName("tab-content-panel");
        for (let i = 0; i < tabPanels.length; i++) {
            tabPanels[i].classList.remove("active");
        }
        
        // Activate target tab
        evt.currentTarget.classList.add("active");
        document.getElementById(tabId).classList.add("active");
        
        // Save current active tab in local storage
        localStorage.setItem("activeAuthTab", tabId);
    }
    
    // Check and set active tab on page load
    document.addEventListener("DOMContentLoaded", function() {
        const storedTab = localStorage.getItem("activeAuthTab");
        if (storedTab) {
            const btn = document.querySelector(`[onclick*="${storedTab}"]`);
            if (btn) {
                btn.click();
            }
        }
    });

    // Checkbox custom label coloring updates
    function toggleCheckClass(checkbox, userId, key) {
        const label = document.getElementById(`lbl-${userId}-${key}`);
        if (checkbox.checked) {
            label.classList.add("checked");
        } else {
            label.classList.remove("checked");
        }
    }

    function toggleRoleCheckClass(checkbox, roleId, key) {
        const label = document.getElementById(`lbl-role-${roleId}-${key}`);
        if (checkbox.checked) {
            label.classList.add("checked");
        } else {
            label.classList.remove("checked");
        }
    }

    // Interactive updates when user role is changed dropdown-side
    function handleRoleChange(selectElement, userId) {
        const selectedRole = selectElement.value;
        
        // Disable checkboxes if Admin is selected
        const checkboxes = document.querySelectorAll(`input[data-userid="${userId}"]`);
        checkboxes.forEach(chk => {
            const permission = chk.getAttribute("data-permission");
            const label = document.getElementById(`lbl-${userId}-${permission}`);
            
            if (selectedRole === "Admin") {
                chk.checked = true;
                chk.disabled = true;
                label.classList.add("checked");
                label.style.opacity = "0.7";
                label.style.pointerEvents = "none";
            } else {
                chk.disabled = false;
                label.style.opacity = "";
                label.style.pointerEvents = "";
                
                // Inherit permission from the select role default claims (using roles default mapped data)
                const roleData = getRoleDefaults(selectedRole);
                const hasInherited = roleData.includes(permission);
                
                chk.setAttribute("data-inherited", hasInherited ? "true" : "false");
                chk.checked = hasInherited;
                
                if (hasInherited) {
                    label.classList.add("checked");
                } else {
                    label.classList.remove("checked");
                }
            }
        });
    }

    // Helper JSON map loaded from server models
    const roleDefaultPermissionsMap = @Html.Raw(roleDefaultPermissionsMapJson);

    function getRoleDefaults(roleName) {
        return roleDefaultPermissionsMap[roleName] || [];
    }

    // Filter list search box
    function filterUsers() {
        const query = document.getElementById("userSearchInput").value.toLowerCase();
        const rows = document.querySelectorAll("#usersTableBody tr.user-row");
        let visibleCount = 0;
        
        rows.forEach(row => {
            const name = row.getAttribute("data-name") || "";
            const email = row.getAttribute("data-email") || "";
            if (name.includes(query) || email.includes(query)) {
                row.style.display = "";
                visibleCount++;
            } else {
                row.style.display = "none";
            }
        });
        
        document.getElementById("userCountSpan").innerText = visibleCount;
    }

    // Role Deletion Modals
    function confirmDeleteRole(roleId, roleName) {
        document.getElementById("deleteRoleIdInput").value = roleId;
        document.getElementById("deleteRoleNameText").innerText = roleName;
        document.getElementById("deleteRoleModal").style.display = "flex";
    }

    function closeDeleteModal() {
        document.getElementById("deleteRoleModal").style.display = "none";
    }

    // User Creation Modals
    function openAddUserModal() {
        document.getElementById("addUserModal").style.display = "flex";
    }

    function closeAddUserModal() {
        document.getElementById("addUserModal").style.display = "none";
        document.getElementById("newFullName").value = "";
        document.getElementById("newEmail").value = "";
        document.getElementById("newPassword").value = "";
        document.getElementById("newRoleTitle").value = "";
    }

    // Close modal on escape key
    window.addEventListener("keydown", function(e) {
        if (e.key === "Escape") {
            closeDeleteModal();
            closeAddUserModal();
        }
    });
</script>
