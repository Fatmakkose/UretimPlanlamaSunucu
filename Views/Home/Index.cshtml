<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    var allOrdersKpiData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(o => {
        var kBucket = GetKpiBucket(o);
        var stat = o.Status;
        if (string.IsNullOrEmpty(stat)) {
            if (kBucket == "cutting") stat = "Kesimde";
            else if (kBucket == "completed") stat = "Tamamlandı";
            else stat = "Yeni Kayıt";
        }
        return new {
            id = o.Id,
            code = o.OrderCode,
            model = o.ModelName,
            customer = string.IsNullOrEmpty(o.Customer) ? "-" : o.Customer,
            color = string.IsNullOrEmpty(o.Color) ? "" : o.Color,
            qty = o.CalculatedQuantity,
            status = stat,
            kpiBucket = kBucket,
            date = o.OrderDate.ToString("dd.MM.yyyy")
        };
    })));

    var currentModalKpi = 'all';

    function filterKpiCard(kpiBucket, event) {
        if (event) event.stopPropagation();

        // Kart aktif sınıflarını güncelle
        document.querySelectorAll('.clickable-stat-card').forEach(function(card) {
            if (card.getAttribute('data-kpi') === kpiBucket) {
                card.classList.add('active-kpi-card');
            } else {
                card.classList.remove('active-kpi-card');
            }
        });

        // Tablo satırlarını süz
        var rows = document.querySelectorAll('.kpi-table-row');
        var visibleCount = 0;

        rows.forEach(function(row) {
            var rowBucket = row.getAttribute('data-kpi-status');
            if (kpiBucket === 'all' || rowBucket === kpiBucket) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        // Başlık ve Filtre Rozetini Güncelle
        var titleEl = document.getElementById('activeOrdersTitle');
        var badgeEl = document.getElementById('kpiFilterBadge');
        var resetBtn = document.getElementById('btnResetKpiFilter');
        var footerText = document.getElementById('activeOrdersFooterText');

        if (kpiBucket === 'all') {
            titleEl.textContent = 'Aktif Üretim Bantları';
            badgeEl.style.display = 'none';
            resetBtn.style.display = 'none';
            if (footerText) footerText.textContent = 'Toplam ' + visibleCount + ' aktif iş emri listeleniyor.';
        } else {
            var labels = {
                'waiting': 'Üretim Bekleyenler',
                'cutting': 'Aktif Kesimde Olanlar',
                'completed': 'Kesimi Tamamlananlar'
            };
            var labelText = labels[kpiBucket] || kpiBucket;
            titleEl.textContent = 'Aktif Üretim Bantları';
            badgeEl.textContent = labelText + ' (' + visibleCount + ' sipariş)';
            badgeEl.style.display = 'inline-block';
            resetBtn.style.display = 'inline-block';
            if (footerText) footerText.textContent = labelText + ' kapsamında ' + visibleCount + ' iş emri gösteriliyor.';
        }

        // Tıklandığında tabloya yumuşak kaydır
        if (event && event.type === 'click') {
            var tableCard = document.getElementById('activeOrdersTableCard');
            if (tableCard) {
                tableCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }
    }

    function openKpiModal(kpiBucket, titleText) {
        currentModalKpi = kpiBucket;
        document.getElementById('kpiModalSearch').value = '';
        var titleElem = document.getElementById('modalKpiTitleText');
        if (titleElem) titleElem.textContent = titleText || 'Sipariş Detayları';

        var btnOrders = document.getElementById('btnGoToOrdersPage');
        if (btnOrders) {
            btnOrders.href = '/Order?status=' + kpiBucket;
        }

        renderModalOrders();
        var modal = document.getElementById('kpiDetailModal');
        if (modal) {
            modal.style.display = 'flex';
        }
    }

    function closeKpiModal() {
        var modal = document.getElementById('kpiDetailModal');
        if (modal) {
            modal.style.display = 'none';
        }
    }

    function filterModalOrders() {
        renderModalOrders();
    }

    function renderModalOrders() {
        var tbody = document.getElementById('modalOrdersTbody');
        if (!tbody) return;

        var searchQuery = (document.getElementById('kpiModalSearch').value || '').toLowerCase().trim();

        var filtered = allOrdersKpiData.filter(function(o) {
            var matchesKpi = (currentModalKpi === 'all' || o.kpiBucket === currentModalKpi);
            if (!matchesKpi) return false;

            if (!searchQuery) return true;

            var matchCode = (o.code || '').toLowerCase().includes(searchQuery);
            var matchModel = (o.model || '').toLowerCase().includes(searchQuery);
            var matchCustomer = (o.customer || '').toLowerCase().includes(searchQuery);
            return matchCode || matchModel || matchCustomer;
        });

        document.getElementById('modalKpiCount').textContent = 'Toplam ' + filtered.length + ' sipariş listelendi.';

        if (filtered.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding: 40px; color: #94a3b8;">Aradığınız kriterlere uygun sipariş bulunamadı.</td></tr>';
            return;
        }

        var html = '';
        filtered.forEach(function(o) {
            var badgeBg = '#e0f2fe';
            var badgeColor = '#0284c7';
            if (o.kpiBucket === 'cutting') { badgeBg = '#fef3c7'; badgeColor = '#d97706'; }
            else if (o.kpiBucket === 'completed') { badgeBg = '#dcfce7'; badgeColor = '#15803d'; }

            html += '<tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.15s;" onmouseover="this.style.background=\'#f8fafc\'" onmouseout="this.style.background=\'transparent\'">' +
                '<td style="padding: 10px; font-weight: 700; color: #0369a1; font-family: monospace;">' + o.code + '</td>' +
                '<td style="padding: 10px; font-weight: 600; color: #1e293b;">' + o.model + '</td>' +
                '<td style="padding: 10px; color: #64748b; font-size: 0.85rem;">' + o.customer + (o.color ? ' <span style="font-size:0.75rem; background:#f1f5f9; color:#475569; padding:2px 6px; border-radius:4px; margin-left: 4px;">' + o.color + '</span>' : '') + '</td>' +
                '<td style="padding: 10px; text-align: right; font-weight: 700; color: #0f172a;">' + (o.qty ? o.qty.toLocaleString('tr-TR') : '0') + ' Adet</td>' +
                '<td style="padding: 10px;"><span style="background:' + badgeBg + '; color:' + badgeColor + '; padding: 3px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;">' + o.status + '</span></td>' +
                '<td style="padding: 10px; text-align: center;"><a href="/ProcessTracking/Track/' + o.id + '" style="background: #0369a1; color: white; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;"><i class="fa-solid fa-diagram-project"></i> İşleme Git</a></td>' +
                '</tr>';
        });

        tbody.innerHTML = html;
    }

    document.addEventListener("DOMContentLoaded", function () {
        var ctx = document.getElementById('stageChart')?.getContext('2d');
        if (ctx) {
            var stageData = @Html.Raw(Json.Serialize(ViewBag.StageDistribution ?? new[] { 0, 0, 0, 0 }));
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Yeni Kayıt / Bekleyen', 'Kesim Aşamasında', 'Dikim Aşamasında', 'Paketleme / Sevk'],
                    datasets: [{
                        data: stageData,
                        backgroundColor: [
                            '#94a3b8', // gri
                            '#0284c7', // mavi
                            '#16a34a', // yeşil
                            '#4f46e5'  // lacivert
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                padding: 20,
                                font: {
                                    size: 11
                                }
                            }
                        }
                    }
                }
            });
        }

        var perfCtx = document.getElementById('performanceChart')?.getContext('2d');
        if (perfCtx) {
            var perfDataJson = '@Html.Raw(ViewBag.WorkshopPerformanceJson ?? "[]")';
            var perfData = [];
            try { perfData = JSON.parse(perfDataJson); } catch (e) {}
            
            var labels = perfData.map(function(d) { return d.Workshop; });
            var onTimeData = perfData.map(function(d) { return d.OnTime; });
            var delayedData = perfData.map(function(d) { return d.Delayed; });
            var successRateData = perfData.map(function(d) { return d.SuccessRate; });
            
            if (perfData.length === 0) {
                // Veri yoksa mesaj göster
                var canvas = document.getElementById('performanceChart');
                var ctx = canvas.getContext('2d');
                ctx.font = "14px Arial";
                ctx.fillStyle = "#94a3b8";
                ctx.textAlign = "center";
                ctx.fillText("Yeterli termin/paket bitiş verisi yok", canvas.width/2, canvas.height/2);
            } else {
                new Chart(perfCtx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                type: 'line',
                                label: 'Başarı Oranı (%)',
                                data: successRateData,
                                borderColor: '#0284c7',
                                backgroundColor: '#0284c7',
                                borderWidth: 2,
                                tension: 0.3,
                                yAxisID: 'y1'
                            },
                            {
                                type: 'bar',
                                label: 'Zamanında',
                                data: onTimeData,
                                backgroundColor: '#10b981',
                                borderRadius: 4,
                                yAxisID: 'y'
                            },
                            {
                                type: 'bar',
                                label: 'Geciken',
                                data: delayedData,
                                backgroundColor: '#ef4444',
                                borderRadius: 4,
                                yAxisID: 'y'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: { stacked: true },
                            y: { 
                                stacked: true, 
                                beginAtZero: true,
                                title: { display: true, text: 'Sipariş Sayısı' }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                min: 0,
                                max: 100,
                                title: { display: true, text: 'Başarı Oranı (%)' },
                                grid: { drawOnChartArea: false }
                            }
                        },
                        plugins: {
                            legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 10 } },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                                callbacks: {
                                    label: function(context) {
                                        if (context.datasetIndex === 0) return context.dataset.label + ': %' + context.raw;
                                        return context.dataset.label + ': ' + context.raw + ' Sipariş';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        }


        // Bildirimleri Temizle Butonu
        document.getElementById('btnClearNotifications')?.addEventListener('click', function() {
            Swal.fire({
                title: 'Emin misiniz?',
                text: 'Tüm hareket geçmişini silmek istediğinize emin misiniz?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Evet, Sil',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/Home/ClearNotifications', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            window.location.reload();
                        } else {
                            Swal.fire({ icon: 'error', title: 'Hata!', text: data.message || 'Silinemedi.', confirmButtonColor: '#ef4444' });
                        }
                    })
                    .catch(err => {
                        Swal.fire({ icon: 'error', title: 'Hata!', text: 'Bir hata oluştu.', confirmButtonColor: '#ef4444' });
                    });
                }
            });
        });

        // Dışarı tıklandığında modalı kapat
        window.addEventListener('click', function(e) {
            var modal = document.getElementById('kpiDetailModal');
            if (e.target === modal) {
                closeKpiModal();
            }
        });
        
        // --- KANBAN ATÖLYE ATAMA ---
        const draggables = document.querySelectorAll('.kanban-card');
        const dropzones = document.querySelectorAll('.kanban-dropzone');

        draggables.forEach(draggable => {
            draggable.addEventListener('dragstart', () => {
                draggable.classList.add('dragging');
                draggable.style.opacity = '0.5';
            });

            draggable.addEventListener('dragend', () => {
                draggable.classList.remove('dragging');
                draggable.style.opacity = '1';
            });
        });

        dropzones.forEach(zone => {
            zone.addEventListener('dragover', e => {
                e.preventDefault();
                zone.style.background = '#e2e8f0';
            });

            zone.addEventListener('dragleave', e => {
                zone.style.background = 'transparent';
            });

            zone.addEventListener('drop', e => {
                e.preventDefault();
                zone.style.background = 'transparent';
                const draggable = document.querySelector('.dragging');
                if (draggable) {
                    const originalZone = draggable.parentElement;
                    zone.appendChild(draggable);
                    
                    const orderId = draggable.getAttribute('data-order-id');
                    const workshopName = zone.getAttribute('data-workshop');
                    
                    const originalDropzone = originalZone.closest('.kanban-dropzone');
                    const originalWorkshopName = originalDropzone ? originalDropzone.getAttribute('data-workshop') : null;
                    
                    // Sadece bir atölyeye veya havuza atandığında AJAX at (Havuz alanında workshop name boştur)
                    if (workshopName !== null && workshopName !== originalWorkshopName) {
                        // Eğer assigned-orders divi varsa içine ekle, yoksa zone'un direkt içine (havuz)
                        const assignedOrdersDiv = zone.querySelector('.assigned-orders');
                        if (assignedOrdersDiv) {
                            assignedOrdersDiv.appendChild(draggable);
                            assignedOrdersDiv.style.display = 'flex'; // Göstermeyi garantile
                        } else {
                            zone.appendChild(draggable);
                        }
                        assignWorkshopToOrder(orderId, workshopName, false, false, null, draggable, originalZone);
                    } else if (workshopName === originalWorkshopName) {
                        // Aynı yere bırakıldıysa AJAX atma, sadece UI'ı toparla
                        const assignedOrdersDiv = zone.querySelector('.assigned-orders');
                        if (assignedOrdersDiv) {
                            assignedOrdersDiv.appendChild(draggable);
                        } else {
                            zone.appendChild(draggable);
                        }
                    }
                }
            });
        });
        
        function assignWorkshopToOrder(orderId, workshopName, forceAssign = false, forceShift = false, suggestedStartDate = null, draggableElement = null, originalZone = null) {
            Swal.fire({
                title: 'Atama İşlemi',
                text: 'Sipariş bu atölyeye atanıyor...',
                icon: 'info',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 1500
            });

            $.ajax({
                url: '/Home/AssignWorkshop',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ 
                    OrderId: parseInt(orderId), 
                    WorkshopName: workshopName,
                    ForceAssign: forceAssign,
                    ForceShift: forceShift,
                    SuggestedStartDate: suggestedStartDate
                }),
                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            title: 'Başarılı!',
                            text: 'Sipariş atölyeye atandı.',
                            icon: 'success',
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 2000
                        });
                        // Sayfayı yenilemeden kartı olduğu yerde bırakıyoruz
                    } else if (res.requiresConfirmation) {
                        Swal.fire({
                            title: 'Kapasite Uyarısı!',
                            text: res.message,
                            icon: 'warning',
                            showCancelButton: true,
                            showDenyButton: true,
                            showConfirmButton: !!res.suggestedStartDate,
                            confirmButtonColor: '#0ea5e9',
                            denyButtonColor: '#ef4444',
                            cancelButtonColor: '#94a3b8',
                            confirmButtonText: 'Evet, Kaydırarak Ata',
                            denyButtonText: 'Yine de Ata',
                            cancelButtonText: 'İptal'
                        }).then((result) => {
                            if (result.isConfirmed && res.suggestedStartDate) {
                                assignWorkshopToOrder(orderId, workshopName, false, true, res.suggestedStartDate, draggableElement, originalZone);
                            } else if (result.isDenied) {
                                assignWorkshopToOrder(orderId, workshopName, true, false, null, draggableElement, originalZone);
                            } else {
                                // Kullanıcı iptal ettiğinde kartı eski yerine al
                                if (draggableElement && originalZone) {
                                    originalZone.appendChild(draggableElement);
                                }
                            }
                        });
                    } else {
                        Swal.fire('Hata', 'Atama yapılamadı: ' + res.message, 'error');
                        if (draggableElement && originalZone) {
                            originalZone.appendChild(draggableElement);
                        }
                    }
                },
                error: function() {
                    Swal.fire('Hata', 'Sunucuya bağlanılamadı.', 'error');
                    if (draggableElement && originalZone) {
                        originalZone.appendChild(draggableElement);
                    }
                }
            });
        }
    });

    // Iframe Modal Functions
    function openOrderModal(event, orderId) {
        // Eğer sürükleme işlemi (drag) yapılıyorsa tıklama eventini yoksay.
        // `event.target` veya ebeveynlerinin draggable olup olmadığına bakabiliriz.
        // "dragging" class'ı aktifse işlemi iptal et.
        if(document.querySelector('.dragging')) return;

        const modal = document.getElementById('orderIframeModal');
        const iframe = document.getElementById('orderIframe');
        
        // Iframe kaynağını ayarla
        iframe.src = '/ProcessTracking/Track/' + orderId + '?hideLayout=true';
        
        // Modalı göster
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden'; // Arkaplanın kaymasını engelle
    }

    function closeOrderModal() {
        const modal = document.getElementById('orderIframeModal');
        const iframe = document.getElementById('orderIframe');
        
        modal.style.display = 'none';
        iframe.src = '';
        document.body.style.overflow = 'auto'; // Arkaplan kaydırmasını geri aç
    }

    function checkGenericIframeModal(iframe) {
        try {
            var url = iframe.contentWindow.location.pathname;
            if (url && (url.toLowerCase() === '/home/index' || url.toLowerCase() === '/home' || url === '/')) {
                // İşlem başarıyla tamamlandı ve listeye yönlendi
                window.location.reload();
            }
        } catch(e) {}
    }

    function openGenericIframeModal(url, title, iconClass) {
        document.getElementById('genericIframeTitle').innerText = title || 'İşlem';
        if(iconClass) {
            document.getElementById('genericIframeIcon').className = iconClass;
        }
        document.getElementById('genericIframeModal').style.display = 'flex';
        document.getElementById('genericIframe').src = url;
        document.body.style.overflow = 'hidden';
    }

    function closeGenericIframeModal() {
        document.getElementById('genericIframeModal').style.display = 'none';
        document.getElementById('genericIframe').src = '';
        document.body.style.overflow = 'auto';
    }

    function openWorkshopOrdersModal(safeWsName, wsDisplayName) {
        // Prevent click if drag is happening (optional safety check)
        const contentDiv = document.getElementById('ws-orders-' + safeWsName);
        if(!contentDiv) return;
        
        document.getElementById('wsModalTitle').textContent = wsDisplayName + ' Siparişleri';
        document.getElementById('wsModalBody').innerHTML = contentDiv.innerHTML;
        
        document.getElementById('workshopOrdersModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }



    function closeWorkshopOrdersModal() {
        document.getElementById('workshopOrdersModal').style.display = 'none';
        document.getElementById('wsModalBody').innerHTML = '';
        document.body.style.overflow = 'auto';
    }

    // --- SAYFALAMA (PAGINATION) JS ---
    let currentOrderPage = 1;
    let currentWorkshopPage = 1;
    const ITEMS_PER_PAGE = 3;

    function renderOrderPage() {
        const container = document.getElementById('order-list-container');
        if (!container) return;

        // Filtrelenmemiş öğeleri al
        const items = Array.from(container.querySelectorAll('.pg-order-item')).filter(i => !i.classList.contains('filtered-out'));
        const totalPages = Math.ceil(items.length / ITEMS_PER_PAGE) || 1;
        
        if (currentOrderPage < 1) currentOrderPage = 1;
        if (currentOrderPage > totalPages) currentOrderPage = totalPages;
        
        document.getElementById('order-page-info').textContent = currentOrderPage + '/' + totalPages;
        
        // Önce hepsini gizle (filtrelenmişler zaten none, diğerlerini de none yapıyoruz)
        container.querySelectorAll('.pg-order-item').forEach(item => {
            if (!item.classList.contains('filtered-out')) {
                item.style.display = 'none';
            }
        });

        // Sadece bulunduğumuz sayfaya ait olanları göster
        items.forEach((item, index) => {
            if (index >= (currentOrderPage - 1) * ITEMS_PER_PAGE && index < currentOrderPage * ITEMS_PER_PAGE) {
                item.style.display = 'flex';
            }
        });
    }

    function filterKanbanOrders() {
        const searchText = document.getElementById('kanbanSearchInput').value.toLowerCase();
        const container = document.getElementById('order-list-container');
        if (!container) return;

        const allItems = container.querySelectorAll('.pg-order-item');
        
        allItems.forEach(el => {
            const searchData = el.getAttribute('data-search') || '';
            if (searchData.includes(searchText)) {
                el.classList.remove('filtered-out');
                el.style.display = 'flex'; // Geçici gösterim, sayfalama onu düzeltecek
            } else {
                el.classList.add('filtered-out');
                el.style.display = 'none';
            }
        });
        
        // Filtreleme sonrası sayfalamayı tekrar hesapla (Sayfa 1'e dön)
        currentOrderPage = 1;
        renderOrderPage();
    }

    function changeOrderPage(dir) {
        currentOrderPage += dir;
        renderOrderPage();
    }

    function renderWorkshopPage() {
        const items = document.querySelectorAll('.pg-workshop-item');
        const totalPages = Math.ceil(items.length / ITEMS_PER_PAGE) || 1;
        if (currentWorkshopPage < 1) currentWorkshopPage = 1;
        if (currentWorkshopPage > totalPages) currentWorkshopPage = totalPages;
        
        document.getElementById('workshop-page-info').textContent = currentWorkshopPage + '/' + totalPages;
        
        items.forEach((item, index) => {
            if (index >= (currentWorkshopPage - 1) * ITEMS_PER_PAGE && index < currentWorkshopPage * ITEMS_PER_PAGE) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });
    }

    function changeWorkshopPage(dir) {
        currentWorkshopPage += dir;
        renderWorkshopPage();
    }

    document.addEventListener('DOMContentLoaded', () => {
        renderOrderPage();
        renderWorkshopPage();
    });
</script>

