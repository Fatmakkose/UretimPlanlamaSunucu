@model UretimPlanlama.Models.Order
@{
    ViewData["Title"] = "Sipariş Planlama";
    var allOrders = ViewBag.AllOrders as List<UretimPlanlama.Models.Order>;

    var prodData = new System.Collections.Generic.Dictionary<string, string>();
    if (!string.IsNullOrEmpty(Model.ProductionJson))
    {
        try {
            prodData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.ProductionJson);
        } catch {}
    }
    string GetProdVal(string key) => prodData != null && prodData.ContainsKey(key) ? prodData[key] : "";
}

<style>
    .planning-layout {
        display: flex;
        gap: 20px;
        align-items: stretch;
        min-height: calc(100vh - 80px);
    }
    
    .sidebar-orders {
        width: 300px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 10px;
        max-height: calc(100vh - 20px);
    }
    
    .sidebar-header {
        padding: 16px;
        border-bottom: 1px solid var(--border-color);
        background: #f8fafc;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: var(--text-main);
    }
    
    .order-list-item {
        padding: 16px;
        border-bottom: 1px solid var(--border-color);
        cursor: pointer;
        transition: background-color 0.2s;
        text-decoration: none;
        display: block;
        color: inherit;
    }
    
    .order-list-item:hover {
        background-color: #f1f5f9;
    }
    
    .order-list-item.active {
        border-left: 4px solid var(--primary-color);
        background-color: #f0f9ff;
    }
    
    .main-planning {
        flex-grow: 1;
        min-width: 0;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        padding: 24px;
    }
    
    .plan-tabs {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
    }
    
    .plan-tab {
        flex: 1;
        background: #f8fafc;
        border: 2px solid transparent;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }
    
    .plan-tab:hover {
        background: #f1f5f9;
    }
    
    .plan-tab.active {
        border-color: var(--primary-color);
        background: #f0f9ff;
    }
    
    .plan-tab i {
        font-size: 1.5rem;
        color: #64748b;
    }
    
    .plan-tab.active i {
        color: var(--primary-color);
    }
    
    .plan-tab-title {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--text-main);
    }
    
    .plan-tab-status {
        font-size: 0.75rem;
        font-weight: 700;
    }
    
    .status-complete { color: #16a34a; }
    .status-progress { color: #d97706; }
    .status-notstarted { color: #64748b; }
    
    .tab-content {
        display: none;
    }
    
    .tab-content.active {
        display: block;
    }
    
    .content-section {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }
    
    .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .data-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }
    
    .data-item {
        background: #f8fafc;
        padding: 12px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
    }
    
    .data-label {
        font-size: 0.75rem;
        color: #64748b;
        margin-bottom: 4px;
        font-weight: 600;
        text-transform: uppercase;
    }
    
    .data-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0f172a;
    }
    
    .input-field {
        width: 100%;
        padding: 8px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        font-size: 0.9rem;
    }
    
    .table-details {
        width: 100%;
        border-collapse: collapse;
        margin-top: 16px;
    }
    
    .table-details th {
        background: #f8fafc;
        padding: 12px;
        text-align: left;
        font-size: 0.8rem;
        color: #64748b;
        font-weight: 600;
        border-bottom: 2px solid #e2e8f0;
    }
    
    .table-details td {
        padding: 12px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 0.9rem;
    }
</style>

<div class="planning-layout">
    <!-- Sağ İçerik: Planlama Detayı -->
    @if (Model != null && Model.Id > 0)
    {
        <div class="main-planning">
            <div style="margin-bottom: 20px;">
                <a href="/Planning" style="text-decoration: none; color: #0369a1; font-weight: 600; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: #f1f5f9; border-radius: 6px; border: 1px solid #e2e8f0; transition: all 0.2s;">
                    <i class="fa-solid fa-arrow-left"></i> Planlama Listesine Dön
                </a>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <div>
                <span style="font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase;">PLANLAMA DETAYI</span>
                <div style="display: flex; align-items: baseline; gap: 8px; margin-top: 4px; user-select: none;">
                    <h2 style="margin: 0; color: #0f172a; padding-bottom: 2px;">@Model.OrderCode</h2>
                </div>
            </div>
            <div style="display: flex; gap: 8px;">
                <a href="/Planning/ExportToExcel" class="btn-planner" style="background: #16a34a; border-color: #16a34a; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 5px;"><i class="fa-solid fa-file-excel"></i> Excel</a>
            </div>
        </div>

        <!-- Sipariş Detayları Kartı (Daima Açık) -->
        <div id="orderDetailsCard" style="margin-bottom: 16px; background: white; border-radius: 10px; box-shadow: 0 2px 4px -1px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0; padding: 12px 16px;">
            <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 8px; margin-bottom: 10px;">
                <span style="font-weight: 700; color: #0f172a; font-size: 0.9rem;"><i class="fa-solid fa-box-open" style="color: #0ea5e9; margin-right: 6px;"></i>Sipariş Özellikleri</span>
            </div>
            
            <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px;">
                <div style="background: #f8fafc; padding: 8px 10px; border-radius: 6px;">
                    <div style="font-size: 0.65rem; color: #64748b; font-weight: 700; text-transform: uppercase; margin-bottom: 2px; letter-spacing: 0.5px;">MODEL</div>
                    <div style="font-weight: 600; color: #0f172a; font-size: 0.8rem;">@Model.ModelName</div>
                </div>
                <div style="background: #f8fafc; padding: 8px 10px; border-radius: 6px;">
                    <div style="font-size: 0.65rem; color: #64748b; font-weight: 700; text-transform: uppercase; margin-bottom: 2px; letter-spacing: 0.5px;">RENK</div>
                    <div style="font-weight: 600; color: #0f172a; font-size: 0.8rem;">@Model.Color</div>
                </div>
                <div style="background: #f8fafc; padding: 8px 10px; border-radius: 6px;">
                    <div style="font-size: 0.65rem; color: #64748b; font-weight: 700; text-transform: uppercase; margin-bottom: 2px; letter-spacing: 0.5px;">MÜŞTERİ</div>
                    <div style="font-weight: 600; color: #0f172a; font-size: 0.8rem;">@Model.Customer</div>
                </div>
                <div style="background: #fdf4ff; padding: 8px 10px; border-radius: 6px; border: 1px solid #fae8ff;">
                    <div style="font-size: 0.65rem; color: #a21caf; font-weight: 700; text-transform: uppercase; margin-bottom: 2px; letter-spacing: 0.5px;">ATÖLYE</div>
                    <div style="font-weight: 600; color: #701a75; font-size: 0.8rem;">
                        @{
                            var atolyeInfo = GetProdVal("prod_dikim_atolyesi");
                            if (string.IsNullOrEmpty(atolyeInfo)) { atolyeInfo = Model.SewingWorkshop ?? Model.ProductionPlace; }
                            <text>@(string.IsNullOrEmpty(atolyeInfo) ? "-" : atolyeInfo)</text>
                        }
                    </div>
                </div>
                <div style="background: #f8fafc; padding: 8px 10px; border-radius: 6px;">
                    <div style="font-size: 0.65rem; color: #64748b; font-weight: 700; text-transform: uppercase; margin-bottom: 2px; letter-spacing: 0.5px;">ADET</div>
                    <div style="font-weight: 600; color: #0f172a; font-size: 0.8rem;">@Model.CalculatedQuantity.ToString("N0")</div>
                </div>
                <div style="background: #f0f9ff; padding: 8px 10px; border-radius: 6px; border: 1px solid #e0f2fe;">
                    <div style="font-size: 0.65rem; color: #0284c7; font-weight: 700; text-transform: uppercase; margin-bottom: 2px; letter-spacing: 0.5px;">TERMİN TARİHİ</div>
                    <div style="font-weight: 600; color: #0c4a6e; font-size: 0.8rem;">@(Model.PlannedPackagingEndDate.HasValue ? Model.PlannedPackagingEndDate.Value.ToString("dd.MM.yyyy") : "-")</div>
                </div>
                <div style="background: #fdf2f8; padding: 8px 10px; border-radius: 6px; border: 1px solid #fce7f3;">
                    <div style="font-size: 0.65rem; color: #db2777; font-weight: 700; text-transform: uppercase; margin-bottom: 2px; letter-spacing: 0.5px;">REVİZE TERMİN</div>
                    <div style="font-weight: 600; color: #9d174d; font-size: 0.8rem;">
                        @{
                            var revizeTermin = Model.RevisedInspectionDate.HasValue 
                                ? Model.RevisedInspectionDate.Value.ToString("dd.MM.yyyy") 
                                : "";
                            
                            if (string.IsNullOrEmpty(revizeTermin))
                            {
                                var revizeTerminStr = GetProdVal("prod_knn_revize_termin");
                                if (!string.IsNullOrEmpty(revizeTerminStr))
                                {
                                    if (DateTime.TryParse(revizeTerminStr, out DateTime dtRevize))
                                    {
                                        revizeTermin = dtRevize.ToString("dd.MM.yyyy");
                                    }
                                    else if (DateTime.TryParseExact(revizeTerminStr, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime revizeTerminExact))
                                    {
                                        revizeTermin = revizeTerminExact.ToString("dd.MM.yyyy");
                                    }
                                    else
                                    {
                                        revizeTermin = revizeTerminStr;
                                    }
                                }
                            }
                            
                            <text>@(string.IsNullOrEmpty(revizeTermin) ? "-" : revizeTermin)</text>
                        }
                    </div>
                </div>
            </div>
        </div>

        @{
            var activeTab = TempData["ActiveTab"]?.ToString() ?? "numune";
        }

        <!-- Aşama Kartları -->
        <div class="plan-tabs">
            <div class="plan-tab @(activeTab == "numune" ? "active" : "")" onclick="switchTab('numune', this)">
                <i class="fa-solid fa-clipboard-check"></i>
                <div class="plan-tab-title">1. NUMUNE/TEST PLANLAMA</div>
                @if (Model.IsSampleTestCompleted) {
                    <div class="plan-tab-status status-complete">%100 TAMAM</div>
                } else {
                    <div class="plan-tab-status status-notstarted">BEKLİYOR</div>
                }
            </div>
            <div class="plan-tab @(activeTab == "satinalma" ? "active" : "")" onclick="switchTab('satinalma', this)">
                <i class="fa-solid fa-cart-shopping"></i>
                <div class="plan-tab-title">2. SATIN ALMA PLANLAMA</div>
                @if (Model.IsPurchasingCompleted) {
                    <div class="plan-tab-status status-complete">%100 TAMAM</div>
                } else {
                    <div class="plan-tab-status status-notstarted">BEKLİYOR</div>
                }
            </div>
            <div class="plan-tab @(activeTab == "uretim" ? "active" : "")" onclick="switchTab('uretim', this)">
                <i class="fa-solid fa-industry"></i>
                <div class="plan-tab-title">3. ÜRETİM PLANLAMA</div>
                @if (Model.IsProductionCompleted) {
                    <div class="plan-tab-status status-complete">%100 TAMAM</div>
                } else {
                    <div class="plan-tab-status status-notstarted">BEKLİYOR</div>
                }
            </div>
        </div>

        <!-- Sekme 1: Numune/Test -->
        <div id="tab-numune" class="tab-content @(activeTab == "numune" ? "active" : "")">
            <form id="sample-form" action="/Planning/UpdateSampleTestPlan" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <h3 style="font-size: 1.1rem; margin-bottom: 16px; color: #1e293b;">Numune ve Test Planlama Detayları</h3>
                
                @{
                    var sampleData = new System.Collections.Generic.Dictionary<string, string>();
                    if (!string.IsNullOrEmpty(Model.SampleTestJson))
                    {
                        try {
                            sampleData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.SampleTestJson);
                        } catch {}
                    }
                    string GetSampleVal(string key) => sampleData.ContainsKey(key) ? sampleData[key] : "";
                }

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                    <!-- Ana Kumaş Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-layer-group"></i> Ana Kumaş
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">NUMUNE KUMAŞ Y-TESTİ</div>
                                <input type="date" name="sample_kumas_ytesti" class="input-field" value="@GetSampleVal("sample_kumas_ytesti")" />
                            </div>
                            <div>
                                <div class="data-label">K-TUŞE RENK ONAYI test vr tarihi</div>
                                <input type="date" name="sample_tuse_renk" class="input-field" value="@GetSampleVal("sample_tuse_renk")" />
                            </div>
                            <div>
                                <div class="data-label">KUMAŞ KARIŞIMI</div>
                                <input type="text" name="sample_kumas_karisim" class="input-field" placeholder="Örn: %80 Pamuk %20 Polyester" value="@GetSampleVal("sample_kumas_karisim")" />
                            </div>
                        </div>
                    </div>

                    <!-- Düğme Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-circle-dot"></i> Düğme
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">DÜĞME RENK KALİTE ONAY</div>
                                <input type="date" name="sample_dugme_renk" class="input-field" value="@GetSampleVal("sample_dugme_renk")" />
                            </div>
                            <div>
                                <div class="data-label">DÜĞME TESTİ</div>
                                <input type="date" name="sample_dugme_test" class="input-field" value="@GetSampleVal("sample_dugme_test")" />
                            </div>
                        </div>
                    </div>

                    <!-- FIT / PPS Numunesi Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-shirt"></i> FIT / PPS Numunesi
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">PP ONAY (Üretim öncesi en kritik onay)</div>
                                <input type="date" name="sample_pp_onay" class="input-field" value="@GetSampleVal("sample_pp_onay")" />
                            </div>
                        </div>
                    </div>
                </div>
                
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px;">
                    <label style="display: flex; align-items: center; gap: 8px; font-weight: 600; color: #0f172a;">
                        <input type="checkbox" name="IsSampleTestCompleted" value="true" @(Model.IsSampleTestCompleted ? "checked" : "") /> 
                        <span style="color: #16a34a;"><i class="fa-solid fa-check-circle"></i> Numune Planlama Tamamlandı</span>
                    </label>
                    <button type="submit" class="btn-planner" style="background: var(--primary-color); color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-save"></i> Numune/Test Planını Kaydet</button>
                </div>
            </form>
        </div>

        <!-- Sekme 2: Satın Alma (MRP) -->
        <div id="tab-satinalma" class="tab-content @(activeTab == "satinalma" ? "active" : "")">
            <form id="purchasing-form" action="/Planning/UpdatePurchasingPlan" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <input type="hidden" name="pur_has_missing_materials" id="pur_has_missing_materials" value="false" />
                <h3 style="font-size: 1.1rem; margin-bottom: 16px; color: #1e293b;">Kumaş ve Aksesuar Planlaması (MRP) <span style="font-size: 0.85rem; color: #64748b; font-weight: normal;"></span></h3>
            
            @{
                var purData = new System.Collections.Generic.Dictionary<string, string>();
                if (!string.IsNullOrEmpty(Model.PurchasingMaterialsJson))
                {
                    try {
                        purData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.PurchasingMaterialsJson);
                    } catch {}
                }
                string GetPurVal(string key, string def = "") => purData.ContainsKey(key) ? purData[key] : def;

                string ExtractFromOzellikler(string json, string keyContains) {
                    if (string.IsNullOrEmpty(json)) return null;
                    try {
                        using var doc = System.Text.Json.JsonDocument.Parse(json);
                        if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Array) {
                            foreach(var prop in doc.RootElement.EnumerateArray()) {
                                if (prop.TryGetProperty("Key", out var k) && prop.TryGetProperty("Value", out var v)) {
                                    var keyStr = k.GetString();
                                    if (keyStr != null && keyStr.Contains(keyContains, StringComparison.OrdinalIgnoreCase)) {
                                        return v.GetString();
                                    }
                                }
                            }
                        } else if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object) {
                            foreach(var prop in doc.RootElement.EnumerateObject()) {
                                if (prop.Name.Contains(keyContains, StringComparison.OrdinalIgnoreCase)) {
                                    return prop.Value.GetString();
                                }
                            }
                        }
                    } catch {}
                    return null;
                }
                
                // Renkleri bul (pur_color_RENKADI_... patterninden)
                var colors = purData.Keys
                    .Where(k => k.StartsWith("pur_color_"))
                    .Select(k => k.Split('_')[2])
                    .Distinct()
                    .ToList();
                    
                if (!colors.Any()) {
                    if (!string.IsNullOrEmpty(Model.Color)) {
                        colors.Add(Model.Color);
                    } else {
                        colors.Add("GENEL");
                    }
                }
                
                var stokKartlari = (List<UretimPlanlama.Models.StokKarti>)ViewBag.StokKartlari ?? new List<UretimPlanlama.Models.StokKarti>();
                var kumasMaterials = new List<dynamic>();
                var basicMaterials = new List<dynamic>();
                var labelMaterials = new List<dynamic>();
                var interlinings = new List<dynamic>();
                
                if (Model.OrderMaterials != null && Model.OrderMaterials.Any()) {
                    foreach (var mat in Model.OrderMaterials) {
                        var stok = stokKartlari.FirstOrDefault(x => x.Id == mat.StokKartiId);
                        if (stok != null) {
                            var miktar = mat.Miktar.ToString(System.Globalization.CultureInfo.InvariantCulture);
                            var key = "stk_" + stok.Id.ToString() + "_" + mat.Id.ToString();
                            var m = new { Name = stok.StokAdi, DefaultUnit = miktar, Key = key, Stok = stok, OrderOzelliklerJson = mat.OzelliklerJson, Aciklama = mat.Aciklama };
                            
                            var cat = (stok.Kategori ?? "").Trim().ToUpperInvariant();
                            if (cat == "KUMAŞ" || cat == "KUMAS") kumasMaterials.Add(m);
                            else if (cat == "ETİKET" || cat == "ETIKET") labelMaterials.Add(m);
                            else if (cat == "TELA") interlinings.Add(m);
                            else basicMaterials.Add(m); // "Malzeme" ve diğer her şey
                        }
                    }
                }
                
                string firstFabricMeterageStr = "1";
                if (kumasMaterials.Any()) {
                    var kMat = kumasMaterials.First();
                    string dynKumasMetraj = ExtractFromOzellikler(kMat.OrderOzelliklerJson, "METRAJ");
                    firstFabricMeterageStr = !string.IsNullOrEmpty(dynKumasMetraj) ? dynKumasMetraj : kMat.DefaultUnit;
                }

                var openSizes = new Dictionary<string, int>();
                if (!string.IsNullOrEmpty(Model.SizeDistributionJson)) {
                    try { openSizes = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, int>>(Model.SizeDistributionJson) ?? new Dictionary<string, int>(); } catch {}
                }
                var asortiSizes = new Dictionary<string, int>();
                if (!string.IsNullOrEmpty(Model.AsortiDistributionJson)) {
                    try { asortiSizes = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, int>>(Model.AsortiDistributionJson) ?? new Dictionary<string, int>(); } catch {}
                }
                int asortiCount = Model.AsortiCount;

                var finalSizes = new Dictionary<string, int>();
                foreach(var kvp in openSizes) {
                    if(!finalSizes.ContainsKey(kvp.Key)) finalSizes[kvp.Key] = 0;
                    finalSizes[kvp.Key] += kvp.Value;
                }
                foreach(var kvp in asortiSizes) {
                    if(!finalSizes.ContainsKey(kvp.Key)) finalSizes[kvp.Key] = 0;
                    finalSizes[kvp.Key] += (kvp.Value * asortiCount);
                }
            }

            <input type="hidden" name="ActualFabricMeterage" value="@Model.ActualFabricMeterage" />
            <input type="hidden" name="ActualFabricQty" value="@Model.ActualFabricQty" />
            <input type="hidden" name="AccessoryCompletionDate" value="@(Model.AccessoryCompletionDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="PurchasingMaterialsJson" id="PurchasingMaterialsJson" value="@Model.PurchasingMaterialsJson" />

            <style>
                .color-tabs { display: flex; gap: 8px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 5px; }
                .color-tab { padding: 10px 20px; background: #f1f5f9; border: 1px solid var(--border-color); border-radius: 8px; cursor: pointer; font-weight: 600; color: #475569; transition: all 0.2s; white-space: nowrap; }
                .color-tab:hover { background: #e2e8f0; }
                .color-tab.active { background: #0ea5e9; color: white; border-color: #0284c7; box-shadow: 0 4px 6px -1px rgba(14, 165, 233, 0.2); }
                .color-tab-add { padding: 10px 16px; background: white; border: 1px dashed #94a3b8; border-radius: 8px; cursor: pointer; font-weight: 600; color: #64748b; transition: all 0.2s; }
                .color-tab-add:hover { background: #f8fafc; border-color: #64748b; color: #0f172a; }
                .color-pane { display: none; }
                .color-pane.active { display: block; }
            </style>

            @if (colors.Count > 1 || (colors.Count == 1 && colors[0] != "GENEL")) {
            <div class="color-tabs" id="colorTabsContainer">
                @foreach(var c in colors) {
                    <div class="color-tab @(c == colors.First() ? "active" : "")" data-color="@c">@c</div>
                }
            </div>
            }

            <div id="colorPanesContainer">
                @foreach(var c in colors) {
                    <div class="color-pane @(c == colors.First() ? "active" : "")" id="pane-@c">
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                            <!-- Kumaş Tedarik Bilgileri Kartı -->
                            <div class="content-section" style="margin-bottom: 0;">
                                <div class="section-title">
                                    <i class="fa-solid fa-truck-fast"></i> @(c != "GENEL" ? c + " " : "")Kumaş Tedarik Bilgileri
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                    <div style="grid-column: span 2;">
                                        <div class="data-label">KUMAŞÇI</div>
                                        <select name="pur_color_@(c)_kumasci" class="input-field" style="width: 100%;">
                                            <option value="">-- Seçiniz --</option>
                                            @if(ViewBag.Fabricators != null) {
                                                var defaultFab = GetPurVal($"pur_color_{c}_kumasci");
                                                if (string.IsNullOrEmpty(defaultFab) && (c == Model.Color || c == "GENEL")) {
                                                    defaultFab = Model.FabricSupplier;
                                                }
                                                foreach(var f in (IEnumerable<UretimPlanlama.Models.Fabricator>)ViewBag.Fabricators) {
                                                    if(defaultFab == f.Name) {
                                                        <option value="@f.Name" selected>@f.Name</option>
                                                    } else {
                                                        <option value="@f.Name">@f.Name</option>
                                                    }
                                                }
                                            } else {
                                                var val = GetPurVal($"pur_color_{c}_kumasci");
                                                if (string.IsNullOrEmpty(val) && (c == Model.Color || c == "GENEL")) {
                                                    val = Model.FabricSupplier;
                                                }
                                                if(!string.IsNullOrEmpty(val)) {
                                                    <option value="@val" selected>@val</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div style="grid-column: span 2;"><div class="data-label">KUMAŞ SEVK (ANLAŞILAN)</div><input type="date" name="pur_color_@(c)_kumas_sevk" class="input-field" value="@GetPurVal($"pur_color_{c}_kumas_sevk")" /></div>
                                </div>
                            </div>

                            <!-- Aksesuar Tarihleri Kartı -->
                            <div class="content-section" style="margin-bottom: 0;">
                                <div class="section-title">
                                    <i class="fa-solid fa-calendar-days"></i> @(c != "GENEL" ? c + " " : "")Aksesuar Geliş Tarihleri
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                    <div><div class="data-label">DÜĞME-GELİŞİ</div><input type="date" name="pur_color_@(c)_dugme_gelisi" class="input-field" value="@GetPurVal($"pur_color_{c}_dugme_gelisi")" /></div>
                                    <div><div class="data-label">DÜĞME DİKİŞ İPİ</div><input type="date" name="pur_color_@(c)_dugme_dikis_ipi" class="input-field" value="@GetPurVal($"pur_color_{c}_dugme_dikis_ipi")" /></div>
                                    <div><div class="data-label">ETİKET-GELİŞİ</div><input type="date" name="pur_color_@(c)_etiket_gelisi" class="input-field" value="@GetPurVal($"pur_color_{c}_etiket_gelisi")" /></div>
                                    <div><div class="data-label">FİYAT KART-GELİŞİ</div><input type="date" name="pur_color_@(c)_fiyat_kart_gelisi" class="input-field" value="@GetPurVal($"pur_color_{c}_fiyat_kart_gelisi")" /></div>
                                    <div><div class="data-label">YIKAMA-İÇ GELİŞ</div><input type="date" name="pur_color_@(c)_yikama_ic_gelis" class="input-field" value="@GetPurVal($"pur_color_{c}_yikama_ic_gelis")" /></div>
                                </div>
                            </div>

                            <!-- Ana Kumaş Kartı -->
                            <div class="content-section" style="margin-bottom: 0; background: #fafafa; border: 1px solid #e2e8f0; grid-column: span 2;">
                                <div class="section-title">
                                    <i class="fa-solid fa-layer-group"></i> @(c != "GENEL" ? c + " " : "")Kumaş Metraj Hesabı
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr; gap: 16px;">
                                    <div style="margin-top: 10px; overflow-x: auto;">
                                        <table class="table-details" style="margin-top:0; min-width: 600px;">
                                            <thead>
                                                <tr>
                                                    <th>CİNSİ</th>
                                                    <th style="text-align: center;">SİPARİŞ / ÇIKACAK ADET</th>
                                                    <th style="text-align: center;">BİRİM METRAJ (M)</th>
                                                    <th style="text-align: center;">TOPLAM KUMAŞ METRAJI</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr style="background-color: #fef08a;">
                                                    <td style="font-weight: bold;">İHTİYAÇ OLAN KUMAŞ</td>
                                                    <td><input type="text" name="pur_color_@(c)_siparis_adeti" class="input-field mrp-input mrp-siparis-adeti mrp-calc-source-adet" value="@GetPurVal($"pur_color_{c}_siparis_adeti", Model.Quantity.ToString())" style="width: 100%; padding: 6px; font-weight: bold; color: #b45309; text-align: center; background-color: #fdf6e3; cursor: not-allowed;" readonly tabindex="-1" /></td>
                                                    <td><input type="text" name="pur_color_@(c)_istenen_metraj" class="input-field mrp-input mrp-istenen-metraj mrp-calc-source-metraj" value="@firstFabricMeterageStr" style="width: 100%; padding: 6px; text-align: center; background-color: #fdf6e3; cursor: not-allowed;" readonly tabindex="-1" /></td>
                                                    <td><input type="text" name="pur_color_@(c)_istenen_kumas_miktar" class="input-field mrp-input mrp-istenen-kumas-miktar mrp-calc-source-kumas" value="@GetPurVal($"pur_color_{c}_istenen_kumas_miktar", "0")" style="width: 100%; padding: 6px; font-weight: bold; color: #b45309; text-align: center; background-color: #fdf6e3; cursor: not-allowed;" readonly tabindex="-1" /></td>
                                                </tr>
                                                <tr style="background-color: #e0e7ff;">
                                                    <td style="font-weight: bold;">İSTENEN KUMAŞ</td>
                                                    <td><input type="text" name="pur_color_@(c)_beden_cikacak" class="input-field mrp-input mrp-beden-cikacak mrp-calc-source-adet" value="@GetPurVal($"pur_color_{c}_beden_cikacak", "0")" style="width: 100%; padding: 6px; font-weight: bold; color: #1e40af; text-align: center;" /></td>
                                                    <td><input type="text" name="pur_color_@(c)_beden_metraj" class="input-field mrp-input mrp-beden-metraj mrp-calc-source-metraj" value="@GetPurVal($"pur_color_{c}_beden_metraj", firstFabricMeterageStr)" style="width: 100%; padding: 6px; text-align: center;"/></td>
                                                    <td><input type="text" name="pur_color_@(c)_beden_miktar" class="input-field mrp-input mrp-beden-miktar mrp-calc-source-kumas" value="@GetPurVal($"pur_color_{c}_beden_miktar", "0")" style="width: 100%; padding: 6px; font-weight: bold; color: #1e40af; text-align: center;"/></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- Malzeme İhtiyaç Tablosu -->
                        <div class="content-section" style="padding: 0; overflow-x: auto;">
                            <div class="section-title" style="padding: 16px 16px 0 16px;">
                                <i class="fa-solid fa-table-list"></i> @(c != "GENEL" ? c + " " : "")Malzeme İhtiyaç Tablosu
                            </div>
                            <table class="table-details mrp-table">
                                <thead>
                                    <tr>
                                        <th>CİNSİ</th>
                                        <th style="width: 100px;">SİPARİŞ ADETİ</th>
                                        <th style="width: 80px;">BİRİM</th>
                                        <th style="width: 100px;">TOPLAM</th>
                                        <th style="width: 80px;">FİRE (%)</th>
                                        <th style="width: 90px; background:#e2e8f0;">FİRE ADETİ</th>
                                        <th style="width: 100px; background:#fef08a;">İSTENEN</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!basicMaterials.Any()) {
                                        <tr><td colspan="7" style="text-align: center; color: #64748b; padding: 20px;">Model detayında seçilmiş malzeme yok.</td></tr>
                                    } else {
                                        foreach (var item in basicMaterials) {
                                            string dynFire = ExtractFromOzellikler(item.OrderOzelliklerJson, "FİRE") ?? ExtractFromOzellikler(item.OrderOzelliklerJson, "FIRE");
                                            string defaultFire = !string.IsNullOrEmpty(dynFire) ? dynFire : (Model.WastageRate.HasValue ? Model.WastageRate.Value.ToString("0.##") : "0");
                                            string dynBirim = ExtractFromOzellikler(item.OrderOzelliklerJson, "BİRİM") ?? ExtractFromOzellikler(item.OrderOzelliklerJson, "BIRIM");
                                            string unitVal = GetPurVal($"pur_color_{c}_birim_{item.Key}", !string.IsNullOrEmpty(dynBirim) ? dynBirim : item.DefaultUnit);
                                            string fireVal = GetPurVal($"pur_color_{c}_fire_{item.Key}", defaultFire);
                                            string dynBoyut = ExtractFromOzellikler(item.OrderOzelliklerJson, "BOYUT") ?? ExtractFromOzellikler(item.OrderOzelliklerJson, "EBAT") ?? ExtractFromOzellikler(item.OrderOzelliklerJson, "BÜYÜKLÜK") ?? ExtractFromOzellikler(item.OrderOzelliklerJson, "BOY");
                                            string extraInfo = !string.IsNullOrEmpty(dynBoyut) ? dynBoyut : item.Aciklama;
                                            string displayName = !string.IsNullOrEmpty(extraInfo) ? $"{item.Name} ({extraInfo})" : item.Name;

                                            <tr class="mrp-row">
                                                <td style="font-weight: 600;">@displayName</td>
                                                <td class="row-is-adeti" style="text-align: right; color: #64748b; font-weight: 600;">0</td>
                                                <td><input type="text" name="pur_color_@(c)_birim_@item.Key" class="input-field mrp-input row-birim" value="@unitVal" style="width: 100%; padding: 4px;" /></td>
                                                <td class="row-toplam" style="text-align: right; font-weight: 600; color: #0f172a;">0</td>
                                                <td><input type="text" name="pur_color_@(c)_fire_@item.Key" class="input-field mrp-input row-fire" value="@fireVal" style="width: 100%; padding: 4px;" /></td>
                                                <td class="row-fazla" style="text-align: right; background:#e2e8f0; color: #0f172a; font-weight: 600;">0</td>
                                                <td class="row-istenen" style="text-align: right; font-weight: 700; color: #b45309; background:#fef08a;">0</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Bedenli Etiketler İhtiyaç Tablosu -->
                        <div class="content-section" style="padding: 0; overflow-x: auto; margin-top: 16px;">
                            <div class="section-title" style="padding: 16px 16px 0 16px;">
                                <i class="fa-solid fa-tags"></i> @(c != "GENEL" ? c + " " : "")Bedenli Etiketler İhtiyaç Tablosu
                            </div>
                            <table class="table-details mrp-label-table">
                                <thead>
                                    <tr>
                                        <th>CİNSİ</th>
                                        @foreach(var size in finalSizes.Keys) {
                                            <th style="width: 70px; text-align: center; background:#e0f2fe; color:#0284c7;">@size</th>
                                        }
                                        <th style="width: 80px; text-align: center;">FİRE (%)</th>
                                        <th style="width: 120px; background:#fef08a; text-align: center;">İHTİYAÇ (TOPLAM)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (labelMaterials.Any()) {
                                        <tr style="background:#f1f5f9;" class="label-param-row">
                                            <td style="font-weight:bold;">ASORTİ ORANLARI</td>
                                            @foreach(var sizeKvp in finalSizes) {
                                                int asortiO = asortiSizes.ContainsKey(sizeKvp.Key) ? asortiSizes[sizeKvp.Key] : 0;
                                                string val = GetPurVal($"pur_color_{c}_label_asorti_oran_{sizeKvp.Key}", asortiO.ToString());
                                                <td><input type="text" name="pur_color_@(c)_label_asorti_oran_@sizeKvp.Key" class="input-field mrp-input label-asorti-oran" data-size="@sizeKvp.Key" value="@val" style="width:100%; padding:4px; text-align:center;" /></td>
                                            }
                                            <td></td>
                                            <td class="label-asorti-oran-toplam" style="text-align:right; font-weight:bold;">0</td>
                                        </tr>
                                        <tr style="background:#f1f5f9;" class="label-param-row">
                                            <td style="font-weight:bold;">AÇIK ADET</td>
                                            @foreach(var sizeKvp in finalSizes) {
                                                int openQ = openSizes.ContainsKey(sizeKvp.Key) ? openSizes[sizeKvp.Key] : 0;
                                                string val = GetPurVal($"pur_color_{c}_label_acik_adet_{sizeKvp.Key}", openQ.ToString());
                                                <td><input type="text" name="pur_color_@(c)_label_acik_adet_@sizeKvp.Key" class="input-field mrp-input label-acik-adet" data-size="@sizeKvp.Key" value="@val" style="width:100%; padding:4px; text-align:center;" /></td>
                                            }
                                            <td></td>
                                            <td class="label-acik-adet-toplam" style="text-align:right; font-weight:bold;">0</td>
                                        </tr>

                                        <tr style="background:#f0fdf4;" class="label-param-row">
                                            <td style="font-weight:bold; color:#16a34a;">ASORTİ SAYISI</td>
                                            <td colspan="@(finalSizes.Count + 2)" class="label-kalan-adet-val" style="text-align:right; font-weight:bold; color:#16a34a; padding-right:12px;">0</td>
                                        </tr>
                                        <tr style="background:#f0fdf4;" class="label-param-row">
                                            <td style="font-weight:bold; color:#16a34a;">YENİ LOT SAYISI</td>
                                            <td colspan="@(finalSizes.Count + 2)" class="label-yeni-lot-val" style="text-align:right; font-weight:bold; color:#16a34a; padding-right:12px;">0</td>
                                        </tr>
                                        <tr style="background:#e2e8f0;" class="label-param-row">
                                            <td style="font-weight:bold; text-align:right;">TOPLAM:</td>
                                            @foreach(var sizeKvp in finalSizes) {
                                                <td class="label-toplam-beden" data-size="@sizeKvp.Key" style="text-align:center; font-weight:bold; color:#1e40af;">0</td>
                                            }
                                            <td></td>
                                            <td class="label-genel-toplam" style="text-align:right; font-weight:bold; color:#b45309;">0</td>
                                        </tr>
                                        foreach (var item in labelMaterials) {
                                            string dynFire = ExtractFromOzellikler(item.OrderOzelliklerJson, "FİRE") ?? ExtractFromOzellikler(item.OrderOzelliklerJson, "FIRE");
                                            string fireVal = GetPurVal($"pur_color_{c}_label_fire_{item.Key}", !string.IsNullOrEmpty(dynFire) ? dynFire : "0");
                                            <tr class="mrp-label-row">
                                                <td style="font-weight: 600;">@item.Name</td>
                                                @foreach(var sizeKvp in finalSizes) {
                                                    <td class="row-label-size-qty" data-size="@sizeKvp.Key" style="text-align: center; color: #475569; font-weight: 700; background:#f8fafc;">0</td>
                                                }
                                                <td><input type="text" name="pur_color_@(c)_label_fire_@item.Key" class="input-field mrp-input row-label-fire" value="@fireVal" style="width: 100%; padding: 4px; text-align: center;" /></td>
                                                <td class="row-label-toplam" style="text-align: right; font-weight: 700; color: #b45309; background:#fef08a;">0</td>
                                            </tr>
                                        }
                                    } else {
                                        <tr><td colspan="@(3 + finalSizes.Count)" style="text-align: center; color: #64748b; padding: 20px;">Model detayında seçilmiş etiket yok.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Astar Tela İhtiyaç Tablosu -->
                        <div class="content-section" style="padding: 0; overflow-x: auto; margin-top: 16px;">
                            <div class="section-title" style="padding: 16px 16px 0 16px;">
                                <i class="fa-solid fa-layer-group"></i> @(c != "GENEL" ? c + " " : "")Astar Tela İhtiyacı
                            </div>
                            <table class="table-details interlining-table">
                                <thead>
                                    <tr>
                                        <th>CİNSİ</th>
                                        <th style="width: 100px;">İŞ MİKTARI</th>
                                        <th style="width: 100px;">BİRİM</th>
                                        <th style="width: 150px;">GRAM</th>
                                        <th style="width: 150px; text-align: center;">TELA İHTİYACI (RENK)</th>
                                        <th style="width: 100px; background:#fef08a;">İHTİYAÇ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!interlinings.Any()) {
                                        <tr><td colspan="6" style="text-align: center; color: #64748b; padding: 20px;">Model detayında seçilmiş tela yok.</td></tr>
                                    } else {
                                        foreach (var item in interlinings) {
                                            string dynBirim = ExtractFromOzellikler(item.OrderOzelliklerJson, "BİRİM") ?? ExtractFromOzellikler(item.OrderOzelliklerJson, "BIRIM");
                                            string dynGram = ExtractFromOzellikler(item.OrderOzelliklerJson, "GRAM");
                                            string dynRenk = ExtractFromOzellikler(item.OrderOzelliklerJson, "RENK");

                                            string unitVal = GetPurVal($"pur_color_{c}_tela_birim_{item.Key}", !string.IsNullOrEmpty(dynBirim) ? dynBirim : item.DefaultUnit);
                                            string tipiVal = GetPurVal($"pur_color_{c}_tela_tipi_{item.Key}", !string.IsNullOrEmpty(dynGram) ? dynGram : "");
                                            string renkVal = GetPurVal($"pur_color_{c}_tela_renk_{item.Key}", !string.IsNullOrEmpty(dynRenk) ? dynRenk : "");
                                            <tr class="interlining-row">
                                                <td style="font-weight: 600;">@item.Name</td>
                                                <td class="row-is-miktari" style="text-align: right; color: #64748b; font-weight: 600;">0</td>
                                                <td><input type="text" name="pur_color_@(c)_tela_birim_@item.Key" class="input-field interlining-input row-tela-birim" value="@unitVal" style="width: 100%; padding: 4px; text-align: center;" /></td>
                                                <td><input type="text" name="pur_color_@(c)_tela_tipi_@item.Key" class="input-field" value="@tipiVal" placeholder="Örn: 1.75'lik" style="width: 100%; padding: 4px;" /></td>
                                                <td><input type="text" name="pur_color_@(c)_tela_renk_@item.Key" class="input-field" value="@renkVal" placeholder="Renk" style="width: 100%; padding: 4px;" /></td>
                                                <td class="row-ihtiyac" style="text-align: right; font-weight: 700; color: #b45309; background:#fef08a;">0</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
            <div style="display: flex; justify-content: space-between; margin-top: 20px; align-items: center;">
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 600; color: #0f172a;">
                    <input type="checkbox" name="IsPurchasingCompleted" value="true" @(Model.IsPurchasingCompleted ? "checked" : "") /> 
                    <span style="color: #16a34a;"><i class="fa-solid fa-check-circle"></i> Satın Alma Planlama Tamamlandı</span>
                </label>
                <button type="submit" class="btn-planner" style="background: #1d4ed8; color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-save"></i> Satın Alma Planını Kaydet</button>
            </div>
            </form>
        </div>

        <!-- Sekme 3: Üretim -->
        <div id="tab-uretim" class="tab-content @(activeTab == "uretim" ? "active" : "")">
            <form id="production-form" action="/Planning/UpdateProductionPlan" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <h3 style="font-size: 1.1rem; margin-bottom: 16px; color: #1e293b;">Üretim Planlama Detayları</h3>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
                    <!-- Kesim ve Dikim Kartı -->
                    <div class="content-section">
                        <div class="section-title">
                            <i class="fa-solid fa-scissors"></i> Kesim ve Dikim
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <div class="data-label">DİKİM ATÖLYESİ</div>
                                <select name="prod_dikim_atolyesi" class="input-field">
                                    <option value="">-- Atölye Seçin --</option>
                                    @if (ViewBag.Workshops != null)
                                    {
                                        var prodDikim = GetProdVal("prod_dikim_atolyesi");
                                        if (string.IsNullOrEmpty(prodDikim)) { prodDikim = Model.SewingWorkshop ?? Model.ProductionPlace; }
                                        foreach (var w in (System.Collections.Generic.List<UretimPlanlama.Models.Workshop>)ViewBag.Workshops)
                                        {
                                            if (!string.IsNullOrEmpty(prodDikim) && prodDikim.Equals(w.Name, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <option value="@w.Name" selected>@w.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@w.Name">@w.Name</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                            <div>
                                <div class="data-label">ÜRETİLECEK MİKTAR</div>
                                <input type="text" class="input-field" value="@Model.CalculatedQuantity.ToString("N0")" disabled style="background:#f1f5f9; font-weight:600; color:#475569;" />
                            </div>
                            <div>
                                <div class="data-label" style="display:flex; justify-content:space-between; align-items:center;">
                                    <span>DİKİLECEK MİKTAR</span>
                                    <label style="display:flex; align-items:center; gap:4px; font-size:0.75rem; color:#0f172a; cursor:pointer; text-transform:none; margin:0;">
                                        <input type="checkbox" onchange="if(this.checked) { document.getElementById('prodDikimMiktari').value = '@Model.CalculatedQuantity'; } else { document.getElementById('prodDikimMiktari').value = ''; }" /> Tamamı
                                    </label>
                                </div>
                                <input type="number" id="prodDikimMiktari" name="prod_dikim_miktari" class="input-field" value="@GetProdVal("prod_dikim_miktari")" placeholder="Örn: @Model.CalculatedQuantity" />
                            </div>
                            <div>
                                <div class="data-label">KESİM BAŞLANGIÇ</div>
                                <input type="date" name="prod_kesim_baslangic" class="input-field" value="@GetProdVal("prod_kesim_baslangic")" />
                            </div>
                            <div>
                                <div class="data-label">KESİM BİTİŞ</div>
                                <input type="date" name="prod_kesim_bitis" class="input-field" value="@GetProdVal("prod_kesim_bitis")" />
                            </div>
                            <div>
                                <div class="data-label">DİKİM BAŞLANGIÇ</div>
                                <input type="date" name="prod_dikim_baslangic" class="input-field" value="@GetProdVal("prod_dikim_baslangic")" />
                            </div>
                            <div>
                                <div class="data-label">DİKİM BİTİŞ</div>
                                <input type="date" name="prod_dikim_bitis" class="input-field" value="@GetProdVal("prod_dikim_bitis")" />
                            </div>
                        </div>
                    </div>

                    <!-- Paket ve Lojistik Kartı -->
                    <div class="content-section">
                        <div class="section-title">
