                                        <script>
                                            // Dinamik hesaplama için event listener
                                            document.addEventListener("DOMContentLoaded", function() {
                                                const observer = new MutationObserver(function() {
                                                    document.querySelectorAll('.color-pane').forEach(function(pane) {
                                                        var bedenMetrajEl = pane.querySelector('.mrp-beden-metraj');
                                                        var gelenMiktarEl = pane.querySelector('.mrp-gelen-miktar');
                                                        var gelenMetrajEl = pane.querySelector('.mrp-gelen-metraj');
                                                        var gelenCikacakEl = pane.querySelector('.mrp-gelen-cikacak');
                                                        
                                                        if (gelenMiktarEl && gelenCikacakEl && bedenMetrajEl && gelenMetrajEl) {
                                                            var gelenMetraj = typeof parseTurkishFloat === 'function' ? parseTurkishFloat(gelenMetrajEl.value || "1") : parseFloat((gelenMetrajEl.value || "1").replace(',', '.'));
                                                            var gelenMiktar = typeof parseTurkishFloat === 'function' ? parseTurkishFloat(gelenMiktarEl.value || "0") : parseFloat((gelenMiktarEl.value || "0").replace(',', '.'));
                                                            if (gelenMetraj > 0) {
                                                                gelenCikacakEl.value = Math.round(gelenMiktar / gelenMetraj).toLocaleString('tr-TR');
                                                            } else {
                                                                gelenCikacakEl.value = "0";
                                                            }
                                                            if (typeof updateGlobalTargetsUI === 'function') updateGlobalTargetsUI();
                                                        }
                                                    });
                                                });
                                                
                                                // Observe document body for input changes (since there are many inputs and calculateMRP is called often)
                                                document.body.addEventListener('input', function(e) {
                                                    if(e.target.classList.contains('mrp-beden-metraj') || e.target.classList.contains('mrp-gelen-metraj') || e.target.classList.contains('mrp-gelen-miktar')) {
                                                        observer.disconnect(); // Trigger calculation
                                                        // Just manual call
                                                        document.querySelectorAll('.color-pane').forEach(function(pane) {
                                                            var bedenMetrajEl = pane.querySelector('.mrp-beden-metraj');
                                                            var gelenMiktarEl = pane.querySelector('.mrp-gelen-miktar');
                                                            var gelenMetrajEl = pane.querySelector('.mrp-gelen-metraj');
                                                            var gelenCikacakEl = pane.querySelector('.mrp-gelen-cikacak');
                                                            if (gelenMiktarEl && gelenCikacakEl && bedenMetrajEl && gelenMetrajEl) {
                                                                var gelenMetraj = typeof parseTurkishFloat === 'function' ? parseTurkishFloat(gelenMetrajEl.value || "1") : parseFloat((gelenMetrajEl.value || "1").replace(',', '.'));
