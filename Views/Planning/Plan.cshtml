                            <td style="vertical-align: middle;"><input type="date" id="planTxtAsortiDate" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" style="width: 100%; font-weight: bold; padding: 6px 4px; border-radius: 6px;" /></td>
                            <td class="sticky-islem" style="vertical-align: middle; text-align: center; position: sticky; right: 0; background: #f0fdf4; z-index: 2; box-shadow: -2px 0 5px -2px rgba(0,0,0,0.1);">
