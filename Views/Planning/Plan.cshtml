const orderId = @Model.Id;

let planCuttingItems = @Html.Raw(string.IsNullOrEmpty(Model.PlannedCuttingJson) ? "[]" : Model.PlannedCuttingJson);
let planTargetSizes = @Html.Raw(string.IsNullOrEmpty(Model.SizeDistributionJson) ? "{}" : Model.SizeDistributionJson);
let planTargetSizesAsorti = @Html.Raw(string.IsNullOrEmpty(Model.AsortiDistributionJson) ? "{}" : Model.AsortiDistributionJson);
const planAsortiCount = @Model.AsortiCount;

function planGetTotalCutForSize(sizeName, cutType) {
    let total = 0;
    planCuttingItems.forEach(item => {
        if (item.CutType === cutType && item.Sizes && item.Sizes[sizeName]) {
            total += parseFloat(item.Sizes[sizeName]) || 0;
        }
    });
    return total;
}
// --- TAB 3: KESİM SÜRECİ ---
        function planToggleCutForm(type) {
            if (type === 'AcikAdet') {
                $('#planCuttingEntryAcik').show();
                planCalculateAcik();
                setTimeout(function() { $('#planTxtAcikMultiplier').focus(); }, 100);
            } else {
                $('#planCuttingEntryAsorti').show();
                planCalculateAsorti();
                setTimeout(function() { $('#planTxtAsortiMultiplier').focus(); }, 100);
            }
        }
        
        function planCalculateAcik() {
            const multiplier = parseFloat($('#planTxtAcikMultiplier').val()) || 1;
            const markerLength = parseFloat($('#planTxtAcikMarkerLength').val()) || 0;
            
            let totalQty = 0;
            $('.acik-adet-input-row').each(function() {
                const val = parseFloat($(this).val()) || 0;
                totalQty += (val * multiplier);
            });
            
            $('#planTxtAcikTotal').val(totalQty);
            if (totalQty > 0) {
                $('#planTxtAcikUnitMeterage').val(((markerLength * multiplier) / totalQty).toFixed(2));
            } else {
                $('#planTxtAcikUnitMeterage').val('0');
            }
        }

        function planCalculateAsorti() {
            const multiplier = parseFloat($('#planTxtAsortiMultiplier').val()) || 1;
            const markerLength = parseFloat($('#planTxtAsortiMarkerLength').val()) || 0;
            
            let totalQty = 0;
            $('.asorti-adet-input-row').each(function() {
                const asortiValue = parseFloat($(this).data('ratio')) || 0;
                const calculatedValue = asortiValue * multiplier;
                $(this).val(calculatedValue); 
                totalQty += calculatedValue;
            });
            
            $('#planTxtAsortiTotal').val(totalQty);
            if (totalQty > 0) {
                $('#planTxtAsortiUnitMeterage').val(((markerLength * multiplier) / totalQty).toFixed(2));
            } else {
                $('#planTxtAsortiUnitMeterage').val('0');
            }
        }
        
        function planSaveAcikRow() {
            const date = $('#planTxtAcikDate').val();
            const multiplier = parseFloat($('#planTxtAcikMultiplier').val()) || 1;
            const markerLength = parseFloat($('#planTxtAcikMarkerLength').val()) || 0;
            const totalQty = parseFloat($('#planTxtAcikTotal').val()) || 0;
            const unitMeterage = parseFloat($('#planTxtAcikUnitMeterage').val()) || 0;

            if (totalQty <= 0) {
                showBeautifulAlert("Lütfen geçerli bir kesim değeri giriniz (toplam adet > 0 olmalı).", "warning");
                return;
            }

            const sizes = {};
            let validationError = "";
            $('.acik-adet-input-row').each(function() {
                const sizeName = $(this).data('size');
                const val = parseFloat($(this).val()) || 0;
                const calculatedValue = val * multiplier;
                if(calculatedValue > 0) {
                    const targetQty = parseFloat(planTargetSizes[sizeName]) || 0;
                    const alreadyCut = planGetTotalCutForSize(sizeName, 'Açık Adet');
                    if ((alreadyCut + calculatedValue) > targetQty) {
                        validationError = `Hata: '${sizeName}' bedeni için sipariş hedefini aşıyorsunuz! (Hedef: ${targetQty}, Toplam Kesilecek: ${alreadyCut + calculatedValue})`;
                    }
                    sizes[sizeName] = calculatedValue;
                }
            });
            
            if (validationError) {
                Swal.fire({
                    title: 'Hata',
                    text: validationError + "\n\nKesim planlamasında hedeflenen adetten fazlasını giremezsiniz. Fazla kesim kaydını sadece üretim (kesim) sürecinde ekleyebilirsiniz.",
                    icon: 'error',
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Tamam'
                });
                return;
            }
            
            _planAddCutToGlobalAndRender('Açık Adet', date, multiplier, sizes, totalQty, markerLength, unitMeterage);
            
            // Reset
            $('.acik-adet-input-row').val('');
            $('#planTxtAcikMultiplier').val('1');
            $('#planCuttingEntryAcik').hide();
            planCalculateAcik();
        }

        function planSaveAsortiRow() {
            const date = $('#planTxtAsortiDate').val();
            const multiplier = parseFloat($('#planTxtAsortiMultiplier').val()) || 1;
            const markerLength = parseFloat($('#planTxtAsortiMarkerLength').val()) || 0;
            const totalQty = parseFloat($('#planTxtAsortiTotal').val()) || 0;
            const unitMeterage = parseFloat($('#planTxtAsortiUnitMeterage').val()) || 0;

            if (totalQty <= 0) {
                showBeautifulAlert("Lütfen geçerli bir kesim değeri giriniz (toplam adet > 0 olmalı).", "warning");
                return;
            }

            const sizes = {};
            let validationError = "";
            $('.asorti-adet-input-row').each(function() {
                const sizeName = $(this).data('size');
                const asortiValue = parseFloat($(this).data('ratio')) || 0;
                const val = asortiValue * multiplier;
                if(val > 0) {
                    const targetQty = (parseFloat(planTargetSizesAsorti[sizeName]) || 0) * planAsortiCount;
                    const alreadyCut = planGetTotalCutForSize(sizeName, 'Asorti');
                    if ((alreadyCut + val) > targetQty) {
                        validationError = `Hata: '${sizeName}' bedeni için sipariş hedefini aşıyorsunuz! (Hedef: ${targetQty}, Toplam Kesilecek: ${alreadyCut + val})`;
                    }
                    sizes[sizeName] = val;
                }
            });
            
            if (validationError) {
                Swal.fire({
                    title: 'Hata',
                    text: validationError + "\n\nKesim planlamasında hedeflenen adetten fazlasını giremezsiniz. Fazla kesim kaydını sadece üretim (kesim) sürecinde ekleyebilirsiniz.",
                    icon: 'error',
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Tamam'
                });
                return;
            }
            
            _planAddCutToGlobalAndRender('Asorti', date, multiplier, sizes, totalQty, markerLength, unitMeterage);
            
            // Reset
            $('#planTxtAsortiMultiplier').val('1');
            $('#planCuttingEntryAsorti').hide();
            planCalculateAsorti();
        }

        function _planAddCutToGlobalAndRender(cutType, date, multiplier, sizes, totalQty, markerLength, unitMeterage) {
            const newCutName = "Kesim " + (planCuttingItems.length + 1);

            planCuttingItems.push({
                CutName: newCutName,
                CutType: cutType,
                Date: date,
                Multiplier: multiplier,
                Sizes: sizes,
                TotalQuantity: totalQty,
                MarkerLength: markerLength,
                UnitMeterage: unitMeterage
            });

            planRenderCuttingTable();
        }

        let editingCutIndexAcik = -1;
        let editingCutIndexAsorti = -1;

        function planEditCuttingItem(index, cutType) {
            if (cutType === 'Açık Adet') {
                editingCutIndexAcik = index;
            } else {
                editingCutIndexAsorti = index;
            }
            planRenderCuttingTable();
        }
        
        function planCancelInlineEdit(cutType) {
            if (cutType === 'Açık Adet') {
                editingCutIndexAcik = -1;
            } else {
                editingCutIndexAsorti = -1;
            }
            planRenderCuttingTable();
        }
        
        function planSaveInlineEdit(index, cutType) {
            let item = planCuttingItems[index];
            let validationError = "";
            if (cutType === 'Açık Adet') {
                let newDate = $('#inlineAcikDate_' + index).val();
                let newMultiplier = parseFloat($('#inlineAcikMultiplier_' + index).val()) || 1;
                let sizes = {};
                let totalQty = 0;
                
                if (typeof acikSizesArr !== 'undefined') {
                    acikSizesArr.forEach(s => {
                        let baseVal = parseFloat($('#inlineAcikSize_' + index + '_' + s).val()) || 0;
                        let calc = baseVal * newMultiplier;
                        
                        if(calc > 0) {
                            const targetQty = parseFloat(planTargetSizes[s]) || 0;
                            const oldVal = parseFloat(item.Sizes && item.Sizes[s] ? item.Sizes[s] : 0) || 0;
                            const alreadyCut = planGetTotalCutForSize(s, 'Açık Adet') - oldVal;
                            if ((alreadyCut + calc) > targetQty) {
                                validationError = `Hata: '${s}' bedeni için sipariş hedefini aşıyorsunuz! (Hedef: ${targetQty}, Toplam Kesilecek: ${alreadyCut + calc})`;
                            }
                        }
                        
                        sizes[s] = calc;
                        totalQty += calc;
                    });
                }
                
                if (validationError) {
                    Swal.fire({
                        title: 'Hata',
                        text: validationError + "\n\nKesim planlamasında hedeflenen adetten fazlasını giremezsiniz. Lütfen kat sayısını veya beden adetlerini kontrol edin.",
                        icon: 'error',
                        confirmButtonColor: '#3085d6',
                        confirmButtonText: 'Tamam'
                    });
                    return;
                }
                
                item.Date = newDate;
                item.Multiplier = newMultiplier;
                item.Sizes = sizes;
                item.TotalQuantity = totalQty;
                
                editingCutIndexAcik = -1;
            } else {
                let newDate = $('#inlineAsortiDate_' + index).val();
                let newMultiplier = parseFloat($('#inlineAsortiMultiplier_' + index).val()) || 1;
                let sizes = {};
                let totalQty = 0;
                
                if (typeof asortiSizesArr !== 'undefined') {
                    asortiSizesArr.forEach(s => {
                        let baseVal = parseFloat($('#inlineAsortiSize_' + index + '_' + s).val()) || 0;
                        let calc = baseVal * newMultiplier;
                        
                        if(calc > 0) {
                            const targetQty = (parseFloat(planTargetSizesAsorti[s]) || 0) * planAsortiCount;
                            const oldVal = parseFloat(item.Sizes && item.Sizes[s] ? item.Sizes[s] : 0) || 0;
                            const alreadyCut = planGetTotalCutForSize(s, 'Asorti') - oldVal;
                            if ((alreadyCut + calc) > targetQty) {
                                validationError = `Hata: '${s}' bedeni için sipariş hedefini aşıyorsunuz! (Hedef: ${targetQty}, Toplam Kesilecek: ${alreadyCut + calc})`;
                            }
                        }
                        
                        sizes[s] = calc;
                        totalQty += calc;
                    });
                }
                
                if (validationError) {
                    Swal.fire({
                        title: 'Hata',
                        text: validationError + "\n\nKesim planlamasında hedeflenen adetten fazlasını giremezsiniz. Lütfen kat sayısını veya beden adetlerini kontrol edin.",
                        icon: 'error',
                        confirmButtonColor: '#3085d6',
                        confirmButtonText: 'Tamam'
                    });
                    return;
                }
                
                item.Date = newDate;
                item.Multiplier = newMultiplier;
                item.Sizes = sizes;
                item.TotalQuantity = totalQty;
                
                editingCutIndexAsorti = -1;
            }
            planRenderCuttingTable();
            planSaveCuttingData();
        }

        function planRemoveCuttingItem(index) {
            planCuttingItems.splice(index, 1);
            
            // Numaraları Yeniden Sırala
            planCuttingItems.forEach((item, idx) => {
                item.CutName = "Kesim " + (idx + 1);
            });
            
            planRenderCuttingTable();
            planSaveCuttingData();
        }

        function planRenderCuttingTable() {
            let htmlAcik = '';
            let htmlAsorti = '';
            let acikTotal = 0;
            let asortiTotal = 0;
            let grandTotal = 0;
            
            let acikSizeTotals = {};
            let asortiSizeTotals = {};
            
            planCuttingItems.forEach((item, index) => {
                let cutName = item.CutName || `Kesim ${index + 1}`;
                let cutTypeLabel = item.CutType || 'Açık Adet';
                let isAsorti = cutTypeLabel === 'Asorti';
                let sizesArr = isAsorti ? (typeof asortiSizesArr !== 'undefined' ? asortiSizesArr : []) : (typeof acikSizesArr !== 'undefined' ? acikSizesArr : []);
                
                let isEditing = (isAsorti && editingCutIndexAsorti === index) || (!isAsorti && editingCutIndexAcik === index);
                
                let sizesHtml = '';
                if (sizesArr && sizesArr.length > 0) {
                    sizesArr.forEach(s => {
                        let val = parseFloat(item.Sizes && item.Sizes[s] ? item.Sizes[s] : 0) || 0;
                        if (isAsorti) {
                            asortiSizeTotals[s] = (asortiSizeTotals[s] || 0) + val;
                        } else {
                            acikSizeTotals[s] = (acikSizeTotals[s] || 0) + val;
                        }
                        
                        let displayVal = val;
                        if (displayVal % 1 !== 0) {
                            displayVal = displayVal.toFixed(2);
                        }
                        
                        if (isEditing) {
                            let prefix = isAsorti ? 'inlineAsorti' : 'inlineAcik';
                            let baseVal = val / (item.Multiplier || 1);
                            if (baseVal % 1 !== 0) {
                                baseVal = parseFloat(baseVal.toFixed(2));
                            }
                            let valStr = baseVal === 0 ? "" : baseVal;
                            sizesHtml += `<td><input type="number" id="${prefix}Size_${index}_${s}" class="form-control form-control-sm" value="${valStr}" placeholder="0" style="text-align: center; min-width: 50px;" /></td>`;
                        } else {
                            sizesHtml += `<td style="text-align: center;">${displayVal}</td>`;
                        }
                    });
                } else {
                    sizesHtml = `<td style="text-align: center;">-</td>`;
                }
                
                let qty = item.TotalQuantity || 0;
                grandTotal += qty;
                
                let rowHtml = '';
                if (isEditing) {
                    let prefix = isAsorti ? 'inlineAsorti' : 'inlineAcik';
                    rowHtml = `
                    <tr style="background: #fdf2f8;">
                        <td class="sticky-kesim" style="font-weight: 700; color: #1e293b; text-align: center; position: sticky; left: 0; background: #fdf2f8; z-index: 2;">${cutName}</td>
                        <td><input type="number" id="${prefix}Multiplier_${index}" class="form-control form-control-sm" value="${item.Multiplier || 1}" style="text-align: center; min-width: 60px;" /></td>
                        ${sizesHtml}
                        <td style="text-align: center;"><strong style="color: #0f172a; font-size: 1.1rem;">${qty}</strong></td>
                        <td><input type="date" id="${prefix}Date_${index}" class="form-control form-control-sm" value="${item.Date}" style="text-align: center;" /></td>
                        <td class="sticky-islem" style="text-align: center; position: sticky; right: 0; background: #fdf2f8; z-index: 2;">
                            <div style="display: flex; gap: 4px; justify-content: center;">
                                <button type="button" class="btn btn-sm" onclick="planSaveInlineEdit(${index}, '${cutTypeLabel}')" title="Kaydet" style="border-radius: 4px; background: #22c55e; color: white;"><i class="fa-solid fa-check"></i></button>
                                <button type="button" class="btn btn-sm" onclick="planCancelInlineEdit('${cutTypeLabel}')" title="İptal" style="border-radius: 4px; background: #e2e8f0; color: #334155;"><i class="fa-solid fa-xmark"></i></button>
                            </div>
                        </td>
                    </tr>
                    `;
                } else {
                    rowHtml = `
                    <tr>
                        <td class="sticky-kesim" style="font-weight: 700; color: #1e293b; text-align: center; position: sticky; left: 0; background: #ffffff; z-index: 2;">${cutName}</td>
                        <td style="text-align: center;">${item.Multiplier}</td>
                        ${sizesHtml}
                        <td style="text-align: center;"><strong style="color: #0f172a; font-size: 1.1rem;">${qty}</strong></td>
                        <td style="text-align: center;">${item.Date}</td>
                        <td class="sticky-islem" style="text-align: center; position: sticky; right: 0; background: #ffffff; z-index: 2;">
                            <button class="btn btn-sm" style="color: #3b82f6; background: transparent; border: none; font-size: 1.1rem; padding: 4px;" onclick="planEditCuttingItem(${index}, '${cutTypeLabel}')" title="Düzenle"><i class="fa-solid fa-pen-to-square"></i></button>
                            <button class="btn btn-sm" style="color: #ef4444; background: transparent; border: none; font-size: 1.1rem; padding: 4px;" onclick="planRemoveCuttingItem(${index})" title="Sil"><i class="fa-solid fa-trash-can"></i></button>
                        </td>
                    </tr>
                    `;
                }
                
                if (isAsorti) {
                    htmlAsorti += rowHtml;
                    asortiTotal += qty;
                } else {
                    htmlAcik += rowHtml;
                    acikTotal += qty;
                }
            });
            
            $('#planCuttingBodyAcik').html(htmlAcik);
            $('#planAcikTotalCut').text(acikTotal.toLocaleString('tr-TR'));
            
            // Açık Adet Beden Toplamlarını Güncelle
            if (typeof acikSizesArr !== 'undefined') {
                acikSizesArr.forEach(s => {
                    let totalVal = acikSizeTotals[s] || 0;
                    let displayTotal = totalVal % 1 !== 0 ? totalVal.toFixed(2) : totalVal;
                    $('#planAcikTotalCutSize_' + s).text(displayTotal);
                });
            }
            
            $('#planCuttingBodyAsorti').html(htmlAsorti);
            $('#planAsortiTotalCut').text(asortiTotal.toLocaleString('tr-TR'));
            
            // Asorti Beden Toplamlarını Güncelle
            if (typeof asortiSizesArr !== 'undefined') {
                asortiSizesArr.forEach(s => {
                    let totalVal = asortiSizeTotals[s] || 0;
                    let displayTotal = totalVal % 1 !== 0 ? totalVal.toFixed(2) : totalVal;
                    $('#planAsortiTotalCutSize_' + s).text(displayTotal);
                });
            }
            
            $('#planGrandTotalCut').text(grandTotal.toLocaleString('tr-TR'));

            // Sipariş limit kontrolü
            let orderQty = typeof getDynamicOrderQty === 'function' ? getDynamicOrderQty() : @Model.CalculatedQuantity;
            let remaining = orderQty - grandTotal;
            if (remaining > 0) {
                $('#planDivRemainingCut').css('color', '#166534').html(`Kalan İhtiyaç: <strong id="planLblRemainingQty">${remaining}</strong> Adet`);
                $('#planBtnEkleKesim').prop('disabled', false).removeClass('btn-secondary').addClass('btn-primary').html('<i class="fa-solid fa-plus" style="margin-right:4px;"></i> Kesim Ekle');
            } else {
                let excess = Math.abs(remaining);
                let text = excess > 0 ? `Hedef Tamamlandı! (Fazla: ${excess} Adet)` : `Hedef Tamamlandı!`;
                $('#planDivRemainingCut').css('color', '#15803d').html(`<i class="fa-solid fa-circle-check" style="margin-right: 5px;"></i> <strong>${text}</strong>`);
                $('#planBtnEkleKesim').prop('disabled', true).removeClass('btn-primary').addClass('btn-secondary').html('<i class="fa-solid fa-lock" style="margin-right:4px;"></i> Kilitli');
            }
        }

        function planSaveCuttingData() {
            $.ajax({
                url: '/Planning/UpdatePlannedCutting',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ Id: orderId, PlannedCuttingJson: JSON.stringify(planCuttingItems) }),
                success: function(res) {
                    if(res.success) showBeautifulAlert("Kesim bilgileri kaydedildi.", "success");
                    else showBeautifulAlert("Hata: " + res.message, "danger");
                }
            });
        }

        function printKesimPlanlamasi() {
            var orderCode = document.querySelector('.headerOrderQty').closest('th').innerText;
            var acikHtml = document.getElementById('planTblCuttingAcik').outerHTML;
            var asortiHtml = document.getElementById('planTblCuttingAsorti').outerHTML;
            var grandTotalHTML = document.getElementById('planGrandTotalCut').parentNode.outerHTML;
            
            var printContent = "<" + "html>\n" +
            "<" + "head>\n" +
            "    <" + "title>Kesim Föyü<" + "/title>\n" +
            "    <" + "style>\n" +
            "        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 20px; color: #1e293b; background: white; }\n" +
            "        h2 { text-align: center; color: #0f172a; margin-bottom: 25px; border-bottom: 2px solid #e2e8f0; padding-bottom: 15px; }\n" +
            "        table { width: 100%; border-collapse: collapse; margin-bottom: 30px; font-size: 13px; }\n" +
            "        th, td { border: 1px solid #cbd5e1; padding: 10px; text-align: center; }\n" +
            "        th { background-color: #f1f5f9 !important; color: #0f172a; font-weight: bold; }\n" +
            "        tfoot td { font-weight: bold; background-color: #f8fafc !important; }\n" +
            "        h3 { font-size: 16px; margin-bottom: 10px; color: #334155; }\n" +
            "        /* Hide inputs and actions */\n" +
            "        .sticky-islem { display: none !important; }\n" +
            "        #planCuttingEntryAcik, #planCuttingEntryAsorti { display: none !important; }\n" +
            "        input { border: none !important; background: transparent !important; text-align: center; font-size: 13px; padding: 0 !important; margin: 0 !important; width: 100%; outline: none; -moz-appearance: textfield; }\n" +
            "        input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }\n" +
            "        button { display: none !important; }\n" +
            "    <" + "/style>\n" +
            "<" + "/head>\n" +
            "<" + "body>\n" +
            "    <" + "h2>Kesim Föyü<" + "/h2>\n" +
            "    \n" +
            "    <" + "h3>Açık Adet Kesim Tablosu<" + "/h3>\n" +
            "    " + acikHtml + "\n" +
            "    \n" +
            "    <" + "h3>Asorti Kesim Tablosu<" + "/h3>\n" +
            "    " + asortiHtml + "\n" +
            "    \n" +
            "    <" + "div style='margin-top: 30px; display: flex; justify-content: flex-end;'>\n" +
            "        " + grandTotalHTML + "\n" +
            "    <" + "/div>\n" +
            "<" + "/body>\n" +
            "<" + "/html>";
            
            var printWindow = window.open('', '_blank');
            printWindow.document.write(printContent);
            printWindow.document.close();
            
            setTimeout(function() {
                printWindow.focus();
                printWindow.print();
                printWindow.close();
            }, 300);
        }

        
        function getDynamicOrderQty() {
            let orderQty = @Model.CalculatedQuantity;
            let firstGelenCikacak = document.querySelector('.mrp-gelen-cikacak');
            if (firstGelenCikacak) {
                let gelenVal = typeof parseTurkishFloat === 'function' ? parseTurkishFloat(firstGelenCikacak.value) : 0;
                if (gelenVal > 0) {
                    orderQty = gelenVal;
                }
            }
            return orderQty;
        }

        function updateGlobalTargetsUI() {
            let orderQty = getDynamicOrderQty();
            
            let topBadge = document.getElementById('topBadgeOrderQty');
            if (topBadge) topBadge.innerText = orderQty.toLocaleString('tr-TR');
            
            document.querySelectorAll('.headerOrderQty').forEach(function(el) {
                el.innerText = orderQty.toLocaleString('tr-TR');
            });
            
            let lblGenelToplam = document.getElementById('lblGenelToplamHedef');
            if (lblGenelToplam) lblGenelToplam.innerText = orderQty.toLocaleString('tr-TR');
            
            let asortiTotalEl = document.getElementById('lblAsortiTotalCount');
            if (asortiTotalEl) {
                let asortiTotal = parseInt(asortiTotalEl.value) || 0;
                if (asortiTotal > 0) {
                    let targetForAsorti = orderQty - (typeof initialAcikAdetTotal !== 'undefined' ? initialAcikAdetTotal : 0);
                    if (targetForAsorti < 0) targetForAsorti = 0;
                    
                    let dynAsortiHdr = document.getElementById('dynamicAsortiTargetQty');
                    if (dynAsortiHdr) dynAsortiHdr.innerText = targetForAsorti.toLocaleString('tr-TR');
                    
                    let dynamicLot = Math.floor(targetForAsorti / asortiTotal);
                    let dynamicTotal = dynamicLot * asortiTotal;
                    let tekleme = targetForAsorti - dynamicTotal;
                    
                    let lotEl = document.getElementById('lblAsortiLot');
                    if (lotEl) lotEl.innerText = dynamicLot.toLocaleString('tr-TR');
                    
                    let aTopEl = document.getElementById('lblAsortiToplamText');
                    if (aTopEl) aTopEl.innerText = dynamicTotal.toLocaleString('tr-TR');
                    
                    let tekEl = document.getElementById('lblAsortiTeklemeText');
                    if (tekEl) tekEl.innerText = tekleme.toLocaleString('tr-TR');
                    
                    let tekContainer = document.getElementById('lblAsortiTeklemeContainer');
                    if (tekContainer) {
                        tekContainer.style.display = (tekleme > 0) ? 'inline' : 'none';
                    }
                    
                    let alertEl = document.getElementById('lblAsortiTeklemeAlertText');
                    if (alertEl) alertEl.innerText = tekleme.toLocaleString('tr-TR');
                    
                    let alertBox = document.getElementById('boxAsortiTeklemeAlert');
                    if (alertBox) {
                        alertBox.style.display = (tekleme > 0) ? 'flex' : 'none';
                    }
                }
            }
            
            if (typeof planRenderCuttingTable === 'function') {
                planRenderCuttingTable();
            }
        }

    document.addEventListener('DOMContentLoaded', function() {
        planRenderCuttingTable();
        calculateMRP();

        // Sipariş listesi başlangıç filtresi: Aktif
        var currentOrderFilterInit = 'active';
        currentOrderFilter = currentOrderFilterInit;
        filterOrders();

        // Aktif siparişi listede görünür alana kaydır
        var activeOrder = document.querySelector('.order-list-item.active');
        if (activeOrder) {
            activeOrder.scrollIntoView({ behavior: 'auto', block: 'center' });
        }

    function bindCompletionValidation(formId, checkboxName, phaseName) {
        var form = document.getElementById(formId);
        if (!form) return;
        var checkbox = form.querySelector('input[name="' + checkboxName + '"]');
        if (!checkbox) return;
        
        function checkEmptyFields() {
            var emptyFields = false;
            var inputs = form.querySelectorAll('input:not([type="hidden"]):not([readonly]):not([type="checkbox"]):not(:disabled):not(.not-mandatory), select:not(:disabled):not(.not-mandatory)');
            for(var i=0; i<inputs.length; i++) {
                // Sadece ekranda görünür olan alanları zorunlu tut
                if (inputs[i].offsetWidth > 0 || inputs[i].offsetHeight > 0) {
                    if (inputs[i].value.trim() === '') {
                        emptyFields = true;
                        inputs[i].style.border = '2px solid #ef4444'; // Hatalı alanı kırmızı ile işaretle
                    } else {
                        inputs[i].style.border = ''; // Dolu olanın işaretini kaldır
                    }
                }
            }
            return emptyFields;
        }

        checkbox.addEventListener('change', function(e) {
            if (this.checked) {
                if (checkEmptyFields()) {
                    showBeautifulAlert("Tüm alanlar doldurulmadan " + phaseName + " tamamlandı olarak işaretlenemez. Lütfen boş alanları doldurunuz.");
                    this.checked = false;
                }
            }
        });

        form.addEventListener('submit', function(e) {
            var isCompleted = checkbox.checked;
            if (isCompleted) {
                if (checkEmptyFields()) {
                    showBeautifulAlert("Tüm alanlar doldurulmadan " + phaseName + " tamamlandı olarak işaretlenemez. Plan kaydedilecek ancak tamamlandı işareti kaldırılacaktır.");
                    checkbox.checked = false;
                    isCompleted = false;
                }
            }
            
            // Satın alma formu için özel kontrol
            if (formId === 'purchasing-form') {
                var hasMissingEl = document.getElementById('pur_has_missing_materials');
                var hasMissing = hasMissingEl ? hasMissingEl.value === "true" : false;
                if (hasMissing && isCompleted && !form.dataset.confirmed) {
                    e.preventDefault();
                    showBeautifulConfirm("Dikkat: Bu siparişte eksik malzemeler bulunmaktadır. Yine de Satın Alma aşamasını tamamlanmış olarak işaretlemek istiyor musunuz?", function() {
                        form.dataset.confirmed = 'true';
                        form.submit();
                    });
                }
            }
        });
    }

    bindCompletionValidation('sample-form', 'IsSampleTestCompleted', 'Numune Planlama');
    bindCompletionValidation('purchasing-form', 'IsPurchasingCompleted', 'Satın Alma Planlama');
    bindCompletionValidation('production-form', 'IsProductionCompleted', 'Üretim Planlama');
});
</script>

<script>
    
    document.addEventListener("DOMContentLoaded", function() {
        var activeTabInit = '@Html.Raw(ViewBag.ActiveTab ?? TempData["ActiveTab"] ?? "cps")';
        if(activeTabInit === 'worksheet' || activeTabInit === 'calisma') {
            switchTabUnified('calisma', document.getElementById('btn-tab-calisma'));
        } else {
            switchTabUnified('cps', document.getElementById('btn-tab-cps'));
        }
    });
    function switchTabUnified(tabId, element) {
        document.querySelectorAll('.plan-tab').forEach(t => t.classList.remove('active'));
        if(element) element.classList.add('active');
        
        let headerTitleEl = document.getElementById('header-title');
        let orderCode = '@Model.OrderCode';
        let newTitle = (tabId === 'cps' ? 'CPS: ' : 'ÇLŞ: ') + orderCode;
        document.title = newTitle + ' - Kanuni Tekstil';
        
        if (headerTitleEl) {
            if (tabId === 'cps') {
                headerTitleEl.innerHTML = '<i class="fa-solid fa-table-cells" style="color: #64748b;"></i> CPS Planlama Ekranı';
            } else {
                headerTitleEl.innerHTML = '<i class="fa-solid fa-calculator" style="color: #64748b;"></i> Çalışma Sayfası';
            }
        }
        
        if (window.self !== window.top && window.parent.document) {
            let iframes = window.parent.document.querySelectorAll('iframe');
            iframes.forEach(function(ifr) {
                if (ifr.contentWindow === window.self) {
                    let parentTabId = ifr.id.replace('iframe-', 'btn-');
                    let tabTitleEl = window.parent.document.querySelector('#' + parentTabId + ' .tab-title');
                    if (tabTitleEl) {
                        tabTitleEl.innerText = newTitle;
                        tabTitleEl.setAttribute('title', newTitle);
                    }
                    if (window.parent.appTabs && window.parent.appTabs.openTabs) {
                        let openTabId = ifr.id.replace('iframe-', '');
                        if (window.parent.appTabs.openTabs[openTabId]) {
                            window.parent.appTabs.openTabs[openTabId].title = newTitle;
                        }
                    }
                }
            });
        }
        
        if(tabId === 'cps') {
            document.getElementById('part-cps-dates').style.display = 'block';
            var part2 = document.getElementById('part-cps-dates-2');
            if (part2) part2.style.display = 'block';
            document.querySelectorAll('.part-tedarik').forEach(el => el.style.display = 'block');
            document.querySelectorAll('.part-mrp').forEach(el => el.style.display = 'none');
            document.getElementById('part-kesim').style.display = 'none';
        } else {
            document.getElementById('part-cps-dates').style.display = 'none';
            var part2 = document.getElementById('part-cps-dates-2');
            if (part2) part2.style.display = 'none';
            document.querySelectorAll('.part-tedarik').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.part-mrp').forEach(el => el.style.display = 'block');
            document.getElementById('part-kesim').style.display = 'block';
        }
    }
    
    function saveUnifiedDates() {
        var fdSample = new FormData(document.getElementById('sample-form'));
        var fdProd = new FormData(document.getElementById('production-form'));
        var fdPur = new FormData(document.getElementById('purchasing-form'));
        
        Promise.all([
            fetch('/Planning/UpdateSampleTestPlan', { method: 'POST', body: fdSample, headers: { 'X-Requested-With': 'Fetch' } }),
            fetch('/Planning/UpdateProductionPlan', { method: 'POST', body: fdProd, headers: { 'X-Requested-With': 'Fetch' } }),
            fetch('/Planning/UpdatePurchasingPlan', { method: 'POST', body: fdPur, headers: { 'X-Requested-With': 'Fetch' } })
        ]).then(responses => {
            const allOk = responses.every(r => r.ok);
            if (!allOk) {
                throw new Error("Sunucu isteği başarısız oldu.");
            }
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Başarılı!',
                    text: 'Tarihler başarıyla kaydedildi.',
                    icon: 'success',
                    confirmButtonText: 'Tamam',
                    confirmButtonColor: '#10b981'
                });
            }
        }).catch(err => {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Hata!',
                    text: 'Kaydetme sırasında bir hata oluştu: ' + err,
                    icon: 'error',
                    confirmButtonText: 'Tamam',
                    confirmButtonColor: '#ef4444'
                });
            }
        });
    }
    
    // ATÖLYE SÜREÇ KAYDIRMA ALGORİTMASI
    document.addEventListener("DOMContentLoaded", function() {
        const atolyeSelect = document.getElementById("prod_dikim_atolyesi");
        if (atolyeSelect) {
            atolyeSelect.dataset.oldValue = atolyeSelect.value;
            atolyeSelect.addEventListener('focus', function() {
                this.dataset.oldValue = this.value;
            });
            atolyeSelect.addEventListener("change", function() {
                const oldVal = this.dataset.oldValue;
                const selectedOption = this.options[this.selectedIndex];
                const capacity = parseInt(selectedOption.getAttribute("data-capacity") || "0");
                const miktarInput = document.getElementById("prodDikimMiktari");
                const miktar = parseInt(miktarInput ? miktarInput.value : "0") || parseInt('@Model.CalculatedQuantity') || 0;
                
                if (capacity > 0 && miktar > 0) {
                    const daysNeeded = Math.ceil(miktar / capacity);
                    
                    const startInput = document.querySelector('input[name="prod_dikim_baslangic"]');
                    const endInput = document.querySelector('input[name="prod_dikim_bitis"]');
                    
                    if (startInput && endInput && startInput.value) {
                        const startDate = new Date(startInput.value);
                        const oldEndDateStr = endInput.value;
                        
                        // Yeni bitiş tarihi hesaplama (Pazar günleri dahil)
                        const newEndDate = new Date(startDate);
                        newEndDate.setDate(newEndDate.getDate() + daysNeeded);
                        const newEndDateStr = newEndDate.toISOString().split('T')[0];
                        
                        if (oldEndDateStr && oldEndDateStr !== newEndDateStr) {
                            const oldEndDate = new Date(oldEndDateStr);
                            const shiftDays = Math.round((newEndDate - oldEndDate) / (1000 * 60 * 60 * 24));
                            
                            const msg = `Seçilen atölyenin günlük kapasitesi (${capacity} adet) dikkate alındığında dikim süresi ${daysNeeded} gün olarak hesaplandı.\nSonraki tüm süreç tarihleri ${Math.abs(shiftDays)} gün ${shiftDays > 0 ? 'İLERİ' : 'GERİ'} kaydırılsın mı?`;
                            
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    title: 'Süreç Güncellemesi',
                                    text: msg,
                                    icon: 'question',
                                    showDenyButton: true,
                                    showCancelButton: true,
                                    confirmButtonText: 'Evet, Kaydır',
                                    denyButtonText: 'Hayır, Dokunma',
                                    cancelButtonText: 'İptal'
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        Swal.fire({
                                            title: 'Hangi Süreçten İtibaren Kaydırılsın?',
                                            html: `
                                                <div style="text-align: left; padding: 10px; max-width: 300px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px; max-height: 250px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 8px;">
                                                    <label style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                                        <input type="checkbox" class="swal-shift-cb" value="prod_kumas_gelis_tarihi" checked style="width: 18px; height: 18px;"> Kumaş Geliş Tarihi
                                                    </label>
                                                    <label style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                                        <input type="checkbox" class="swal-shift-cb" value="prod_kumas_lot_farki" checked style="width: 18px; height: 18px;"> Kumaş Lot Farkı
                                                    </label>
                                                    <label style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                                        <input type="checkbox" class="swal-shift-cb" value="prod_yikama_cekme" checked style="width: 18px; height: 18px;"> Yıkama Çekme
                                                    </label>
                                                    <label style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                                        <input type="checkbox" class="swal-shift-cb" value="prod_kesim_baslangic" checked style="width: 18px; height: 18px;"> Kesim Başlangıç
                                                    </label>
                                                    <label style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                                        <input type="checkbox" class="swal-shift-cb" value="prod_kesim_bitis" checked style="width: 18px; height: 18px;"> Kesim Bitiş
                                                    </label>
                                                    <label style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                                        <input type="checkbox" class="swal-shift-cb" value="prod_dikim_baslangic" checked style="width: 18px; height: 18px;"> Dikim Başlangıç
                                                    </label>
                                                    <label style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                                        <input type="checkbox" class="swal-shift-cb" value="prod_gs_gidisi" checked style="width: 18px; height: 18px;"> GS Gidişi
                                                    </label>
                                                    <label style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                                        <input type="checkbox" class="swal-shift-cb" value="prod_paket_baslangic" checked style="width: 18px; height: 18px;"> Paket Başlangıç
                                                    </label>
                                                    <label style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                                        <input type="checkbox" class="swal-shift-cb" value="prod_paket_bitis" checked style="width: 18px; height: 18px;"> Paket Bitiş
                                                    </label>
                                                    <label style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                                        <input type="checkbox" class="swal-shift-cb" value="prod_yola_cikis" checked style="width: 18px; height: 18px;"> Yola Çıkış
                                                    </label>
                                                    <label style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                                        <input type="checkbox" class="swal-shift-cb" value="prod_depo_varis" checked style="width: 18px; height: 18px;"> Depo Varış
                                                    </label>
                                                </div>
                                            `,
                                            showCancelButton: true,
                                            confirmButtonText: 'Uygula',
                                            cancelButtonText: 'İptal',
                                            preConfirm: () => {
                                                const checkedBoxes = document.querySelectorAll('.swal-shift-cb:checked');
                                                if (checkedBoxes.length === 0) {
                                                    Swal.showValidationMessage('Lütfen en az bir süreç seçin.');
                                                    return false;
                                                }
                                                return Array.from(checkedBoxes).map(cb => cb.value);
                                            }
                                        }).then((stepResult) => {
                                            if (stepResult.isConfirmed) {
                                                applyShiftToDates(shiftDays, newEndDateStr, stepResult.value);
                                                atolyeSelect.dataset.oldValue = atolyeSelect.value;
                                            } else {
                                                atolyeSelect.value = oldVal;
                                            }
                                        });
                                    } else if (result.isDenied) {
                                        atolyeSelect.dataset.oldValue = atolyeSelect.value;
                                    } else {
                                        atolyeSelect.value = oldVal;
                                    }
                                });
                            } else {
                                Swal.fire({
                                    title: 'Tarihleri Kaydır',
                                    text: msg,
                                    icon: 'question',
                                    showCancelButton: true,
                                    showDenyButton: true,
                                    confirmButtonColor: '#0284c7',
                                    cancelButtonColor: '#94a3b8',
                                    denyButtonColor: '#ef4444',
                                    confirmButtonText: 'Evet, Kaydır',
                                    denyButtonText: 'İptal Et',
                                    cancelButtonText: 'Hayır, Sadece Atölyeyi Değiştir'
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        Swal.fire({
                                            title: 'Süreç Seçimi',
                                            text: 'Hangi süreçten itibaren kaydırılsın?',
                                            input: 'select',
                                            inputOptions: {
                                                'all': 'Tümü',
                                                'paket_baslangic': 'Paket Başlangıç',
                                                'paket_bitis': 'Paket Bitiş',
                                                'yola_cikis': 'Yola Çıkış',
                                                'depo_varis': 'Depo Varış'
                                            },
                                            inputValue: 'all',
                                            showCancelButton: true,
                                            confirmButtonColor: '#0284c7',
                                            cancelButtonColor: '#94a3b8',
                                            confirmButtonText: 'Uygula',
                                            cancelButtonText: 'İptal'
                                        }).then((stepResult) => {
                                            if (stepResult.isConfirmed) {
                                                applyShiftToDates(shiftDays, newEndDateStr, stepResult.value);
                                                atolyeSelect.dataset.oldValue = atolyeSelect.value;
                                            } else {
                                                atolyeSelect.value = oldVal;
                                            }
                                        });
                                    } else if (result.isDenied) {
                                        atolyeSelect.value = oldVal;
                                    } else {
                                        atolyeSelect.dataset.oldValue = atolyeSelect.value;
                                    }
                                });
                            }
                        } else if (!oldEndDateStr) {
                            endInput.value = newEndDateStr;
                            atolyeSelect.dataset.oldValue = atolyeSelect.value;
                        }
                    }
                } else {
                    atolyeSelect.dataset.oldValue = atolyeSelect.value;
                }
            });
        }
        
        function applyShiftToDates(shiftDays, newDikimBitisStr, startStep = 'all') {
            const endInput = document.querySelector('input[name="prod_dikim_bitis"]');
            if(endInput) endInput.value = newDikimBitisStr;
            
            let fieldsToShift = [];
            
            if (Array.isArray(startStep)) {
                fieldsToShift = startStep;
            } else {
                if (startStep === 'all') {
                    fieldsToShift = ['prod_gs_gidisi', 'prod_paket_baslangic', 'prod_paket_bitis', 'prod_yola_cikis', 'prod_depo_varis'];
                } else if (startStep === 'paket_baslangic') {
                    fieldsToShift = ['prod_paket_baslangic', 'prod_paket_bitis', 'prod_yola_cikis', 'prod_depo_varis'];
                } else if (startStep === 'paket_bitis') {
                    fieldsToShift = ['prod_paket_bitis', 'prod_yola_cikis', 'prod_depo_varis'];
                } else if (startStep === 'yola_cikis') {
                    fieldsToShift = ['prod_yola_cikis', 'prod_depo_varis'];
                } else if (startStep === 'depo_varis') {
                    fieldsToShift = ['prod_depo_varis'];
                }
            }
            
            fieldsToShift.forEach(fieldName => {
                const input = document.querySelector(`input[name="${fieldName}"]`);
                if (input && input.value) {
                    const d = new Date(input.value);
                    d.setDate(d.getDate() + shiftDays);
                    input.value = d.toISOString().split('T')[0];
                }
            });
            
            if (typeof Swal !== 'undefined') {
                Swal.fire('Başarılı', 'Tarihler otomatik olarak güncellendi. Kalıcı olması için kaydetmeyi unutmayın.', 'success');
            }
        }
    });
</script>



