@model UretimPlanlama.Models.Order
@{
    var activeTabStr = ViewBag.ActiveTab?.ToString() ?? TempData["ActiveTab"]?.ToString() ?? "cps";
    ViewData["Title"] = (activeTabStr == "calisma" || activeTabStr == "worksheet" ? "ÇLŞ: " : "CPS: ") + Model.OrderCode;
    var allOrders = ViewBag.AllOrders as List<UretimPlanlama.Models.Order>;

    var prodData = new System.Collections.Generic.Dictionary<string, string>();
    if (!string.IsNullOrEmpty(Model.ProductionJson))
    {
        try {
            prodData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.ProductionJson);
        } catch {}
    }
    string GetProdVal(string key) => prodData != null && prodData.ContainsKey(key) ? prodData[key] : "";

    var sampleData = new System.Collections.Generic.Dictionary<string, string>();
    if (!string.IsNullOrEmpty(Model.SampleTestJson))
    {
        try {
            sampleData = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(Model.SampleTestJson);
        } catch {}
    }
    string GetSampleVal(string key) => sampleData != null && sampleData.ContainsKey(key) ? sampleData[key] : "";
}

<style>
    .planning-layout {
        display: flex;
        gap: 20px;
        align-items: stretch;
        min-height: calc(100vh - 80px);
    }
    
    .main-content, 
    .tab-pane, 
    .tab-system-content, 
    .main-content-wrapper, 
    .main-container, 
    .wrapper {
        overflow: visible !important;
        overflow-x: visible !important;
        overflow-y: visible !important;
    }
    
    .sidebar-orders {
        width: 300px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 10px;
        max-height: calc(100vh - 20px);
    }
    .sidebar-header {
        padding: 16px;
        border-bottom: 1px solid var(--border-color);
        background: #f8fafc;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: var(--text-main);
    }
    
    .order-list-item {
        padding: 16px;
        border-bottom: 1px solid var(--border-color);
        cursor: pointer;
        transition: background-color 0.2s;
        text-decoration: none;
        display: block;
        color: inherit;
    }
    
    .order-list-item:hover {
        background-color: #f1f5f9;
    }
    
    .order-list-item.active {
        border-left: 4px solid var(--primary-color);
        background-color: #f0f9ff;
    }
    
    .main-planning {
        flex-grow: 1;
        min-width: 0;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        padding: 24px;
    }
    
    .plan-tabs {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
    }
    
    .plan-tab {
        flex: 1;
        background: #f8fafc;
        border: 2px solid transparent;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }
    
    .plan-tab:hover {
        background: #f1f5f9;
    }
    
    .plan-tab.active {
        border-color: var(--primary-color);
        background: #f0f9ff;
    }
    
    .plan-tab i {
        font-size: 1.5rem;
        color: #64748b;
    }
    
    .plan-tab.active i {
        color: var(--primary-color);
    }
    
    .plan-tab-title {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--text-main);
    }
    
    .plan-tab-status {
        font-size: 0.75rem;
        font-weight: 700;
    }
    
    .status-complete { color: #16a34a; }
    .status-progress { color: #d97706; }
    .status-notstarted { color: #64748b; }
    
    .tab-content {
        display: none;
    }
    
    .tab-content.active {
        display: block;
    }
    
    .content-section {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }
    
    .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .data-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }
    
    .data-item {
        background: #f8fafc;
        padding: 12px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
    }
    
    .data-label {
        font-size: 0.75rem;
        color: #64748b;
        margin-bottom: 4px;
        font-weight: 600;
        text-transform: uppercase;
    }
    
    .data-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0f172a;
    }
    
    .input-field {
        width: 100%;
        padding: 6px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        font-size: 0.75rem;
    }
    
    .table-details {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin-top: 16px;
        background: #ffffff;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    
    .table-details th {
        background: #f8fafc;
        padding: 14px 16px;
        text-align: left;
        font-size: 0.75rem;
        color: #475569;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #94a3b8;
        border-right: 1px solid #cbd5e1;
    }
    
    .table-details th:last-child {
        border-right: none;
    }
    
    .table-details td {
        padding: 12px 16px;
        font-size: 0.9rem;
        vertical-align: middle;
        transition: background-color 0.2s;
        border-bottom: 1px solid #cbd5e1;
        border-right: 1px solid #cbd5e1;
    }
    
    .table-details td:last-child {
        border-right: none;
    }
    
    .table-details tbody tr:last-child td {
        border-bottom: none;
    }

    .table-details tbody tr:hover td {
        background-color: #f8fafc;
    }

    /* Style inputs inside table */
    .table-details input.input-field {
        border: 1px solid transparent;
        background: transparent;
        padding: 8px 12px;
        border-radius: 6px;
        transition: all 0.2s;
        box-shadow: none;
        font-weight: 600;
        color: #334155;
    }
    
    .table-details input.input-field:hover {
        background: #f1f5f9;
    }
    
    .table-details input.input-field:focus {
        border-color: #3b82f6;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        outline: none;
    }
</style>

<div class="planning-layout">
    <!-- Sağ İçerik: Planlama Detayı -->
    @if (Model != null && Model.Id > 0)
    {
        <div class="main-planning">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; position: relative;">
                <a href="/Planning" style="text-decoration: none; color: #0369a1; font-weight: 600; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: #f1f5f9; border-radius: 6px; border: 1px solid #e2e8f0; transition: all 0.2s; z-index: 10;">
                    <i class="fa-solid fa-arrow-left"></i> Planlama Listesine Dön
                </a>
                
                <div style="position: absolute; left: 50%; transform: translateX(-50%); white-space: nowrap;">
                    <h2 id="header-title" style="margin: 0; color: #1e293b; font-size: 1.5rem; font-weight: 800; display: flex; align-items: center; gap: 10px;">
                    @if (ViewBag.ActiveTab?.ToString() == "calisma" || TempData["ActiveTab"]?.ToString() == "calisma")
                    {
                        <i class="fa-solid fa-calculator" style="color: #64748b;"></i> <text>Çalışma Sayfası</text>
                    }
                    else
                    {
                        <i class="fa-solid fa-table-cells" style="color: #64748b;"></i> <text>CPS Planlama Ekranı</text>
                    }
                    </h2>
                </div>

                <a href="/Planning/ExportToExcel" class="btn-planner" style="background: #16a34a; border-color: #16a34a; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 5px; z-index: 10;"><i class="fa-solid fa-file-excel"></i> Excel</a>
            </div>

            <!-- LCW SUPPLIER TARZI ASILI KARTLAR (HANGING CARDS) -->
            <div style="margin-bottom: 25px; display: flex; gap: 12px; flex-wrap: wrap; z-index: 100; position: sticky; top: -1px; background: rgba(248, 250, 252, 0.95); backdrop-filter: blur(8px); padding: 10px 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
            
            <!-- Sipariş Kodu -->
            <div style="flex: 1; min-width: 120px; background: #fff; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); padding: 10px 14px; border: 1px solid #e2e8f0; position: relative; border-bottom: 3px solid #3b82f6;">
                <div style="font-size: 0.6rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;"><i class="fa-solid fa-hashtag" style="color: #94a3b8;"></i> SİPARİŞ KODU</div>
                <div style="font-size: 0.9rem; font-weight: 800; color: #0f172a; word-wrap: break-word;">@Model.OrderCode</div>
            </div>

            <!-- Model -->
            <div style="flex: 1.5; min-width: 130px; background: #fff; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); padding: 10px 14px; border: 1px solid #e2e8f0; position: relative; border-bottom: 3px solid #0ea5e9;">
                <div style="font-size: 0.6rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;"><i class="fa-solid fa-barcode" style="color: #94a3b8;"></i> MODEL</div>
                <div style="font-size: 0.85rem; font-weight: 700; color: #0f172a; word-wrap: break-word;" title="@Model.ModelName">@Model.ModelName</div>
            </div>

            <!-- Renk -->
            <div style="flex: 1; min-width: 110px; background: #fff; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); padding: 10px 14px; border: 1px solid #e2e8f0; position: relative; border-bottom: 3px solid #8b5cf6;">
                <div style="font-size: 0.6rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;"><i class="fa-solid fa-palette" style="color: #94a3b8;"></i> RENK</div>
                <div style="font-size: 0.85rem; font-weight: 700; color: #0f172a; word-wrap: break-word;" title="@Model.Color">@Model.Color</div>
            </div>

            <!-- Müşteri -->
            <div style="flex: 1.5; min-width: 130px; background: #fff; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); padding: 10px 14px; border: 1px solid #e2e8f0; position: relative; border-bottom: 3px solid #10b981;">
                <div style="font-size: 0.6rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;"><i class="fa-solid fa-building" style="color: #94a3b8;"></i> MÜŞTERİ</div>
                <div style="font-size: 0.85rem; font-weight: 700; color: #0f172a; word-wrap: break-word;" title="@Model.Customer">@Model.Customer</div>
            </div>

            <!-- Atölye -->
            <div style="flex: 1.5; min-width: 130px; background: #fff; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); padding: 10px 14px; border: 1px solid #e2e8f0; position: relative; border-bottom: 3px solid #d946ef;">
                <div style="font-size: 0.6rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;"><i class="fa-solid fa-industry" style="color: #94a3b8;"></i> ATÖLYE</div>
                <div style="font-size: 0.85rem; font-weight: 700; color: #0f172a; word-wrap: break-word;">
                    @{
                        var atolyeInfo = GetProdVal("prod_dikim_atolyesi");
                        if (string.IsNullOrEmpty(atolyeInfo)) { atolyeInfo = Model.SewingWorkshop ?? Model.ProductionPlace; }
                        <text>@(string.IsNullOrEmpty(atolyeInfo) ? "-" : atolyeInfo)</text>
                    }
                </div>
            </div>

            <!-- Adet -->
            <div style="flex: 1; min-width: 90px; background: #fffbeb; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); padding: 10px 14px; border: 1px solid #fef3c7; position: relative; border-bottom: 3px solid #f59e0b;">
                <div style="font-size: 0.6rem; color: #b45309; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;"><i class="fa-solid fa-calculator" style="color: #fbbf24;"></i> ADET</div>
                <div id="topBadgeOrderQty" style="font-size: 0.95rem; font-weight: 800; color: #92400e;">@Model.CalculatedQuantity.ToString("N0")</div>
            </div>

            <!-- Termin & Revize -->
            <div style="flex: 1.5; min-width: 140px; background: #fff; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); padding: 10px 14px; border: 1px solid #e2e8f0; position: relative; border-bottom: 3px solid #ef4444; display: flex; flex-direction: column; justify-content: center; gap: 4px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div style="font-size: 0.6rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">TERMİN:</div>
                    <div style="font-weight: 700; color: #0f172a; font-size: 0.75rem;">@(Model.PlannedPackagingEndDate.HasValue ? Model.PlannedPackagingEndDate.Value.ToString("dd.MM.yyyy") : "-")</div>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div style="font-size: 0.6rem; color: #dc2626; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">REVİZE:</div>
                    <div style="font-weight: 700; color: #dc2626; font-size: 0.75rem;">
                        @{
                            var revizeTermin = Model.RevisedInspectionDate.HasValue 
                                ? Model.RevisedInspectionDate.Value.ToString("dd.MM.yyyy") 
                                : "";
                            
                            if (string.IsNullOrEmpty(revizeTermin))
                            {
                                var revizeTerminStr = GetProdVal("prod_knn_revize_termin");
                                if (!string.IsNullOrEmpty(revizeTerminStr))
                                {
                                    if (DateTime.TryParse(revizeTerminStr, out DateTime dtRevize))
                                    {
                                        revizeTermin = dtRevize.ToString("dd.MM.yyyy");
                                    }
                                    else if (DateTime.TryParseExact(revizeTerminStr, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime revizeTerminExact))
                                    {
                                        revizeTermin = revizeTerminExact.ToString("dd.MM.yyyy");
                                    }
                                    else
                                    {
                                        revizeTermin = revizeTerminStr;
                                    }
                                }
                            }
                            <text>@(string.IsNullOrEmpty(revizeTermin) ? "-" : revizeTermin)</text>
                        }
                    </div>
                </div>
            </div>

        </div>

        @{
            var activeTab = TempData["ActiveTab"]?.ToString() ?? ViewBag.ActiveTab?.ToString() ?? "cps";
        }

        <!-- Aşama Kartları (Gizlendi) -->
        <div class="plan-tabs" style="display: none;">
            <div id="btn-tab-cps" class="plan-tab active" onclick="switchTabUnified('cps', this)">
                <i class="fa-solid fa-table-cells"></i>
                <div class="plan-tab-title">CPS PLANLAMA EKRANI</div>
            </div>
            <div id="btn-tab-calisma" class="plan-tab" onclick="switchTabUnified('calisma', this)">
                <i class="fa-solid fa-calculator"></i>
                <div class="plan-tab-title">ÇALIŞMA SAYFASI</div>
            </div>
        </div>



    <div id="unified-content-wrapper" style="display: flex; flex-direction: column;">
        <div id="part-cps-dates" >
<form id="sample-form" style="display:none;"><input type="hidden" name="Id" value="@Model.Id" /></form>
<form id="production-form" style="display:none;"><input type="hidden" name="Id" value="@Model.Id" /></form>


<!-- YENİ KARTLI TASARIM (CPS TARİHLERİ) -->
                <style>
                    .date-card-grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
                        gap: 2px;
                        background: #94a3b8;
                        margin-bottom: 24px;
                        border: 2px solid #94a3b8;
                        border-radius: 8px;
                        overflow: hidden;
                    }
                    .date-card-grid.grid-8 {
                        grid-template-columns: repeat(8, 1fr);
                    }
                    .date-card-grid.grid-4 { grid-template-columns: repeat(4, 1fr); }
                    .date-card-grid.grid-5 { grid-template-columns: repeat(5, 1fr); }
                    .date-card-grid.grid-6 { grid-template-columns: repeat(6, 1fr); }
                    .date-card-grid.grid-7 { grid-template-columns: repeat(7, 1fr); }
                    .date-card-grid.grid-8 { grid-template-columns: repeat(8, 1fr); }
                    .date-card {
                        background: #fff;
                        border: none;
                        border-radius: 0;
                        padding: 12px 14px;
                        box-shadow: none;
                        display: flex;
                        flex-direction: column;
                        gap: 8px;
                        transition: all 0.2s;
                        position: relative;
                    }
                    .date-card:hover {
                        background: #f8fafc;
                    }
                    .date-card-header {
                        display: flex;
                        align-items: center;
                        gap: 0;
                        font-size: 0.65rem;
                        font-weight: 800;
                        text-transform: uppercase;
                        color: #475569;
                    }
                    .date-card-icon {
                        display: none !important;
                    }
                    
                    .section-divider {
                        display: flex;
                        align-items: center;
                        justify-content:center;
                        gap: 12px;
                        margin: 32px 0 16px 0;
                        font-weight: 700;
                        color: #1e293b;
                        font-size: 1.1rem;
                    }
                    .section-divider::before,
                    .section-divider::after {
                        content: '';
                        flex: 1;
                        height: 1px;
                        background: #e2e8f0;
                    }
                </style>

                <!-- KUMAŞ SÜRECİ -->
                <div class="section-divider">
                    Kumaş Süreci
                </div>
                <div class="date-card-grid grid-4">
                    <div class="date-card">
                        <div class="date-card-header">
                            <div class="date-card-icon icon-blue"><i class="fa-solid fa-industry"></i></div>
                            KUMAŞÇI
                        </div>
                        <select form="sample-form" name="sample_kumasci" class="input-field" style="width: 100%; font-size: 0.85rem; padding: 6px;">
                            <option value="">-- Seçiniz --</option>
                            @if(ViewBag.Fabricators != null) {
                                var defaultFab = GetSampleVal("sample_kumasci");
                                if (string.IsNullOrEmpty(defaultFab)) {
                                    defaultFab = Model.FabricSupplier;
                                }
                                foreach(var f in (IEnumerable<UretimPlanlama.Models.Fabricator>)ViewBag.Fabricators) {
                                    if(defaultFab == f.Name) {
                                        <option value="@f.Name" selected>@f.Name</option>
                                    } else {
                                        <option value="@f.Name">@f.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="date-card">
                        <div class="date-card-header">
                            <div class="date-card-icon icon-green"><i class="fa-solid fa-check-double"></i></div>
                            BULK KUMAŞ ONAYI
                        </div>
                        <input type="date" form="sample-form" name="sample_bulk_kumas" class="input-field" value="@GetSampleVal("sample_bulk_kumas")" />
                    </div>
                    <div class="date-card">
                        <div class="date-card-header">
                            <div class="date-card-icon icon-blue"><i class="fa-solid fa-vial"></i></div>
                            TEST / NUMUNE KUMAŞ GELİŞ
                        </div>
                        <input type="date" form="sample-form" name="sample_test_numune_kumas" class="input-field" value="@GetSampleVal("sample_test_numune_kumas")" />
                    </div>
                    <div class="date-card">
                        <div class="date-card-header">
                            <div class="date-card-icon icon-green"><i class="fa-solid fa-truck-fast"></i></div>
                            KUMAŞ SEVK (ANLAŞILAN)
                        </div>
                        <input type="date" form="sample-form" name="sample_kumas_sevk" class="input-field" value="@GetSampleVal("sample_kumas_sevk")" />
                    </div>
                </div>

                <!-- TEST SÜRECİ -->
                <div class="section-divider">
                    Test Süreci
                </div>
                <div class="date-card-grid grid-4">
                    <div class="date-card">
                        <div class="date-card-header">
                            <div class="date-card-icon icon-green"><i class="fa-solid fa-microscope"></i></div>
                            KUMAŞ ELYAF TEST ANALİZ
                        </div>
                        <input type="date" form="sample-form" name="sample_kumas_elyaf_test" class="input-field" value="@GetSampleVal("sample_kumas_elyaf_test")" />
                    </div>
                    <div class="date-card">
                        <div class="date-card-header">
                            <div class="date-card-icon icon-blue"><i class="fa-solid fa-percent"></i></div>
                            KUMAŞ KARIŞIMI
                        </div>
                        <input type="text" form="sample-form" name="sample_kumas_karisim" class="input-field" placeholder="Örn: %80 Pamuk" value="@GetSampleVal("sample_kumas_karisim")" />
                    </div>
                    <div class="date-card">
                        <div class="date-card-header">
                            <div class="date-card-icon icon-green"><i class="fa-solid fa-check"></i></div>
                            GS ONAY
                        </div>
                        <input type="date" form="sample-form" name="sample_gs_onay" class="input-field" value="@GetSampleVal("sample_gs_onay")" />
                    </div>
