                                                            if (gelenMiktarEl && gelenCikacakEl && bedenMetrajEl && gelenMetrajEl) {
                                                                var gelenMetraj = typeof parseTurkishFloat === 'function' ? parseTurkishFloat(gelenMetrajEl.value || "1") : parseFloat((gelenMetrajEl.value || "1").replace(',', '.'));
                                                                var gelenMiktar = typeof parseTurkishFloat === 'function' ? parseTurkishFloat(gelenMiktarEl.value || "0") : parseFloat((gelenMiktarEl.value || "0").replace(',', '.'));
                                                                if (gelenMetraj > 0) {
                                                                    gelenCikacakEl.value = Math.round(gelenMiktar / gelenMetraj).toLocaleString('tr-TR');
                                                                } else {
                                                                    gelenCikacakEl.value = "0";
                                                                }
                                                                if (typeof updateGlobalTargetsUI === 'function') updateGlobalTargetsUI();
                                                            }
                                                        });
                                                        originalCalculateMRP();
                                                    };
                                                }
                                            });
