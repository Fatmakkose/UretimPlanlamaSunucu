@model List<UretimPlanlama.Models.Order>
@{
    ViewData["Title"] = "Üretim Takip";
    var workshops = ViewBag.Workshops as List<UretimPlanlama.Models.Workshop>;
    var fabricators = ViewBag.Fabricators as List<UretimPlanlama.Models.Fabricator>;
}

@functions {
    string RenderDateCompare(DateTime? planned, DateTime? actual, string stageName = "")
    {
        var plannedStr = planned.HasValue ? planned.Value.ToString("dd.MM.yyyy") : "-";
        var actualStr = actual.HasValue ? actual.Value.ToString("dd.MM.yyyy") : "-";
        
        var badgeClass = "stage-waiting";
        var statusIcon = "<i class='fa-regular fa-clock'></i>";
        var delayHtml = "";

        if (planned.HasValue && actual.HasValue)
        {
            var diff = (actual.Value.Date - planned.Value.Date).Days;
            if (diff > 0)
            {
                badgeClass = "stage-danger";
                statusIcon = "<i class='fa-solid fa-circle-exclamation'></i>";
                delayHtml = $"<div style='color:var(--danger-text); font-weight:600; font-size:0.75rem; margin-top:2px;'><i class='fa-solid fa-triangle-exclamation'></i> {diff}g gecikme</div>";
            }
            else
            {
                badgeClass = "stage-success";
                statusIcon = "<i class='fa-solid fa-circle-check'></i>";
                delayHtml = $"<div style='color:var(--success-text); font-weight:600; font-size:0.75rem; margin-top:2px;'><i class='fa-solid fa-circle-check'></i> Zamanında</div>";
            }
        }
        else if (planned.HasValue)
        {
            if (DateTime.Today > planned.Value.Date)
            {
                var diff = (DateTime.Today - planned.Value.Date).Days;
                badgeClass = "stage-danger";
                statusIcon = "<i class='fa-solid fa-triangle-exclamation'></i>";
                delayHtml = $"<div style='color:var(--danger-text); font-weight:600; font-size:0.75rem; margin-top:2px;'><i class='fa-solid fa-clock'></i> {diff}g gecikme</div>";
            }
            else
            {
                badgeClass = "stage-active";
                statusIcon = "<i class='fa-solid fa-spinner fa-spin' style='animation-duration: 3s;'></i>";
                delayHtml = "<div style='color:#0284c7; font-weight:500; font-size:0.75rem; margin-top:2px;'>İşlem Bekleniyor</div>";
            }
        }
        else if (actual.HasValue)
        {
            badgeClass = "stage-success";
            statusIcon = "<i class='fa-solid fa-circle-check'></i>";
            delayHtml = "<div style='color:var(--success-text); font-weight:500; font-size:0.75rem; margin-top:2px;'>Tamamlandı</div>";
        }

        var html = $"<div class='stage-badge {badgeClass}'>";
        html += $"{statusIcon} <span style='font-size:0.8rem;'>{actualStr}</span>";
        html += "</div>";
        html += $"<div class='date-row'><span class='date-label'>Plan:</span><span class='date-val'>{plannedStr}</span></div>";
        html += delayHtml;

        return html;
    }

    string RenderStageStatus(DateTime? planStart, DateTime? actStart, DateTime? planEnd, DateTime? actEnd, string startTitle = "Başlangıç", string endTitle = "Bitiş")
    {
        var startStr = actStart.HasValue ? actStart.Value.ToString("dd.MM.yyyy") : "-";
        var endStr = actEnd.HasValue ? actEnd.Value.ToString("dd.MM.yyyy") : "-";
        var planStartStr = planStart.HasValue ? planStart.Value.ToString("dd.MM.yyyy") : "-";
        var planEndStr = planEnd.HasValue ? planEnd.Value.ToString("dd.MM.yyyy") : "-";

        var startBadgeClass = actStart.HasValue ? "stage-success" : "stage-waiting";
        var endBadgeClass = actEnd.HasValue ? "stage-success" : "stage-waiting";
        
        if (!actStart.HasValue && planStart.HasValue && DateTime.Today > planStart.Value.Date)
        {
            startBadgeClass = "stage-danger";
        }
        if (!actEnd.HasValue && planEnd.HasValue && DateTime.Today > planEnd.Value.Date)
        {
            endBadgeClass = "stage-danger";
        }

        // Gecikme durumunu hesapla
        var delayText = "";
        var delayColor = "";
        
        if (actEnd.HasValue && planEnd.HasValue)
        {
            var diff = (actEnd.Value.Date - planEnd.Value.Date).Days;
            if (diff > 0)
            {
                delayText = $"{diff}g gecikme";
                delayColor = "var(--danger-text)";
            }
            else
            {
                delayText = "Zamanında";
                delayColor = "var(--success-text)";
            }
        }
        else if (actStart.HasValue && planStart.HasValue && !actEnd.HasValue && planEnd.HasValue)
        {
            // Başladı ancak sonlanmadı (devam ediyor)
            if (DateTime.Today > planEnd.Value.Date)
            {
                var diff = (DateTime.Today - planEnd.Value.Date).Days;
                delayText = $"{diff}g gecikme (Devam Ediyor)";
                delayColor = "var(--danger-text)";
            }
            else
            {
                delayText = "Devam Ediyor";
                delayColor = "#0284c7";
            }
        }
        else if (!actStart.HasValue && planStart.HasValue)
        {
            // Henüz başlamadı
            if (DateTime.Today > planStart.Value.Date)
            {
                var diff = (DateTime.Today - planStart.Value.Date).Days;
                delayText = $"{diff}g gecikme (Başlamadı)";
                delayColor = "var(--danger-text)";
            }
            else
            {
                delayText = "Bekliyor";
                delayColor = "#64748b";
            }
        }

        var html = "<div style='display:flex; flex-direction:column; gap:6px;'>";
        
        // Tarih Satırı
        
        html += "<div style='display:flex; align-items:center; gap:8px;'>";
        var startIcon = startTitle == "Paket Bitiş" ? "<i class='fa-solid fa-box-open'></i>" : "▶";
        var endIcon = endTitle == "Inspection" ? "<i class='fa-solid fa-magnifying-glass-chart'></i>" : "⚑";
        
        html += $"<div class='stage-badge {startBadgeClass}' title='{startTitle}' style='padding: 3px 6px; font-size: 0.75rem; min-width: 80px; justify-content: center;'>{startIcon} {startStr}</div>";
        html += "<span style='color: var(--text-muted); font-size: 0.8rem;'>➔</span>";
        html += $"<div class='stage-badge {endBadgeClass}' title='{endTitle}' style='padding: 3px 6px; font-size: 0.75rem; min-width: 80px; justify-content: center;'>{endIcon} {endStr}</div>";
        html += "</div>";
        
        html += $"<div style='font-size:0.72rem; color: var(--text-muted); margin-top:2px;'>";
        html += $"Plan: <span style='color: var(--text-main); font-weight: 500;'>{planStartStr} - {planEndStr}</span>";
        html += "</div>";

        if (!string.IsNullOrEmpty(delayText))
        {
            var statusIcon = delayColor.Contains("danger") ? "<i class='fa-solid fa-triangle-exclamation'></i> " : "";
            if (delayText == "Zamanında") statusIcon = "<i class='fa-solid fa-circle-check'></i> ";
            html += $"<div style='color:{delayColor}; font-weight:600; font-size:0.75rem;'>{statusIcon}{delayText}</div>";
        }
        
        html += "</div>";
        return html;
    }
}

<style>
