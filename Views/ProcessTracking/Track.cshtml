            '        .sign-box { width: 220px; border-top: 1px solid #334155; text-align: center; padding-top: 10px; font-weight: 600; }' +
            '    </style>' +
            '<' + '/head>' +
            '<' + 'body>' +
            '    <div class="header">' +
            '        <h2>KNN DEPO - MALZEME ÇIKIŞ FİŞİ</h2>' +
            '    </div>' +
            '    <div class="info-box">' +
            '        <div>' +
            '            <strong>Sipariş No:</strong> @Model.OrderCode <br/>' +
            '            <strong>Model:</strong> @Model.ModelName <br/>' +
            '            <strong>Renk:</strong> @Model.Color <br/>' +
            '            <strong>Atölye:</strong> @(string.IsNullOrEmpty(GetProdVal("prod_dikim_atolyesi")) ? (Model.SewingWorkshop ?? Model.ProductionPlace ?? "-") : GetProdVal("prod_dikim_atolyesi"))' +
            '        </div>' +
            '        <div style="text-align: right;">' +
