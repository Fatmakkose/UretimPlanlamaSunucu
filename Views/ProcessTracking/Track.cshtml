            '    </div>' +
            '    <table>' +
            '        <thead>' +
            '            <tr>' +
            '                <th>Malzeme / Stok Adı</th>' +
            '                <th class="right" style="width: 150px;">Çıkan Miktar</th>' +
            '            </tr>' +
            '        </thead>' +
            '        <tbody>';
            
            var itemsFound = false;

            function parseTrNum(str) {
                if(!str) return 0;
                str = str.trim().replace(/\./g, '').replace(',', '.');
                return parseFloat(str) || 0;
            }
            
            function formatTrNum(num) {
                return num.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            $('#worksheetTable tbody tr').each(function() {
                if ($(this).find('td').length < 4) return;
                
                var matName = $(this).find('td:eq(0)').text().trim();
