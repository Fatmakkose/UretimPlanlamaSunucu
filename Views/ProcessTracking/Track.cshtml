        function _addCutToGlobalAndRender(cutType, date, multiplier, sizes, totalQty, markerLength, unitMeterage) {
            const newCutName = "Kesim " + (cuttingItems.length + 1);

            cuttingItems.push({
                CutName: newCutName,
                CutType: cutType,
                Date: date,
                Multiplier: multiplier,
                Sizes: sizes,
                TotalQuantity: totalQty,
                MarkerLength: markerLength,
                UnitMeterage: unitMeterage,
                Status: 'Completed'
            });

            renderCuttingTable();
        }

        function _updateCutInGlobalAndRender(index, cutType, date, multiplier, sizes, totalQty, markerLength, unitMeterage) {
            cuttingItems[index].CutType = cutType;
            cuttingItems[index].Date = date;
            cuttingItems[index].Multiplier = multiplier;
            cuttingItems[index].Sizes = sizes;
            cuttingItems[index].TotalQuantity = totalQty;
            cuttingItems[index].MarkerLength = markerLength;
            cuttingItems[index].UnitMeterage = unitMeterage;
            cuttingItems[index].Status = 'Completed';

            renderCuttingTable();
            currentEditIndex = -1;
        }

        // removeCuttingItem moved below

        function getPlannedTotalForSize(sizeName, cutType) {
            let total = 0;
            plannedCuttingItems.forEach(item => {
                if (item.CutType === cutType && item.Sizes && item.Sizes[sizeName]) {
                    total += parseFloat(item.Sizes[sizeName]) || 0;
                }
            });
            return total;
        }

        function openComparisonReport(type) {
            let cutTypeFilter = type === 'AcikAdet' ? 'Açık Adet' : 'Asorti';
            let html = `
                <table class="table table-bordered text-center">
                    <thead style="background: #f8fafc;">
                        <tr>
                            <th>Kesim Adı</th>
                            <th>Planlanan Kesim</th>
                            <th>Gerçekleşen Kesim</th>
                            <th>Fark</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
            `;
            
            let grandPlanned = 0;
            let grandCut = 0;

            (plannedCuttingItems || []).forEach((pItem, idx) => {
                let currentCutType = pItem.CutType || 'Açık Adet';
                let isAsorti = currentCutType === 'Asorti';
                let matchesType = (type === 'Asorti' && isAsorti) || (type === 'AcikAdet' && !isAsorti);
                
                if (matchesType) {
                    let cutName = pItem.CutName || ('Kesim ' + (idx + 1));
                    let planned = parseFloat(pItem.TotalQuantity) || 0;
                    
                    let actualItem = cuttingItems.find(a => a && a.PlannedCutIndex === idx);
                    let cut = actualItem ? (parseFloat(actualItem.TotalQuantity) || 0) : 0;
                    let diff = cut - planned;
                    
                    grandPlanned += planned;
                    if (actualItem) {
                        grandCut += cut;
                    }

                    let statusText = "";
                    let statusColor = "";
                    if (!actualItem) {
                        statusText = "Bekliyor";
                        statusColor = "#94a3b8";
                    } else if (diff === 0) {
                        statusText = "Tamamlandı";
                        statusColor = "#10b981";
                    } else if (diff > 0) {
                        statusText = "Fazla Kesim";
                        statusColor = "#f59e0b";
                    } else {
                        statusText = "Eksik Kesim";
                        statusColor = "#ef4444";
                    }

                    html += `
                        <tr>
                            <td style="font-weight: bold; color: #1e293b;">${cutName}</td>
                            <td>${planned}</td>
                            <td style="font-weight: bold;">${actualItem ? cut : '-'}</td>
                            <td style="color: ${statusColor}; font-weight: bold;">${actualItem ? (diff > 0 ? '+' : '') + diff : '-'}</td>
                            <td style="color: ${statusColor};"><i class="fa-solid fa-circle" style="font-size: 0.6rem; margin-right: 4px; vertical-align: middle;"></i>${statusText}</td>
                        </tr>
                    `;
                }
            });

            if (grandPlanned === 0) {
                html += `<tr><td colspan="5" style="color: #64748b; font-style: italic;">Henüz ${cutTypeFilter} planlaması bulunmuyor.</td></tr>`;
            }

            html += `
                    </tbody>
                    <tfoot style="background: #f1f5f9; font-weight: bold;">
                        <tr>
                            <td style="text-align: right;">TOPLAM</td>
                            <td>${grandPlanned}</td>
                            <td>${grandCut}</td>
                            <td style="color: ${grandCut - grandPlanned > 0 ? '#f59e0b' : (grandCut - grandPlanned < 0 ? '#ef4444' : '#10b981')};">${grandCut - grandPlanned > 0 ? '+' : ''}${grandCut - grandPlanned}</td>
                            <td>-</td>
                        </tr>
                    </tfoot>
                </table>
            `;

            $('#compModalTitle').text(type === 'AcikAdet' ? 'Açık Adet Kesim Analizi' : 'Asorti Kesim Analizi');
            $('#compModalContent').html(html);

            var modal = document.getElementById('kesimComparisonModal');
            modal.style.display = 'flex';
            modal.firstElementChild.style.transform = 'scale(0.95)';
            modal.firstElementChild.style.opacity = '0';
            setTimeout(() => {
                modal.firstElementChild.style.transform = 'scale(1)';
                modal.firstElementChild.style.opacity = '1';
            }, 10);
        }


            
        var currentEditPlannedIndex = -1;
        var currentEditIndex = -1;

        function approvePlannedCut(plannedIndex) {
            let pItem = plannedCuttingItems[plannedIndex];
            if (pItem) {
                let newActual = JSON.parse(JSON.stringify(pItem));
                newActual.Status = 'Completed';
                newActual.PlannedCutIndex = plannedIndex;
                newActual.Date = new Date().toISOString().split('T')[0];
                cuttingItems.push(newActual);
                saveCutting();
                renderCuttingTable();
            }
        }

        function editCuttingItem(actualIndex, type, isPending, plannedIndex) {
            if (isPending) {
                currentEditIndex = -1;
                currentEditPlannedIndex = plannedIndex;
            } else {
                currentEditIndex = actualIndex;
                currentEditPlannedIndex = -1;
            }
            renderCuttingTable();
        }

        function cancelEdit() {
            currentEditIndex = -1;
            currentEditPlannedIndex = -1;
            renderCuttingTable();
        }

        function removeCuttingItem(actualIndex) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: 'Bu kesim kaydı silinecektir!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Evet, Sil',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    cuttingItems.splice(actualIndex, 1);
                    saveCutting();
                    renderCuttingTable();
                }
            });
        }

        function saveEditAcik(actualIndex) {
            let multiplier = parseFloat($('#editMultiplier').val()) || 1;
            let date = $('#editDate').val();
            let total = parseFloat($('#editTotal').val()) || 0;
            
            let sizes = {};
            $('.edit-acik-input').each(function() {
                let s = $(this).data('size');
                let v = parseFloat($(this).val()) || 0;
                sizes[s] = v * multiplier;
            });
            
            if (actualIndex === -1 && currentEditPlannedIndex !== -1) {
                let pItem = plannedCuttingItems[currentEditPlannedIndex];
                let item = {
                    CutName: pItem.CutName,
                    CutType: 'AcikAdet',
                    Multiplier: multiplier,
                    Sizes: sizes,
                    TotalQuantity: total,
                    Date: date,
                    Status: 'Completed',
                    PlannedCutIndex: currentEditPlannedIndex
                };
                cuttingItems.push(item);
            } else {
                let item = cuttingItems[actualIndex];
                item.Multiplier = multiplier;
                item.Sizes = sizes;
                item.TotalQuantity = total;
                item.Date = date;
            }
            
            cancelEdit();
            saveCutting();
        }

        function saveEditAsorti(actualIndex) {
            let multiplier = parseFloat($('#editMultiplier').val()) || 1;
            let date = $('#editDate').val();
            let total = parseFloat($('#editTotal').val()) || 0;
            
            let sizes = {};
            $('.edit-asorti-input').each(function() {
                let s = $(this).data('size');
                let v = parseFloat($(this).data('asortivalue')) || 0;
                sizes[s] = v * multiplier;
            });
            
            if (actualIndex === -1 && currentEditPlannedIndex !== -1) {
                let pItem = plannedCuttingItems[currentEditPlannedIndex];
                let item = {
                    CutName: pItem.CutName,
                    CutType: 'Asorti',
                    Multiplier: multiplier,
                    Sizes: sizes,
                    TotalQuantity: total,
                    Date: date,
                    Status: 'Completed',
                    PlannedCutIndex: currentEditPlannedIndex
                };
                cuttingItems.push(item);
            } else {
                let item = cuttingItems[actualIndex];
                item.Multiplier = multiplier;
                item.Sizes = sizes;
                item.TotalQuantity = total;
                item.Date = date;
            }
            
            cancelEdit();
            saveCutting();
        }

        function renderCuttingTable() {
            let htmlAcik = '';
            let htmlAsorti = '';
            let acikTotal = 0;
            let asortiTotal = 0;
            let grandTotal = 0;
            
            let renderList = [];
            
            (plannedCuttingItems || []).forEach((p, idx) => {
                let matchIdx = cuttingItems.findIndex(a => a && a.PlannedCutIndex === idx);
                if (matchIdx !== -1) {
                    renderList.push({ pItem: p, aItem: cuttingItems[matchIdx], isPending: false, actualIndex: matchIdx, plannedIndex: idx });
                } else {
                    renderList.push({ pItem: p, aItem: null, isPending: true, actualIndex: -1, plannedIndex: idx });
                }
            });
            
            // Manual cuts (PlannedCutIndex === undefined) are no longer rendered

            renderList.forEach(entry => {
                let pItem = entry.pItem;
                let aItem = entry.aItem;
                let isPending = entry.isPending;
                let actualIndex = entry.actualIndex;
                let plannedIndex = entry.plannedIndex;
                
                let itemToRender = aItem || pItem;
                
                let cutName = itemToRender.CutName || `Manuel Kayıt`;
                let cutTypeLabel = itemToRender.CutType || 'Açık Adet';
                let isAsorti = cutTypeLabel === 'Asorti';
                let sizesArr = isAsorti ? Object.keys(targetSizesAsorti) : Object.keys(targetSizes);
                
                let qty = parseFloat(itemToRender.TotalQuantity) || 0;
                if (!isPending) {
                    if (isAsorti) asortiTotal += qty;
                    else acikTotal += qty;
                    grandTotal += qty;
                }
                
                let sizesHtml = '';
                if (sizesArr && sizesArr.length > 0) {
                    sizesArr.forEach(s => {
                        let val = itemToRender.Sizes && itemToRender.Sizes[s] ? parseFloat(itemToRender.Sizes[s]) : 0;
                        let displayVal = val;
                        if (itemToRender.Multiplier && itemToRender.Multiplier > 0) {
                            displayVal = val / itemToRender.Multiplier;
                        }
                        if (displayVal % 1 !== 0) displayVal = displayVal.toFixed(2);
                        sizesHtml += `<td style="text-align: center; color: #334155; vertical-align: middle;">${displayVal}</td>`;
                    });
                } else {
                    sizesHtml = `<td style="text-align: center; vertical-align: middle;">-</td>`;
                }

                let rowHtml = '';
                let isEditingThis = (isPending && currentEditPlannedIndex === plannedIndex) || (!isPending && currentEditIndex === actualIndex);

                if (isEditingThis) {
                    let editSizesHtml = '';
                    if (sizesArr && sizesArr.length > 0) {
                        sizesArr.forEach(s => {
                            let val = itemToRender.Sizes && itemToRender.Sizes[s] ? parseFloat(itemToRender.Sizes[s]) : 0;
                            let displayVal = val;
                            if (itemToRender.Multiplier && itemToRender.Multiplier > 0) {
                                displayVal = val / itemToRender.Multiplier;
                            }
                            if (isAsorti) {
                                editSizesHtml += `<td style="text-align: center; vertical-align: middle;"><input type="number" id="editSize_${s}" class="form-control form-control-sm edit-asorti-input input-field" data-size="${s}" data-asortivalue="${targetSizesAsorti[s] || 0}" value="${targetSizesAsorti[s] || 0}" readonly style="text-align: center; background: #e2e8f0; cursor: not-allowed;" /></td>`;
                            } else {
                                editSizesHtml += `<td style="text-align: center; vertical-align: middle;"><input type="number" id="editSize_${s}" class="form-control form-control-sm edit-acik-input input-field" data-size="${s}" value="${displayVal}" oninput="calculateEdit()" style="text-align: center;" /></td>`;
                            }
                        });
                    } else {
                        editSizesHtml = `<td style="text-align: center; vertical-align: middle;">-</td>`;
                    }

                    rowHtml = `
                        <tr style="background: #fffbeb;">
                            <td class="sticky-kesim" style="font-weight: 700; color: #1e293b; text-align: center; vertical-align: middle; position: sticky; left: 0; background: #fffbeb; z-index: 2;">${cutName} <span style="font-size:0.7rem; color:#b45309; display:block;">(Düzenleniyor)</span></td>
                            <td style="text-align: center; vertical-align: middle;"><input type="number" id="editMultiplier" class="form-control form-control-sm input-field" value="${itemToRender.Multiplier || 1}" oninput="${isAsorti ? 'calculateEditAsorti()' : 'calculateEdit()'}" style="text-align: center;" /></td>
                            ${editSizesHtml}
                            <td style="text-align: center; vertical-align: middle;"><input type="number" id="editTotal" class="form-control form-control-sm input-field" value="${qty}" readonly style="text-align: center; background: #e2e8f0;" /></td>
                            <td style="text-align: center; vertical-align: middle;"><input type="date" id="editDate" class="form-control form-control-sm input-field" value="${itemToRender.Date || ''}" style="text-align: center;" /></td>
                            <td class="sticky-islem" style="text-align: center; vertical-align: middle; position: sticky; right: 0; background: #fffbeb; z-index: 2;">
                                <button class="btn btn-sm btn-success" onclick="${isAsorti ? 'saveEditAsorti(' + actualIndex + ')' : 'saveEditAcik(' + actualIndex + ')'}" title="Kaydet" style="padding: 2px 8px; border-radius: 4px;"><i class="fa-solid fa-check"></i></button>
                                <button class="btn btn-sm btn-secondary" onclick="cancelEdit()" title="İptal" style="padding: 2px 8px; border-radius: 4px;"><i class="fa-solid fa-xmark"></i></button>
                            </td>
                        </tr>
                    `;
                } else {
                    let actionHtml = '';
                    let statusLabel = '';
                    let rowStyle = '';
                    
                    if (isPending) {
                        rowStyle = "background: #f8fafc; opacity: 0.8; border-bottom: 1px dashed #cbd5e1;";
                        statusLabel = `<span style="font-size: 0.7rem; color: #f59e0b; display: block; font-weight: 700;">PLANLANDI - BEKLİYOR</span>`;
                        actionHtml = `
                            <button class="btn btn-sm" onclick="approvePlannedCut(${plannedIndex})" style="background: #10b981; color: white; padding: 4px 8px; font-size: 0.75rem; border-radius: 4px; font-weight: 600;" title="Birebir Gerçekleşti"><i class="fa-solid fa-check"></i> Onayla</button>
                            <button class="btn btn-sm btn-outline-primary" onclick="editCuttingItem(-1, '${cutTypeLabel === 'Asorti' ? 'Asorti' : 'AcikAdet'}', true, ${plannedIndex})" title="Değişiklik Yap ve Onayla" style="padding: 4px 8px; font-size: 0.75rem; border-radius: 4px;"><i class="fa-solid fa-pen-to-square"></i></button>
                        `;
                    } else {
                        rowStyle = "background: white;";
                        statusLabel = plannedIndex !== -1 ? `<span style="font-size: 0.7rem; color: #16a34a; display: block; font-weight: 700;"><i class="fa-solid fa-circle-check"></i> GERÇEKLEŞTİ</span>` : `<span style="font-size: 0.7rem; color: #3b82f6; display: block; font-weight: 700;"><i class="fa-solid fa-info-circle"></i> MANUEL KAYIT</span>`;
                        actionHtml = `
                            <button class="btn btn-sm btn-outline-primary" onclick="editCuttingItem(${actualIndex}, '${cutTypeLabel === 'Asorti' ? 'Asorti' : 'AcikAdet'}', false, -1)" title="Düzenle" style="padding: 4px 8px; font-size: 0.75rem; border-radius: 4px;"><i class="fa-solid fa-pen-to-square"></i></button>
                            <button class="btn btn-sm btn-outline-danger" onclick="removeCuttingItem(${actualIndex})" title="Sil" style="padding: 4px 8px; font-size: 0.75rem; border-radius: 4px;"><i class="fa-solid fa-trash"></i></button>
                        `;
                    }

                    rowHtml = `
                        <tr class="hover-row" style="${rowStyle}">
                            <td class="sticky-kesim" style="font-weight: 700; color: #1e293b; text-align: center; vertical-align: middle; position: sticky; left: 0; background: inherit; z-index: 2;">${cutName} ${statusLabel}</td>
                            <td style="text-align: center; color: #334155; vertical-align: middle;">${itemToRender.Multiplier || 1}</td>
                            ${sizesHtml}
                            <td style="text-align: center; font-weight: 700; color: #0f172a; font-size: 1.05rem; vertical-align: middle;">${qty}</td>
                            <td style="text-align: center; color: #475569; font-size: 0.85rem; vertical-align: middle;">${itemToRender.Date || '-'}</td>
                            <td class="sticky-islem" style="text-align: center; vertical-align: middle; position: sticky; right: 0; background: inherit; z-index: 2;">
                                <div style="display: flex; gap: 4px; justify-content: center;">
                                    ${actionHtml}
                                </div>
                            </td>
                        </tr>
                    `;
                }

                if (isAsorti) {
                    htmlAsorti += rowHtml;
                } else {
                    htmlAcik += rowHtml;
                }
            });
            
            $('#cuttingBodyAcik').html(htmlAcik);
            $('#acikTotalCut').text(acikTotal.toLocaleString('tr-TR'));
            
            $('#cuttingBodyAsorti').html(htmlAsorti);
            $('#asortiTotalCut').text(asortiTotal.toLocaleString('tr-TR'));
            
            $('#grandTotalCut').text(grandTotal.toLocaleString('tr-TR'));
        }

        function markCutAsCompleted(index) {
            if (cuttingItems[index]) {
                cuttingItems[index].Status = 'Completed';
                renderCuttingTable();
            }
        }

        function saveCutting() {
            $.ajax({
                url: '/ProcessTracking/UpdateCuttingProcess',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ Id: orderId, CuttingProcessJson: JSON.stringify(cuttingItems) }),
                success: function(res) {
                    if(res.success) showToast("Günlük kesim bilgileri kaydedildi.", "success");
                    else showToast("Hata: " + res.message, "danger");
                }
            });
        }

        function finishCutting() {
            Swal.fire({
                title: 'Emin misiniz?',
                text: 'Kesim süreci tamamen bitirilecek ve takvime işlenecektir. Onaylıyor musunuz?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0284c7',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Evet, Bitir',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/ProcessTracking/UpdateCuttingProcess',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ Id: orderId, CuttingProcessJson: JSON.stringify(cuttingItems) }),
                        success: function(res) {
                            if(res.success) {
                                $.post('/ProcessTracking/MarkTimelineCompleted', { orderId: orderId, key: 'prod_kesim_bitis', type: 'prod' }, function(tlRes) {
                                    if(tlRes.success) {
                                        showToast("Kesim süreci başarıyla bitirildi ve takvime işlendi.", "success");
                                        setTimeout(function() { 
                                            window.location.hash = "timeline";
                                            location.reload(); 
                                        }, 1000);
                                    }
                                });
                            } else {
                                showToast("Hata: " + res.message, "danger");
                            }
                        }
                    });
                }
            });
        }

        function showToast(message, type) {
            $("#floatingToast").remove();
            var bgColor = type === "success" ? "#d1fae5" : "#fee2e2";
            var textColor = type === "success" ? "#065f46" : "#991b1b";
            var borderClr = type === "success" ? "rgba(52, 211, 153, 0.4)" : "rgba(248, 113, 113, 0.4)";
            var icon = type === "success" ? "fa-solid fa-circle-check" : "fa-solid fa-circle-exclamation";
            var toast = $('<div id="floatingToast" style="position: fixed; top: 20px; right: 20px; background-color: ' + bgColor + '; color: ' + textColor + '; border: 1px solid ' + borderClr + '; padding: 16px 24px; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); z-index: 9999; display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 0.95rem; min-width: 300px; transition: opacity 0.5s;">' +
                '<i class="' + icon + '" style="font-size: 1.2rem;"></i>' +
                '<span>' + message + '</span>' +
                '</div>');
            $("body").append(toast);
            setTimeout(function () {
                toast.css('opacity', '0');
                setTimeout(function () { toast.remove(); }, 500);
            }, 3000);
        }

        function processSevkExit() {
            $.ajax({
                url: '/ProcessTracking/ProcessSevkOnayStockExit',
                type: 'POST',
                data: { orderId: orderId },
                success: function(res) {
                    if (res.success) {
                        showToast(res.message, "success");
                        setTimeout(function() {
                            switchTab('timeline');
                            location.reload(); 
                        }, 1500);
                    } else {
                        showToast("Hata: " + res.message, "danger");
                    }
                },
                error: function() {
                    showToast("İşlem sırasında bir hata oluştu.", "danger");
                }
            });
        }

        function printDispatchSlip() {
            var dateStr = new Date().toLocaleDateString('tr-TR');
            var timeStr = new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
            
            var printHtml = '<!DOCTYPE html>' +
            '<' + 'html>' +
            '<' + 'head>' +
            '    <title>Malzeme Çıkış Fişi</title>' +
            '    <style>' +
            '        body { font-family: "Segoe UI", Arial, sans-serif; padding: 40px; color: #1e293b; }' +
