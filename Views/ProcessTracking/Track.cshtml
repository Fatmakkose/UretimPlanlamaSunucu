        }
function printSection(section) {
    var printAsorti = document.getElementById('printAsortiArea');
    var printAcik = document.getElementById('printAcikAdetArea');
    
    var origAsorti = printAsorti.style.display;
    var origAcik = printAcik.style.display;
    
    if (section === 'asorti') {
        printAcik.style.display = 'none';
    } else if (section === 'acik') {
        printAsorti.style.display = 'none';
    }
    
    // Geçici olarak media print style
    var style = document.createElement('style');
    style.innerHTML = '@@media print { .no-print, .btn, .nav-link, .color-tabs, .sidebar, .main-header, .header-container { display: none !important; } }';
    document.head.appendChild(style);
    
    window.print();
    
    printAsorti.style.display = origAsorti;
    printAcik.style.display = origAcik;
    document.head.removeChild(style);
}

function toggleMergeSelection(el) {
    if (el.classList.contains('selected-cell')) {
        el.classList.remove('selected-cell');
    } else {
        el.classList.add('selected-cell');
    }
}

function mergeSelectedCells() {
    var selected = Array.from(document.querySelectorAll('.selected-cell'));
    if (selected.length < 2) {
        Swal.fire({ icon: 'warning', title: 'Uyarı', text: 'Lütfen birleştirmek için aynı sütundan en az iki hücre seçin.', confirmButtonColor: '#f59e0b' });
        return;
    }
    
    // Sort by DOM order (row index)
    selected.sort(function(a, b) {
        return a.closest('tr').rowIndex - b.closest('tr').rowIndex;
    });

    var first = selected[0];
    var colId = first.getAttribute('data-col');
    
    // Check if they are all in the same column
    for (var i = 1; i < selected.length; i++) {
        if (selected[i].getAttribute('data-col') !== colId) {
            Swal.fire({ icon: 'warning', title: 'Uyarı', text: 'Lütfen aynı sütundaki hücreleri seçin.', confirmButtonColor: '#f59e0b' });
            return;
        }
    }
    
    var totalRowspan = 0;
    
    for (var i = 0; i < selected.length; i++) {
        var cell = selected[i];
        var rSpan = parseInt(cell.getAttribute('rowspan')) || 1;
        totalRowspan += rSpan;
        
        if (i > 0) {
            cell.style.display = 'none';
        }
        cell.classList.remove('selected-cell');
    }
    
    first.setAttribute('rowspan', totalRowspan);
}

function unmergeSelectedCells() {
    var selected = document.querySelectorAll('.selected-cell');
    if (selected.length === 0) {
        Swal.fire({ icon: 'warning', title: 'Uyarı', text: 'Lütfen ayırmak için daha önce birleştirilmiş bir hücreyi seçin.', confirmButtonColor: '#f59e0b' });
        return;
    }
    
    for(var k = 0; k < selected.length; k++) {
        var first = selected[k];
        var rowspan = parseInt(first.getAttribute('rowspan')) || 1;
        
        if (rowspan > 1) {
            first.setAttribute('rowspan', 1);
            var colIdx = first.getAttribute('data-col');
            
            var tr = first.closest('tr');
            for (var i = 1; i < rowspan; i++) {
                tr = tr.nextElementSibling;
                if (tr) {
                    var hiddenCell = tr.querySelector('.mergeable-cell[data-col="' + colIdx + '"]');
                    if (hiddenCell) {
                        hiddenCell.style.display = '';
                        hiddenCell.setAttribute('rowspan', 1);
                    }
                }
            }
        }
        first.classList.remove('selected-cell');
    }
}
