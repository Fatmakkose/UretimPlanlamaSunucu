            <!-- ASORTİ KESİM TABLOSU -->
            <div style="margin-bottom: 25px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: 32px; margin-bottom: 12px; flex-wrap: wrap; gap: 12px;">
                    <div>
                        <h5 style="margin: 0 0 8px 0; color: #1e293b; font-weight: 700; font-size: 1.1rem;"><i class="fa-solid fa-layer-group" style="margin-right: 8px; color: #3b82f6;"></i>Asorti Kesim Takibi</h5>
