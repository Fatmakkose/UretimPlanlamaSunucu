                        <td style="vertical-align: middle; text-align: center;">
                            <div style="display: flex; gap: 4px; justify-content: center;">
                                <button class="btn btn-success btn-sm" onclick="saveAcikRow()" title="Kaydet"><i class="fa-solid fa-check"></i></button>
