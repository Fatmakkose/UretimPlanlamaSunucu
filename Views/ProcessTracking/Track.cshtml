            '        h2 { margin: 0 0 5px 0; font-size: 24px; }' +
            '        .sub-header { font-size: 16px; color: #475569; }' +
            '        .info-box { display: flex; justify-content: space-between; margin-bottom: 20px; font-size: 15px; padding: 15px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; }' +
            '        table { width: 100%; border-collapse: collapse; margin-top: 10px; }' +
