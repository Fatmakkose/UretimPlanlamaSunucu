                    <div style="font-size: 0.85rem; color: #15803d; display: flex; flex-wrap: wrap; align-items: center;">
                        <strong style="margin-right: 8px;"><i class="fa-solid fa-layer-group" style="margin-right: 4px;"></i> Sipariş Asorti Dağılımı:</strong>
                        @if (asortiObj.Any()) {
                            foreach(var kvp in asortiObj) {
                                <span style="display: inline-block; background: #dcfce7; padding: 2px 8px; border-radius: 12px; margin-right: 6px; font-weight: 600; border: 1px solid #bbf7d0;">@kvp.Key: @kvp.Value</span>
                            }
