                                <button class="btn btn-success btn-sm" onclick="saveAsortiRow()" title="Kaydet"><i class="fa-solid fa-check"></i></button>
                                <button class="btn btn-secondary btn-sm" onclick="$('#cuttingEntryAsorti').hide();" title="İptal"><i class="fa-solid fa-xmark"></i></button>
