        <!-- KESİM SÜRECİ BÖLÜMÜ (ÇALIŞMA SAYFASINA DAHİL EDİLDİ) -->
            @{
                var sizesObj = new Dictionary<string, string>();
                if (!string.IsNullOrEmpty(Model.SizeDistributionJson)) {
                    try { 
                        using (var doc = System.Text.Json.JsonDocument.Parse(Model.SizeDistributionJson)) {
                            foreach(var prop in doc.RootElement.EnumerateObject()) {
                                if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.Number) sizesObj[prop.Name] = prop.Value.GetInt32().ToString();
                                else if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.String) sizesObj[prop.Name] = prop.Value.GetString() ?? "0";
                            }
                        }
                    } catch {}
                }
                if (sizesObj.Count == 0) {
                    if (Model.SizeS > 0) sizesObj.Add("S", Model.SizeS.ToString());
                    if (Model.SizeM > 0) sizesObj.Add("M", Model.SizeM.ToString());
                    if (Model.SizeL > 0) sizesObj.Add("L", Model.SizeL.ToString());
                    if (Model.SizeXL > 0) sizesObj.Add("XL", Model.SizeXL.ToString());
                    if (Model.Size2XL > 0) sizesObj.Add("2XL", Model.Size2XL.ToString());
                    if (Model.Size3XL > 0) sizesObj.Add("3XL", Model.Size3XL.ToString());
                }

                var asortiObj = new Dictionary<string, string>();
                if (!string.IsNullOrEmpty(Model.AsortiDistributionJson)) {
                    try { 
                        using (var doc = System.Text.Json.JsonDocument.Parse(Model.AsortiDistributionJson)) {
                            foreach(var prop in doc.RootElement.EnumerateObject()) {
                                if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.Number) asortiObj[prop.Name] = prop.Value.GetInt32().ToString();
                                else if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.String) asortiObj[prop.Name] = prop.Value.GetString() ?? "0";
                            }
                        }
                    } catch {}
                }
                if (asortiObj.Count == 0) {
                    if (Model.AsortiSizeS > 0) asortiObj.Add("S", Model.AsortiSizeS.ToString());
                    if (Model.AsortiSizeM > 0) asortiObj.Add("M", Model.AsortiSizeM.ToString());
                    if (Model.AsortiSizeL > 0) asortiObj.Add("L", Model.AsortiSizeL.ToString());
                    if (Model.AsortiSizeXL > 0) asortiObj.Add("XL", Model.AsortiSizeXL.ToString());
                    if (Model.AsortiSize2XL > 0) asortiObj.Add("2XL", Model.AsortiSize2XL.ToString());
                    if (Model.AsortiSize3XL > 0) asortiObj.Add("3XL", Model.AsortiSize3XL.ToString());
                }

                int acikAdetTotal = 0;
                foreach(var v in sizesObj.Values) { if (int.TryParse(v, out int val)) acikAdetTotal += val; }
                
                int asortiTotal = 0;
                foreach(var v in asortiObj.Values) { if (int.TryParse(v, out int val)) asortiTotal += val; }
            }

