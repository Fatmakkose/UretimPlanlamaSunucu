@using UretimPlanlama.Models
@model Brand
@{
    ViewData["Title"] = "Yeni Marka Ekle";
}

<div class="dashboard-header" style="margin-bottom: 25px;">
    <div class="header-title">
        <h1 style="font-size: 1.8rem; margin: 0; color: var(--text-main);">Yeni Marka Ekle</h1>
    </div>
    <div class="header-actions">
        <a href="/Definitions/Brands" class="btn-secondary" style="text-decoration: none;"><i class="fa-solid fa-arrow-left"></i> Markalara Dön</a>
    </div>
</div>

<div class="dashboard-grid" style="grid-template-columns: 1fr; max-width: 800px;">
    <div class="schedule-section">
        <form asp-action="CreateBrand" method="post" class="form-container">
            <div class="form-group">
                <label asp-for="Name">Marka Adı <span style="color: red;">*</span></label>
                <input asp-for="Name" class="form-control" required placeholder="Örn: LC Waikiki" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-actions" style="margin-top: 30px; display: flex; justify-content: flex-end; gap: 15px;">
                <button type="button" class="btn-secondary" onclick="window.location.href='/Definitions/Brands'">İptal</button>
                <button type="submit" class="btn-planner"><i class="fa-solid fa-save"></i> Kaydet</button>
            </div>
        </form>
    </div>
</div>
