@model UretimPlanlama.Models.Workshop
@{
    ViewData["Title"] = "Atölye Kapasite Düzenle";
}

<form action="/Definitions/EditWorkshop" method="post">
<input type="hidden" name="Id" value="@Model.Id" />
<div class="dashboard-header" style="margin-bottom: 25px;">
    <div class="header-title">
        <h1 style="font-size: 1.8rem; margin: 0; color: var(--text-main);">Atölye Düzenle</h1>
    </div>
    <div class="header-actions">
        <a href="/Definitions/Workshops" class="btn-secondary" style="text-decoration: none;">İptal</a>
        <button type="submit" class="btn-planner"><i class="fa-solid fa-save"></i> Değişiklikleri Kaydet</button>
    </div>
</div>

<div class="dashboard-grid" style="grid-template-columns: 1fr;">
    <div class="schedule-section">
        <div class="section-header">
            <div>
                <h2>Atölye Bilgileri</h2>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <div class="form-group">
                <label>Atölye Adı</label>
                <input type="text" name="Name" class="form-control" placeholder="Örn: Atölye A (Kesim)" value="@Model.Name" required />
            </div>

            <div class="form-group">
                <label>Atölye Tipi</label>
                <select name="Type" class="form-control" required>
                    <option value="">Seçiniz</option>
                    @if (Model.Type == "Dahili (İç Üretim)")
                    {
                        <option value="Dahili (İç Üretim)" selected>Dahili (İç Üretim)</option>
                        <option value="Fason (Dış Üretim)">Fason (Dış Üretim)</option>
                    }
                    else
                    {
                        <option value="Dahili (İç Üretim)">Dahili (İç Üretim)</option>
                        <option value="Fason (Dış Üretim)" selected>Fason (Dış Üretim)</option>
                    }
                </select>
            </div>

            <div class="form-group" style="grid-column: 1 / -1;">
                <label>Yetkili Kişi</label>
                <input type="text" name="AuthorizedPerson" class="form-control" placeholder="Ad Soyad" value="@Model.AuthorizedPerson" required />
            </div>

            <div style="grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label>Günlük Üretim Kapasitesi (Adet)</label>
                    <input type="number" name="DailyCapacity" class="form-control" placeholder="Örn: 500" min="0" value="@Model.DailyCapacity" required />
                </div>
                <div class="form-group">
                    <label>Aylık Üretim Kapasitesi (Adet)</label>
                    <input type="number" name="MonthlyCapacity" class="form-control" placeholder="Örn: 12000" min="0" value="@Model.MonthlyCapacity" required />
                </div>
                <div class="form-group">
                    <label>Yıllık Üretim Kapasitesi (Adet)</label>
                    <input type="number" name="AnnualCapacity" class="form-control" placeholder="Örn: 120000" min="0" value="@Model.AnnualCapacity" required />
                </div>
            </div>

            <div class="form-group" style="grid-column: 1 / -1;">
                <label>Adres</label>
                <textarea name="Address" class="form-control" rows="3" placeholder="Açık adres bilgisi giriniz...">@Model.Address</textarea>
            </div>
        </div>
    </div>
</div>
</form>
