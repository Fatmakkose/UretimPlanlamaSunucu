@{
    ViewData["Title"] = "Yeni Müşteri Ekle";
}

<form action="/Definitions/CreateCustomer" method="post">
<div class="dashboard-header" style="margin-bottom: 25px;">
    <div class="header-title">
        <h1 style="font-size: 1.8rem; margin: 0; color: var(--text-main);">Yeni Müşteri Ekle</h1>
    </div>
    <div class="header-actions">
        <a href="/Definitions/Customers" class="btn-secondary" style="text-decoration: none;">İptal</a>
        <button type="submit" class="btn-planner"><i class="fa-solid fa-save"></i> Kaydet</button>
    </div>
</div>

<div class="dashboard-grid" style="grid-template-columns: 1fr;">
    <div class="schedule-section">
        <div class="section-header">
            <div>
                <h2>Müşteri Bilgileri</h2>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <div class="form-group">
                <label>Müşteri Adı</label>
                <input type="text" name="Name" class="form-control" placeholder="Örn: LC Waikiki" required />
            </div>

            <div class="form-group">
                <label>Telefon</label>
                <input type="text" name="Phone" class="form-control" placeholder="05XX XXX XX XX" />
            </div>

            <div class="form-group">
                <label>E-Posta</label>
                <input type="email" name="Email" class="form-control" placeholder="ornek@musteri.com" />
            </div>

            <div class="form-group" style="grid-column: 1 / -1;">
                <label>Fatura Adresi</label>
                <textarea name="Address" class="form-control" rows="3" placeholder="Açık adres bilgisi giriniz..."></textarea>
            </div>
        </div>
    </div>
</div>
</form>
