                                                rawAciklama = rawAciklama.replace(/Miktar:\s*[0-9,\.]+/, "")
                                                    .replace(/BİRİM KULLANIM\s*:\s*[0-9,\.]+(\s*\|\s*)?/gi, "")
                                                    .replace(/BİRİM METRAJ\s*:\s*[0-9,\.]+(\s*\|\s*)?/gi, "")
                                                    .replace(/FİRE\s*\(\%\)\s*:\s*[0-9,\.]+(\s*\|\s*)?/gi, "")
                                                    .replace(/BOY\s*:\s*[0-9a-zA-Z,\.]+(\s*\|\s*)?/gi, "")
                                                    .replace(/RENK\s*:\s*[^\|]+(\s*\|\s*)?/gi, "")
                                                    .replace(/^[ \|\-]+|[ \|\-]+$/g, "")
                                                    .replace(/<br\s*\/?>\s*(<br\s*\/?>)+/g, "<br/>").replace(/^(<br\s*\/?>)+/, "").trim();
                                                
                                                var finalAciklamaText = "";
                                                if (rawAciklama) { finalAciklamaText += rawAciklama + "<br/>"; }
                                                if (propsText) { finalAciklamaText += propsText; }
                                                
                                                var aciklamaDisplay = finalAciklamaText ? '<br/><span style="color:#0284c7; font-size:0.8rem; font-weight: 500;">' + finalAciklamaText + '</span>' : '';
                                                accHtml += '<div style="background:#f8fafc; padding:8px; border-radius:6px; border:1px solid #e2e8f0; font-size:0.85rem;">' +
                                                            '<strong>' + displayName + '</strong>' + qtyDisplay + aciklamaDisplay + '</div>';
                                            });
                                            accHtml += '</div></div>';
                                        }
                                    } else {
                                        accHtml = '<div style="color:#94a3b8; font-size:0.85rem; font-style:italic;">Bu siparişte model detayı seçilmemiştir.</div>';
                                    }

                                    $("#detAccessoriesContainer").html(accHtml);

