                        $(this).addClass("active");
                    });
                });

                // Silme onay butonu
                $(document).on("click", "#btnConfirmDelete", function() {
                    if (deleteOrderIds.length === 0) return;

                    if (deleteOrderIds.length === 1) {
                        // Tek sipariş sil
                        $.ajax({
                            url: "/Order/Delete",
                            type: "POST",
                            data: { id: deleteOrderIds[0] },
                            success: function(response) {
                                if (response.success) {
                                    showToast("Sipariş başarıyla silindi.", "success");
                                    setTimeout(function() { window.location.reload(); }, 800);
                                } else {
                                    showToast("Hata: " + response.message, "danger");
                                }
                            },
                            error: function() {
                                showToast("Sipariş silinirken sunucu hatası oluştu.", "danger");
                            }
                        });
                    } else {
                        // Çoklu sipariş sil
                        $.ajax({
                            url: "/Order/DeleteMultiple",
                            type: "POST",
                            contentType: "application/json",
                            data: JSON.stringify(deleteOrderIds),
                            success: function(response) {
                                if (response.success) {
                                    showToast("Siparişler başarıyla silindi.", "success");
                                    setTimeout(function() { window.location.reload(); }, 800);
                                } else {
                                    showToast("Hata: " + response.message, "danger");
                                }
