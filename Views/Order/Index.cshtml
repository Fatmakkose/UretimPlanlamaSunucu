                <h3 style="margin: 0; font-size: 1.3rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-folder-open" style="color: var(--primary-color);"></i> Sipariş Detayı: <span id="detOrderCode" style="color: var(--primary-color);">...</span>
                </h3>
                <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: var(--text-muted);">
                    <i class="fa-regular fa-calendar"></i> Sipariş Tarihi: <span id="detOrderDate">...</span>
                    &nbsp;|&nbsp; <i class="fa-solid fa-clock" style="margin-left: 8px;"></i> Termin: <span id="detPlannedPackagingEndDate" style="font-weight:600;">...</span>
                    &nbsp;|&nbsp; <i class="fa-solid fa-clock-rotate-left" style="margin-left: 8px;"></i> KNN Revize: <span id="detKnnRevizeTermin" style="font-weight:600; color: #dc2626;">...</span>
