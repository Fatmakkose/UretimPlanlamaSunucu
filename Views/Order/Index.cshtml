                    var size = $(this).val();
                    var isChecked = $(this).is(":checked");
                    
                    var sizesObj = type === 'open' ? editOpenSizes : editAsortiSizes;

                    if (isChecked) {
                        if (!sizesObj.hasOwnProperty(size)) {
                            sizesObj[size] = 0;
                        }
                    } else {
                        delete sizesObj[size];
                    }
                    renderEditSizeBadgesToContainer(type);
