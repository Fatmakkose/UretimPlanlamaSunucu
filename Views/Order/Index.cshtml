                                    $("#detActualFabric").text(order.actualFabricQty ? parseFloat(order.actualFabricQty).toLocaleString('tr-TR', { maximumFractionDigits: 2 }) + " kg" : "-");
                                    $("#detFabricAgreedDate").html(formatDetailDate(order.fabricArrivalAgreedDate));
