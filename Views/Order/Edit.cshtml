        $(document).on('change', '.sm-stokkarti', function() {
            var select = $(this);
            var stokId = select.val();
            var prevStokId = select.data('prev-stok');
            if (prevStokId === stokId) return;
            select.data('prev-stok', stokId);

            var row = select.closest('.stock-material-row');
            var detayDiv = row.find('.stok-detaylari');
            
            if (!stokId) {
                detayDiv.empty();
                row.find('.sm-miktar').prop('readonly', false).css('background', '#f8fafc');
                updateTotalItems();
                return;
            }

            var stok = stokKartlariList.find(s => s.Id == stokId);
            if (stok) {
                var detayHtml = `<div style="display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;">
                                    <div style="background: #f1f5f9; padding: 8px 16px; border-radius: 10px; font-size: 0.85rem; color: #475569; display: flex; align-items: center; gap: 8px; border: 1px solid #e2e8f0;"><i class="fa-solid fa-tag" style="color: #94a3b8;"></i> Kategori: <b style="color: #1e293b; margin-left: 4px;">${stok.Kategori || '-'}</b></div> 
                                    <div style="background: #f1f5f9; padding: 8px 16px; border-radius: 10px; font-size: 0.85rem; color: #475569; display: flex; align-items: center; gap: 8px; border: 1px solid #e2e8f0;"><i class="fa-solid fa-ruler" style="color: #94a3b8;"></i> Birim: <b style="color: #1e293b; margin-left: 4px;">${stok.Birim || '-'}</b></div> 
                                 </div>`;
                
                var initialPropsStr = row.attr('data-initial-props');
                var initProps = {};
                if (initialPropsStr) {
                    try {
                        initProps = JSON.parse(initialPropsStr);
                        row.removeAttr('data-initial-props');
                    } catch(e) {}
                } else {
                    row.find('.sm-dyn-prop, .sm-ozellik').each(function() {
                        var k = $(this).data('key');
                        var v = $(this).val();
                        if (k && v) initProps[k.toUpperCase()] = v;
                    });
                }

                var cat = (stok.Kategori || "").trim().toUpperCase();
                var calcFields = [];
                var isCalculable = false;

                if (cat === "KUMAŞ" || cat === "KUMAS") {
                    isCalculable = true;
                    calcFields.push({ Key: "BİRİM METRAJ", Type: "number", Def: "" });
                } else if (cat === "MALZEME") {
                    isCalculable = true;
                    calcFields.push({ Key: "BİRİM KULLANIM", Type: "number", Def: "" });
                    calcFields.push({ Key: "FİRE (%)", Type: "number", Def: "0" });
                } else if (cat === "ETİKET" || cat === "ETIKET") {
                    isCalculable = true;
                    calcFields.push({ Key: "FİRE (%)", Type: "number", Def: "2" });
                } else if (cat === "TELA") {
                    isCalculable = true;
                    calcFields.push({ Key: "TELA BİRİM", Type: "select", Def: "0.000,0.010,0.020,0.030,0.033,0.045,0.046,0.047" });
                    calcFields.push({ Key: "GRAM", Type: "select", Def: "55,80,115,175,KAĞIT" });
                    calcFields.push({ Key: "RENK", Type: "select", Def: "BEYAZ,SİYAH" });
                }

                var extraOzellikler = [];
                if (stok.OzelliklerJson) {
                    try {
                        var parsedOz = JSON.parse(stok.OzelliklerJson);
                        if (Array.isArray(parsedOz)) {
                            parsedOz.forEach(function(o) {
                                if (o.Key) {
                                    var existingIdx = calcFields.findIndex(c => c.Key === o.Key.toUpperCase());
                                    if (existingIdx > -1) {
                                        calcFields[existingIdx] = { Key: o.Key.toUpperCase(), Type: o.Type || 'text', Def: o.Value || '' };
                                    } else {
                                        extraOzellikler.push(o);
                                    }
                                }
                            });
                        }
                    } catch(e){}
                }

                if (isCalculable) {
                    row.find('.sm-miktar').prop('readonly', true).css('background', '#e2e8f0');
                } else {
                    row.find('.sm-miktar').prop('readonly', false).css('background', '#f8fafc');
                }

                if (calcFields.length > 0 || extraOzellikler.length > 0) {
                    detayHtml += `<div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
                                      <div style="width: 4px; height: 18px; background: linear-gradient(135deg, #3b82f6, #2563eb); border-radius: 4px;"></div>
                                      <h6 style="color: #1e293b; font-weight: 700; font-size: 0.95rem; margin: 0;">Hesaplama ve Özellikler</h6>
                                  </div>
                                  <div class="calc-fields-container" data-cat="${cat}" style="display:flex; flex-wrap: wrap; gap:16px; background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px dashed #cbd5e1;">`;
                    
                    var allFields = [];
                    calcFields.forEach(function(cf) {
                        allFields.push({ Key: cf.Key.toUpperCase(), Type: cf.Type, Value: cf.Def, IsCalc: true });
                    });
                    extraOzellikler.forEach(function(oz) {
                        allFields.push({ Key: oz.Key.toUpperCase(), Type: oz.Type, Value: oz.Value, IsCalc: false });
                    });

                    if (stok.StokAdi && stok.StokAdi.toUpperCase().includes("DÜĞME")) {
                        var orderMap = { "BOYUT": 1, "BİRİM KULLANIM": 2, "FİRE (%)": 3, "RENK": 4 };
                        allFields.sort(function(a, b) {
                            var orderA = orderMap[a.Key] || 99;
                            var orderB = orderMap[b.Key] || 99;
                            return orderA - orderB;
                        });
                    }

                    allFields.forEach(function(f) {
                         var pVal = initProps[f.Key] !== undefined ? initProps[f.Key] : (f.Value || "");
                         var calcClass = f.IsCalc ? 'sm-calc-trigger' : '';
                         var inputHtml = "";
                         if (f.Type === 'select') {
                             var opts = f.Value.split(',');
                             inputHtml = `<select class="form-control sm-dyn-prop ${calcClass}" data-key="${f.Key}" style="width:100%; padding: 8px 12px; font-size: 0.85rem; border-radius: 8px; font-weight:600;">
                                            <option value="">Seçiniz</option>`;
                             opts.forEach(function(o) {
                                 var sel = (o.trim() === pVal) ? 'selected' : '';
                                 inputHtml += `<option value="${o.trim()}" ${sel}>${o.trim()}</option>`;
                             });
                             inputHtml += `</select>`;
                         } else {
                             var typeAttr = f.Type === 'number' ? 'number' : 'text';
                             var stepAttr = f.Type === 'number' ? 'step="any"' : '';
                             inputHtml = `<input type="${typeAttr}" ${stepAttr} class="form-control sm-dyn-prop ${calcClass}" data-key="${f.Key}" value="${pVal}" placeholder="${f.Value || '...'}" style="width:100%; font-weight:600; padding: 8px 12px; font-size: 0.85rem; border-radius: 8px;" />`;
                         }
                         
                         detayHtml += `
                         <div style="flex: 1 1 0; min-width: 150px; max-width: 250px;">
                             <label style="font-size: 0.8rem; color: #64748b; margin-bottom: 6px; display: block; font-weight: 600;">${f.Key}</label>
                             ${inputHtml}
                         </div>`;
                    });

                    detayHtml += `</div>`;
                }
                
                $('.stok-detaylari').not(detayDiv).slideUp(300);
                detayDiv.html(detayHtml).hide().slideDown(300);
            } else {
                detayDiv.slideUp(300, function() { $(this).empty(); });
                row.find('.sm-miktar').prop('readonly', false).css('background', '#f8fafc');
            }
            updateTotalItems();
        });

        $(document).on('click', '.prop-summary', function() {
            var row = $(this).closest('.stock-material-row');
            var detayDiv = row.find('.stok-detaylari');
            $('.stok-detaylari').not(detayDiv).slideUp(300);
