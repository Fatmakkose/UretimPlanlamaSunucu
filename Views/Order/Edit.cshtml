            });

            // If not found, use initial JSON from hidden inputs
            if (Object.keys(oSizes).length === 0) {
                var jsonStr = $('input[name="SizeDistributionJson"]').val();
                if (jsonStr) { try { oSizes = JSON.parse(jsonStr); } catch(e){} }
            }
            if (Object.keys(aSizes).length === 0) {
                var jsonStr = $('input[name="AsortiDistributionJson"]').val();
                if (jsonStr) { try { aSizes = JSON.parse(jsonStr); } catch(e){} }
            }

            var sizeCount = activeSizes.length;
            var thAcik = `
            <tr>
                <th colspan="${sizeCount}" style="text-align:center; border-bottom:1px solid #bae6fd;">Açık Adet</th>
                <th rowspan="2" style="width:90px; min-width:90px; vertical-align:middle; text-align:center; color:#0284c7;">Toplam Adet</th>
            </tr><tr>`;
            var thAsorti = `
            <tr>
                <th colspan="${sizeCount}" style="text-align:center; border-bottom:1px solid #bbf7d0;">Asorti Adet</th>
                <th rowspan="2" style="width:90px; min-width:90px; vertical-align:middle; text-align:center;">Top. Asorti Sayısı</th>
                <th rowspan="2" style="width:100px; min-width:100px; vertical-align:middle; text-align:center;">Top. Asorti Sipariş</th>
                <th rowspan="2" style="width:90px; min-width:90px; vertical-align:middle; text-align:center; color:#15803d;">Toplam Adet</th>
            </tr><tr>`;
            
            var trAcikSizesHtml = "";
            var trAsortiSizesHtml = "";

            activeSizes.forEach(s => {
                thAcik += `<th style="width:75px; min-width:75px; text-align:center; padding: 4px;">` + s + `</th>`;
                thAsorti += `<th style="width:75px; min-width:75px; text-align:center; padding: 4px;">` + s + `</th>`;
                
                var oVal = oSizes[s] || "";
                var aVal = aSizes[s] || "";
                trAcikSizesHtml += `<td><input type="number" min="0" data-size="${s}" class="form-control form-control-sm main-size-input main-open-size no-spinner" style="text-align:center; font-weight:600; padding:4px;" value="${oVal}" /></td>`;
                trAsortiSizesHtml += `<td><input type="number" min="0" data-size="${s}" class="form-control form-control-sm main-size-input main-asorti-size no-spinner" style="text-align:center; font-weight:600; padding:4px;" value="${aVal}" /></td>`;
            });
            
            thAcik += `</tr>`;
            thAsorti += `</tr>`;

            var asortiCountVal = $('input[name="AsortiCount"]').val() || "0";

            var tablesHtml = `
            <table class="table table-bordered table-sm" style="min-width: 700px; margin-bottom: 16px;">
                <thead style="background: #f8fafc; color: #0369a1; font-size: 0.75rem;">${thAcik}</thead>
                <tbody>
                    <tr class="main-acik-row">
                        ${trAcikSizesHtml}
                        <td style="vertical-align:middle; text-align:center; font-weight:800; color:#0284c7; font-size:0.95rem;" class="main-acik-total">0</td>
                    </tr>
                </tbody>
            </table>
            <table class="table table-bordered table-sm" style="min-width: 700px; margin-bottom: 0;">
                <thead style="background: #f8fafc; color: #15803d; font-size: 0.75rem;">${thAsorti}</thead>
                <tbody>
                    <tr class="main-asorti-row">
                        ${trAsortiSizesHtml}
                        <td style="vertical-align:middle; text-align:center; font-weight:700; color:#475569;" class="main-asorti-ratio-total">0</td>
                        <td><input type="number" name="AsortiCount" min="0" class="form-control form-control-sm main-asorti-count" value="${asortiCountVal}" style="text-align:center; font-weight:700;" /></td>
                        <td style="vertical-align:middle; text-align:center; font-weight:800; color:#16a34a; font-size:0.95rem;" class="main-asorti-total">0</td>
                    </tr>
                </tbody>
            </table>
            `;
            
            $tablesContainer.html(tablesHtml).show();
            calcMainTotal();
        }

        function calcMainTotal() {
            var openTotal = 0;
            $('.main-acik-row .main-open-size').each(function() { openTotal += parseInt($(this).val()) || 0; });
            $('.main-acik-total').text(openTotal);

            var asortiRatioTotal = 0;
            $('.main-asorti-row .main-asorti-size').each(function() { asortiRatioTotal += parseInt($(this).val()) || 0; });
            $('.main-asorti-ratio-total').text(asortiRatioTotal);

            var asortiMultiplier = parseInt($('.main-asorti-count').val()) || 0;
            var asortiTotal = asortiRatioTotal * asortiMultiplier;
            $('.main-asorti-total').text(asortiTotal);
        }

        $(document).on('change', '.main-size-template', function() {
            $('.main-size-checkboxes').empty();
            renderMainCheckboxes($(this).val());
            renderMainTables();
        });

        $(document).on('change', '.main-size-cb', function() {
            renderMainTables();
        });

        $(document).on('input', '.main-size-input, .main-asorti-count', function() {
            calcMainTotal();
        });
        
        // Initial Loading
        var initialOpenSizes = {};
        try { initialOpenSizes = JSON.parse($('input[name="SizeDistributionJson"]').val()); } catch(e){}
        var initialAsortiSizes = {};
        try { initialAsortiSizes = JSON.parse($('input[name="AsortiDistributionJson"]').val()); } catch(e){}
        
        var allInitialSizes = [];
        Object.keys(initialOpenSizes).forEach(k => { if (!allInitialSizes.includes(k)) allInitialSizes.push(k); });
        Object.keys(initialAsortiSizes).forEach(k => { if (!allInitialSizes.includes(k)) allInitialSizes.push(k); });
        
        var initTemplate = "";
        for (var tpl in sizeTemplates) {
            if (tpl !== "ozel") {
                var allMatch = allInitialSizes.length > 0 && allInitialSizes.every(s => sizeTemplates[tpl].includes(s));
                if (allMatch) {
                    initTemplate = tpl;
                    break;
                }
            }
        }
        if (!initTemplate && allInitialSizes.length > 0) initTemplate = "ozel";
        
        if (initTemplate) {
            $('.main-size-template').val(initTemplate);
            renderMainCheckboxes(initTemplate, allInitialSizes);
            renderMainTables();
        } else {
            $('.main-size-template').val('beden');
            renderMainCheckboxes('beden', sizeTemplates['beden']);
            renderMainTables();
        }
        function renderCardCheckboxes($card, templateName) {
            var sizes = sizeTemplates[templateName] || [];
            var activeSizes = getCardActiveSizes($card);
            var html = "";
            sizes.forEach(function(s) {
                var isChecked = activeSizes.includes(s) ? "checked" : (activeSizes.length === 0 ? "checked" : "");
                html += `<label style="display:flex; align-items:center; gap:4px; font-size:0.8rem; font-weight:600; cursor:pointer; user-select:none; background:#ffffff; padding:2px 6px; border-radius:4px; border:1px solid #cbd5e1;"><input type="checkbox" class="card-size-cb" value="` + s + `" ` + isChecked + ` style="cursor:pointer;" /> ` + s + `</label>`;
            });
            $card.find('.card-size-checkboxes').html(html);
        }

        function getCardActiveSizes($card) {
            var activeSizes = [];
            $card.find('.card-size-cb:checked').each(function() {
                activeSizes.push($(this).val());
            });
            return activeSizes;
        }

        function renderCardTables($card) {
            var activeSizes = getCardActiveSizes($card);
            var $tablesContainer = $card.find('.color-tables');
            
            if(activeSizes.length === 0) {
                $tablesContainer.html('<div style="color: #64748b; font-size: 0.9rem;">Lütfen beden şablonundan beden seçimi yapınız.</div>').show();
                return;
            }
            
            var rId = $card.data('rid');
            var oSizes = {};
            $card.find('.open-size').each(function() { 
                var v = $(this).val();
                if (v) oSizes[$(this).data('size')] = v; 
            });
            var aSizes = {};
            $card.find('.asorti-size').each(function() { 
                var v = $(this).val();
                if (v) aSizes[$(this).data('size')] = v; 
            });
            
            var openSpecialCode = $card.find('.row-open-special-code').val() || "";
            var openColorCode = $card.find('.row-open-color-code').val() || "";
            var inspectionDate = $card.find('.row-inspection-date').val() || "";
            
            var asortiSpecialCode = $card.find('.row-asorti-special-code').val() || "";
            var asortiColorCode = $card.find('.row-asorti-color-code').val() || "";
            var asortiInspectionDate = $card.find('.row-asorti-inspection-date').val() || "";
            var asortiCount = $card.find('.row-asorti-count').val() || "0";

            var sizeCount = activeSizes.length;
            var thAcik = `
            <tr>
                <th rowspan="2" style="width:110px; min-width:110px; vertical-align:middle; text-align:center;">Özel Kod</th>
                <th rowspan="2" style="width:110px; min-width:110px; vertical-align:middle; text-align:center;">Özel Renk K.</th>
                <th rowspan="2" style="width:140px; min-width:140px; vertical-align:middle; text-align:center;">Inspection (Termin)</th>
                <th colspan="${sizeCount}" style="text-align:center; border-bottom:1px solid #bae6fd;">Açık Adet</th>
                <th rowspan="2" style="width:90px; min-width:90px; vertical-align:middle; text-align:center; color:#0284c7;">Toplam Adet</th>
            </tr><tr>`;
            var thAsorti = `
            <tr>
                <th rowspan="2" style="width:110px; min-width:110px; vertical-align:middle; text-align:center;">Özel Kod</th>
                <th rowspan="2" style="width:110px; min-width:110px; vertical-align:middle; text-align:center;">Özel Renk K.</th>
                <th rowspan="2" style="width:140px; min-width:140px; vertical-align:middle; text-align:center;">Inspection (Termin)</th>
                <th colspan="${sizeCount}" style="text-align:center; border-bottom:1px solid #bbf7d0;">Asorti Adet</th>
                <th rowspan="2" style="width:90px; min-width:90px; vertical-align:middle; text-align:center;">Top. Asorti Sayısı</th>
                <th rowspan="2" style="width:100px; min-width:100px; vertical-align:middle; text-align:center;">Top. Asorti Sipariş</th>
                <th rowspan="2" style="width:90px; min-width:90px; vertical-align:middle; text-align:center; color:#15803d;">Toplam Adet</th>
            </tr><tr>`;
            
            var trAcikSizesHtml = "";
            var trAsortiSizesHtml = "";

            activeSizes.forEach(s => {
                thAcik += `<th style="width:75px; min-width:75px; text-align:center; padding: 4px;">` + s + `</th>`;
                thAsorti += `<th style="width:75px; min-width:75px; text-align:center; padding: 4px;">` + s + `</th>`;
                
                var oVal = oSizes[s] || "";
                var aVal = aSizes[s] || "";
                trAcikSizesHtml += `<td><input type="number" min="0" data-size="${s}" class="form-control form-control-sm size-input open-size no-spinner" style="text-align:center; font-weight:600; padding:4px;" value="${oVal}" /></td>`;
                trAsortiSizesHtml += `<td><input type="number" min="0" data-size="${s}" class="form-control form-control-sm size-input asorti-size no-spinner" style="text-align:center; font-weight:600; padding:4px;" value="${aVal}" /></td>`;
            });
            
            thAcik += `</tr>`;
            thAsorti += `</tr>`;

            var tablesHtml = `
            <table class="table table-bordered table-sm" style="min-width: 700px; margin-bottom: 16px;">
                <thead style="background: #f8fafc; color: #0369a1; font-size: 0.75rem;">${thAcik}</thead>
                <tbody>
                    <tr class="acik-row" data-rid="${rId}">
                        <td><input type="text" class="form-control form-control-sm row-open-special-code" placeholder="Örn: ACK" value="${openSpecialCode}" /></td>
                        <td><input type="text" class="form-control form-control-sm row-open-color-code" placeholder="Örn: R-01" value="${openColorCode}" /></td>
                        <td><input type="date" class="form-control form-control-sm row-inspection-date" value="${inspectionDate}" /></td>
                        ${trAcikSizesHtml}
                        <td style="vertical-align:middle; text-align:center; font-weight:800; color:#0284c7; font-size:0.95rem;" class="row-acik-total">0</td>
                    </tr>
                </tbody>
            </table>
            <table class="table table-bordered table-sm" style="min-width: 700px; margin-bottom: 0;">
                <thead style="background: #f8fafc; color: #15803d; font-size: 0.75rem;">${thAsorti}</thead>
                <tbody>
                    <tr class="asorti-row" data-rid="${rId}">
                        <td><input type="text" class="form-control form-control-sm row-asorti-special-code" placeholder="Örn: ASR" value="${asortiSpecialCode}" /></td>
                        <td><input type="text" class="form-control form-control-sm row-asorti-color-code" placeholder="Örn: R-01" value="${asortiColorCode}" /></td>
                        <td><input type="date" class="form-control form-control-sm row-asorti-inspection-date" value="${asortiInspectionDate}" /></td>
                        ${trAsortiSizesHtml}
                        <td style="vertical-align:middle; text-align:center; font-weight:700; color:#475569;" class="row-asorti-ratio-total">0</td>
                        <td><input type="number" min="0" class="form-control form-control-sm row-asorti-count" value="${asortiCount}" style="text-align:center; font-weight:700;" /></td>
                        <td style="vertical-align:middle; text-align:center; font-weight:800; color:#16a34a; font-size:0.95rem;" class="row-asorti-total">0</td>
                    </tr>
                </tbody>
            </table>
            `;
            
            $tablesContainer.html(tablesHtml).show();
            calcRowTotal(rId);
        }

        var rowCounter = 0;
        function addNewColorRow(savedData = null) {
            rowCounter++;
            var rId = 'cRow_' + rowCounter;

            var cardHtml = `
            <div class="color-card" data-rid="${rId}" style="margin-bottom: 24px; background: white; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden;">
                <div class="color-header" style="background: #f1f5f9; padding: 12px 20px; border-bottom: 1px solid #e2e8f0; display: flex; gap: 16px; align-items: center; flex-wrap: wrap; cursor: pointer;" title="Detayları aç/kapat">
                    <div style="flex: 1; min-width: 200px;">
                        <label style="font-size: 0.75rem; color: #64748b; font-weight: 600; display: block; margin-bottom: 4px;">Renk / Option</label>
                        <select class="form-control form-control-sm row-color" style="font-weight:600; color:#1e293b;">${colorOptionsHtml}</select>
                    </div>
                    <div style="flex: 1; min-width: 150px;">
                        <label style="font-size: 0.75rem; color: #64748b; font-weight: 600; display: block; margin-bottom: 4px;">Kumaşçı</label>
                        <select class="form-control form-control-sm row-fabricator">${fabricatorOptionsHtml}</select>
                    </div>
                    <div style="width: 110px;">
                        <label style="font-size: 0.75rem; color: #64748b; font-weight: 600; display: block; margin-bottom: 4px;">Birim Fiyatı</label>
                        <input type="number" step="0.01" class="form-control form-control-sm row-unit-price" placeholder="0.00" value="" />
                    </div>
                    <div style="width: 130px;">
                        <label style="font-size: 0.75rem; color: #64748b; font-weight: 600; display: block; margin-bottom: 4px;">Revize Termin</label>
                        <input type="date" class="form-control form-control-sm row-revised-inspection-date" value="" />
                    </div>
                    <div style="display: flex; gap: 12px; margin-left: auto; align-items: center; margin-right: 8px; text-align: right; background: #ffffff; padding: 4px 12px; border-radius: 8px; border: 1px solid #e2e8f0;">
                        <div>
                            <div style="font-size: 0.65rem; color: #64748b; font-weight: 700; text-transform: uppercase;">Açık Adet</div>
                            <div class="card-summary-acik" style="font-size: 1.1rem; color: #0284c7; font-weight: 800;">0</div>
                        </div>
                        <div style="width: 1px; height: 24px; background: #cbd5e1;"></div>
                        <div>
                            <div style="font-size: 0.65rem; color: #64748b; font-weight: 700; text-transform: uppercase;">Asorti Adet</div>
                            <div class="card-summary-asorti" style="font-size: 1.1rem; color: #16a34a; font-weight: 800;">0</div>
                        </div>
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="btnToggleCard" style="margin-top: 10px; background: #ffffff; color: #64748b; border: 1px solid #cbd5e1; border-radius: 8px; width: 34px; height: 34px; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='#ffffff'"><i class="fa-solid fa-chevron-up toggle-icon"></i></button>
                        <button type="button" class="btnRemoveRow" style="margin-top: 10px; background: #ffffff; color: #ef4444; border: 1px solid #fee2e2; border-radius: 8px; width: 34px; height: 34px; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='#fee2e2'" onmouseout="this.style.background='#ffffff'"><i class="fa-solid fa-trash"></i></button>
                    </div>
                </div>

                <div style="background: #ffffff; padding: 12px 20px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; flex-wrap:wrap; gap:16px;">
                    <label style="font-weight: 600; font-size: 0.85rem; color: #1e293b; margin:0;"><i class="fa-solid fa-ruler"></i> Beden Şablonu:</label>
                    <select class="form-control card-size-template" style="width: 150px; padding: 4px 10px; font-size: 0.8rem; border-radius: 6px; font-weight:600; background:#f8fafc; border:1px solid #cbd5e1;">
                        <option value="">-- Şablon Seçin --</option>
                        <option value="beden">Beden (XS..6XL)</option>
                        <option value="numara">Numara (32..48)</option>
                    </select>
                    <div class="card-size-checkboxes" style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-left: 12px; padding-left: 12px; border-left: 2px solid #cbd5e1;">
                    </div>
                </div>
                
                <div class="color-tables" style="padding: 16px 20px; overflow-x: auto; display:none;">
                </div>
            </div>
            `;
            $('#colorsContainer').append(cardHtml);
        }

        $(document).on('change', '.card-size-template', function() {
            var $card = $(this).closest('.color-card');
            $card.find('.card-size-checkboxes').empty();
            renderCardCheckboxes($card, $(this).val());
            renderCardTables($card);
        });

        $(document).on('change', '.card-size-cb', function() {
            var $card = $(this).closest('.color-card');
            renderCardTables($card);
        });

        $(document).on('click', '.color-header', function(e) {
            if ($(e.target).closest('input, select, button').length > 0 && !$(e.target).closest('.btnToggleCard').length) return;
            var $card = $(this).closest('.color-card');
            var $tables = $card.find('.color-tables');
            var $icon = $(this).find('.toggle-icon');
            if ($tables.is(':visible')) {
                $tables.slideUp(300);
                $icon.removeClass('fa-chevron-up').addClass('fa-chevron-down');
            } else {
                $tables.slideDown(300);
                $icon.removeClass('fa-chevron-down').addClass('fa-chevron-up');
            }
        });

        $(document).on('click', '.btnRemoveRow', function() {
            var rId = $(this).closest('.color-card').data('rid');
            $('.color-card[data-rid="' + rId + '"]').remove();
            if ($('.color-card').length === 0) {
                $('#sizeTemplateWrapper').css('display', 'none');
            }
        });

        $(document).on('input', '.size-input, .row-asorti-count', function() {
            var rId = $(this).closest('tr').data('rid');
            var $acikRow = $('.acik-row[data-rid="' + rId + '"]');
            var $asortiRow = $('.asorti-row[data-rid="' + rId + '"]');
            
            var openTotal = 0;
            $acikRow.find('.open-size').each(function() { openTotal += parseInt($(this).val()) || 0; });
            $acikRow.find('.row-acik-total').text(openTotal);
            $('.color-card[data-rid="' + rId + '"]').find('.card-summary-acik').text(openTotal);

            var asortiRatioTotal = 0;
            $asortiRow.find('.asorti-size').each(function() { asortiRatioTotal += parseInt($(this).val()) || 0; });
            $asortiRow.find('.row-asorti-ratio-total').text(asortiRatioTotal);

            var asortiMultiplier = parseInt($asortiRow.find('.row-asorti-count').val()) || 0;
            var asortiTotal = asortiRatioTotal * asortiMultiplier;
            $asortiRow.find('.row-asorti-total').text(asortiTotal);
            $('.color-card[data-rid="' + rId + '"]').find('.card-summary-asorti').text(asortiTotal);
        });

        function getSavedRowsData() {
            var data = [];
            $(".acik-row").each(function() {
                var $acik = $(this);
                var rId = $acik.data('rid');
                var $asorti = $('.asorti-row[data-rid="' + rId + '"]');
                var oSizes = {};
                $acik.find('.open-size').each(function() {
                    var s = $(this).data('size');
                    var v = parseInt($(this).val()) || 0;
                    if(v > 0) oSizes[s] = v;
                });
                var aSizes = {};
                $asorti.find('.asorti-size').each(function() {
                    var s = $(this).data('size');
                    var v = parseInt($(this).val()) || 0;
                    if(v > 0) aSizes[s] = v;
                });
                var $card = $(this).closest('.color-card');
                data.push({
                    color: $card.find('.row-color').val() || "",
                    inspectionDate: $acik.find('.row-inspection-date').val() || "",
                    revisedInspectionDate: $card.find('.row-revised-inspection-date').val() || "",
                    unitPrice: $card.find('.row-unit-price').val() || "",
                    fabricator: $card.find('.row-fabricator').val() || "",
                    openSizes: oSizes,
                    asortiSizes: aSizes,
                    asortiCount: $asorti.find('.row-asorti-count').val() || "0",
                    openSpecialCode: $acik.find('.row-open-special-code').val() || "",
                    openColorCode: $acik.find('.row-open-color-code').val() || "",
                    asortiSpecialCode: $asorti.find('.row-asorti-special-code').val() || "",
                    asortiColorCode: $asorti.find('.row-asorti-color-code').val() || "",
                    asortiInspectionDate: $asorti.find('.row-asorti-inspection-date').val() || ""
                });
            });
            return data;
        }

        $("#btnAddColorRow").click(function() {
            addNewColorRow();
        });
    </script>
}
