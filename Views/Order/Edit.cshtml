        $('#btnSubmitFullEdit').click(function() {
            var materials = [];
            $('#stockMaterialsContainer .stock-material-row').each(function() {
                var stokId = parseInt($(this).find('.sm-stokkarti').val());
                var miktarStr = $(this).find('.sm-miktar').val();
                var aciklama = $(this).find('.sm-aciklama').val();
                
                var miktar = parseFloat((miktarStr || "0").replace(',', '.')) || 0;
                
                var ozellikler = [];
                $(this).find('.sm-dyn-prop').each(function() {
                    var k = $(this).data('key');
                    var v = $(this).val();
                    if (k) {
                        var t = $(this).attr('type') === 'number' ? 'number' : ($(this).is('select') ? 'select' : 'text');
                        ozellikler.push({ Key: k, Value: v, Type: t });
                    }
                });
                
                var ozelliklerJsonStr = JSON.stringify(ozellikler);
                
                if (stokId > 0) {
                    materials.push({
                        StokKartiId: stokId,
                        Miktar: miktar,
                        Aciklama: aciklama,
                        OzelliklerJson: ozelliklerJsonStr
                    });
                }
            });
            
            $("#orderMaterialsJson").val(JSON.stringify(materials));
            
            // Rebuild Size and Asorti JSON and Total Quantity
            let openSizes = {};
            let asortiSizes = {};
            let totalQty = 0;
            let asortiMultiplier = parseInt($('.main-asorti-count').val()) || 0;

            $('.main-open-size').each(function() {
                var sz = $(this).data('size');
                var val = parseInt($(this).val()) || 0;
                if (val > 0) {
                    openSizes[sz] = val;
                    totalQty += val;
                }
            });
            $('.main-asorti-size').each(function() {
                var sz = $(this).data('size');
                var val = parseInt($(this).val()) || 0;
                if (val > 0) {
                    asortiSizes[sz] = val;
                    totalQty += (val * asortiMultiplier);
                }
            });

            $('input[name="SizeDistributionJson"]').val(JSON.stringify(openSizes));
            $('input[name="AsortiDistributionJson"]').val(JSON.stringify(asortiSizes));
            $('input[name="Quantity"]').val(totalQty);
            
            const formData = new FormData($('#editOrderFormFull')[0]);
            let dataObj = {};
            formData.forEach((value, key) => { 
                dataObj[key] = value; 
            });

            // Need to handle Id as int
            if (dataObj.Id) dataObj.Id = parseInt(dataObj.Id);

            var processSubmit = function(imageUrl) {
                $.ajax({
                    url: '/Order/Edit',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dataObj),
                    success: function(res) {
                        if (res.success) {
                            var extraRows = getSavedRowsData();
                            if (extraRows.length > 0) {
                                // Post multiple
                                var newOrders = [];
                                extraRows.forEach(function(row) {
                                    var newOrder = Object.assign({}, dataObj);
                                    newOrder.Id = 0;
                                    newOrder.OrderCode = dataObj.OrderCode; // retain from edit object
                                    newOrder.Customer = dataObj.Customer;
                                    newOrder.ModelName = dataObj.ModelName;
                                    newOrder.Brand = dataObj.Brand;
                                    newOrder.Color = row.color;
                                    newOrder.FabricSupplier = row.fabricator;
                                    if(row.inspectionDate) newOrder.InspectionDate = row.inspectionDate;
                                    // if(row.revisedInspectionDate) newOrder.RevisedInspectionDate = row.revisedInspectionDate;
                                    if(row.unitPrice) newOrder.UnitPrice = parseFloat(row.unitPrice.replace(',','.'));
                                    newOrder.AsortiCount = parseInt(row.asortiCount) || 0;
                                    newOrder.SizeDistributionJson = JSON.stringify(row.openSizes);
                                    newOrder.AsortiDistributionJson = JSON.stringify(row.asortiSizes);
                                    
                                    var qty = 0;
                                    var asortiToplam = 0;
                                    for(var k in row.openSizes) qty += row.openSizes[k];
                                    for(var k in row.asortiSizes) asortiToplam += row.asortiSizes[k];
                                    qty += (asortiToplam * newOrder.AsortiCount);
                                    newOrder.Quantity = qty;

                                    newOrders.push(newOrder);
                                });

                                $.ajax({
                                    url: '/Order/CreateMultiple',
                                    type: 'POST',
                                    contentType: 'application/json',
                                    data: JSON.stringify(newOrders),
                                    success: function(resMult) {
                                        if (resMult.success) {
                                            Swal.fire({ icon: 'success', title: 'Başarılı!', text: 'Ana sipariş güncellendi ve ' + extraRows.length + ' yeni renk siparişi başarıyla oluşturuldu.', confirmButtonColor: '#10b981' }).then(() => {
                                                window.location.href = '/Order/Index';
                                            });
                                        } else {
                                            Swal.fire({ icon: 'warning', title: 'Kısmi Başarı', text: 'Ana sipariş güncellendi ancak yeni renkler eklenirken hata oluştu: ' + resMult.message, confirmButtonColor: '#f59e0b' }).then(() => {
                                                window.location.href = '/Order/Index';
                                            });
                                        }
                                    },
                                    error: function() {
                                        Swal.fire({ icon: 'error', title: 'Sunucu Hatası!', text: 'Ana sipariş güncellendi ancak yeni renkler kaydedilirken sunucu hatası oluştu.', confirmButtonColor: '#ef4444' }).then(() => {
                                            window.location.href = '/Order/Index';
                                        });
                                    }
                                });
                            } else {
                                window.location.href = '/Order/Index';
                            }
                        } else {
                            Swal.fire({ icon: 'error', title: 'Hata!', text: res.message, confirmButtonColor: '#ef4444' });
                            var btn = $('#btnSubmitFullEdit');
                            btn.prop('disabled', false).html('<i class="fa-solid fa-floppy-disk"></i> Değişiklikleri Kaydet');
                        }
                    },
                    error: function(err) {
                        Swal.fire({ icon: 'error', title: 'Hata!', text: 'Bir hata oluştu. Veriler kaydedilemedi.', confirmButtonColor: '#ef4444' });
                        console.error(err);
                    }
                });
            };

            var imgInput = document.getElementById('orderImageInput');
            if (imgInput && imgInput.files && imgInput.files.length > 0) {
                var imgData = new FormData();
                imgData.append("OrderImage", imgInput.files[0]);
                $.ajax({
                    url: '/Order/UploadOrderImage',
                    type: 'POST',
                    data: imgData,
                    processData: false,
                    contentType: false,
                    success: function(uploadRes) {
                        if (uploadRes.success) {
                            processSubmit(uploadRes.imageUrl);
                        } else {
                            Swal.fire({ icon: 'error', title: 'Hata!', text: 'Görsel yüklenemedi: ' + uploadRes.message, confirmButtonColor: '#ef4444' });
                        }
                    },
                    error: function() {
                        Swal.fire({ icon: 'error', title: 'Sunucu Hatası!', text: 'Görsel yüklenirken sunucu hatası oluştu.', confirmButtonColor: '#ef4444' });
                    }
                });
            } else {
                processSubmit(null);
            }
        });

