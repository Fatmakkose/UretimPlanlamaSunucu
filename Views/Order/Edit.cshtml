                            row.find('.stok-detay-mevcut').text('Tanımsız (0)');
                        }
                    } else {
                        row.find('.stok-detay-mevcut').text('Varyant Seçimi Bekleniyor');
                    }
                }
            }

            var summaryArr = [];
            row.find('.sm-dyn-prop').each(function() {
                var k = $(this).data('key');
                var v = $(this).val();
                if (k && v) {
                    summaryArr.push(`${k}: ${v}`);
                }
            });
            var sumText = summaryArr.length > 0 ? '<i class="fa-solid fa-pen-to-square"></i> ' + summaryArr.join(" | ") : '<i class="fa-solid fa-pen-to-square"></i> Özellik Seç';
            row.find('.prop-summary').html(sumText);
            row.find('.sm-aciklama').val(summaryArr.join(" | "));
            
            updateTotalItems();
        });

