        });

        $(document).on('input change', '.sm-dyn-prop, .sm-calc-trigger', function() {
            var row = $(this).closest('.stock-material-row');
            
            // Varyant stok sorgusu
            var stokId = row.find('.sm-stokkarti').val();
            if (stokId) {
                var stok = stokKartlariList.find(s => s.Id == stokId);
                if (stok && stok.Varyantlar && stok.Varyantlar.length > 0) {
                    var props = [];
                    row.find('.sm-dyn-prop, .sm-ozellik').each(function() {
                        var k = $(this).data('key');
                        var v = $(this).val();
                        if (k && v) {
                            props.push({ Key: k, Value: v });
