                                <div style="margin-top:12px; padding-top:8px;">
                                    <label style="font-size: 0.8rem; font-weight: 600; color:#475569; margin-bottom:4px; display:block;"><i class="fa-solid fa-barcode" style="margin-right:4px; color:#16a34a;"></i> Özel Kod (Asorti)</label>
                                    <input type="text" class="form-control row-asorti-special-code" value="${asortiSpecialCode}" placeholder="Örn: ASR-001" style="height:32px; font-size:0.85rem;" />
                                </div>
                            </div>
                        </div>

                        <div style="display: flex; justify-content: flex-end; margin-top: 8px;">
                            <div style="background: #e0f2fe; border: 1px solid #bae6fd; padding: 8px 16px; border-radius: 8px; display: inline-flex; align-items: center; gap: 12px;">
                                <span style="font-size: 0.95rem; font-weight: 700; color:#0284c7;">Bu Renk Toplam Adet:</span>
                                <input type="number" class="form-control row-total-qty" readonly style="background: transparent; font-weight: 800; font-size: 1.25rem; color:#0284c7; border: none; padding: 0; text-align: right; width: 120px; box-shadow: none;" value="0" />
                            </div>
                        </div>
                    </div>
                </div>
                `;

                var rowElement = $(rowHtml);
                rowElement.data('openSizes', openSizes);
                rowElement.data('asortiSizes', asortiSizes);
                if (color) {
                    rowElement.find('.row-color').val(color);
                }
                if (fabricator) {
                    rowElement.find('.row-fabricator').val(fabricator);
                }
                return rowElement;
            }

            function reRenderAllRows() {
                var savedData = getSavedRowsData();
                $("#colorRowsContainer").empty();
                if (savedData.length === 0) {
                    var rowElement = createRowHtml(null);
                    $("#colorRowsContainer").append(rowElement);
                    calculateRowTotals(rowElement);
                } else {
                    savedData.forEach(function(data) {
                        var rowElement = createRowHtml(data);
                        $("#colorRowsContainer").append(rowElement);
                        calculateRowTotals(rowElement);
                    });
                }
            }



            $(document).on('change', '.dyn-size-checkbox', function() {
                var row = $(this).closest('.color-row');
                var type = $(this).data('type');
                var size = $(this).val();
                var isChecked = $(this).is(':checked');

                var sizesDict = type === 'open' ? (row.data('openSizes') || {}) : (row.data('asortiSizes') || {});
                
                if (isChecked) {
                    if (!(size in sizesDict)) {
                        sizesDict[size] = 0;
                    }
                } else {
                    delete sizesDict[size];
                }

                if (type === 'open') {
                    row.data('openSizes', sizesDict);
                } else {
                    row.data('asortiSizes', sizesDict);
                }

                row.find('.dyn-sizes-container-' + type).html(renderSizeBadgesToContainer(type, sizesDict));
                calculateRowTotals(row);
            });

            $(document).on('click', '.btnRemoveDynSize', function() {
                var row = $(this).closest('.color-row');
                var type = $(this).data('type');
                var size = $(this).data('size');
                
                var sizesDict = type === 'open' ? (row.data('openSizes') || {}) : (row.data('asortiSizes') || {});
                delete sizesDict[size];
                
                if (type === 'open') {
                    row.data('openSizes', sizesDict);
                } else {
                    row.data('asortiSizes', sizesDict);
                }

                row.find('.dyn-sizes-container-' + type).html(renderSizeBadgesToContainer(type, sizesDict));
                row.find(`.dyn-size-checkbox[data-type="${type}"][value="${size}"]`).prop('checked', false);
                calculateRowTotals(row);
            });

            $(document).on('input', '.dyn-size-input', function() {
                var row = $(this).closest('.color-row');
                var type = $(this).data('type');
                var size = $(this).data('size');
                var qty = parseInt($(this).val()) || 0;

                var sizesDict = type === 'open' ? (row.data('openSizes') || {}) : (row.data('asortiSizes') || {});
                sizesDict[size] = qty;
                
                if (type === 'open') {
                    row.data('openSizes', sizesDict);
                } else {
                    row.data('asortiSizes', sizesDict);
                }

                calculateRowTotals(row);
            });

            $(document).on('input', '.asorti-count', function() {
                var row = $(this).closest('.color-row');
                calculateRowTotals(row);
            });

            function calculateRowTotals(row) {
                var openSizes = row.data('openSizes') || {};
                var asortiSizes = row.data('asortiSizes') || {};

                var openQty = 0;
                Object.keys(openSizes).forEach(function(key) {
                    openQty += (parseInt(openSizes[key]) || 0);
                });
                row.find('.row-open-total').val(openQty);
                row.find('.row-open-total-text').text(openQty);

                var asortiRatioSum = 0;
                Object.keys(asortiSizes).forEach(function(key) {
                    asortiRatioSum += (parseInt(asortiSizes[key]) || 0);
                });
                row.find('.row-asorti-total').val(asortiRatioSum);
                row.find('.row-asorti-total-text').text(asortiRatioSum);

                var asortiMultiplier = parseInt(row.find('.row-asorti-count').val()) || 0;

                var totalAsortiQty = asortiRatioSum * asortiMultiplier;
                row.find('.row-asorti-final').val(totalAsortiQty);

                var rowTotal = openQty + totalAsortiQty;
                row.find('.row-total-qty').val(rowTotal);
                row.find('.header-total-qty').text(rowTotal);

                calculateGrandTotalQuantity();
            }

            function calculateGrandTotalQuantity() {
                var grandTotalQty = 0;
                $('.row-total-qty').each(function() {
                    grandTotalQty += (parseInt($(this).val()) || 0);
                });
            }

            $(document).on('change', '.row-color', function() {
                var val = $(this).val();
                $(this).closest('.color-row').find('.header-color-name').text(val || 'Yeni Renk');
            });

            $(document).on('click', '.row-header', function(e) {
                if ($(e.target).closest('.btnRemoveRow').length > 0) return;
                var row = $(this).closest('.color-row');
                var body = row.find('.row-body');
                var icon = row.find('.toggle-icon');
                
                body.slideToggle(250, function() {
                    if (body.is(':visible')) {
                        icon.css('transform', 'rotate(180deg)');
                    } else {
                        icon.css('transform', 'rotate(0deg)');
                    }
                });
            });

            $(document).on('click', '.btnRemoveRow', function() {
                $(this).closest('.color-row').fadeOut(200, function() {
                    $(this).remove();
                    calculateGrandTotalQuantity();
                });
            });

            // Toggle size dropdown
            $(document).on('click', '.btn-size-select', function(e) {
                e.stopPropagation();
                var dropdown = $(this).siblings('.size-dropdown-content');
                $('.size-dropdown-content').not(dropdown).fadeOut(150);
                dropdown.fadeToggle(150);
            });

            // Hide dropdowns when clicking outside
            $(document).click(function() {
                $('.size-dropdown-content').fadeOut(150);
            });

            $(document).on('click', '.size-dropdown-content', function(e) {
                e.stopPropagation();
            });

            $("#btnAddColorRow").click(function() {
                // Collapse existing
                $(".color-row .row-body").slideUp(250);
                $(".color-row .toggle-icon").css('transform', 'rotate(0deg)');

                var rowElement = createRowHtml(null);
                $("#colorRowsContainer").append(rowElement);
                calculateRowTotals(rowElement);
            });

            $("#btnAddColorRow").click();

            $("#btnSubmitOrder").click(function(e) {
                e.preventDefault();
                
                var form = $("#newOrderForm")[0];
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }

                var materialsJson = $("#orderMaterialsJson").val();
                if (!materialsJson || materialsJson === "[]") {
                    showToast("Lütfen 'Malzemeleri Seç / Düzenle' butonunu kullanarak model malzeme detaylarını ekleyin.", "danger");
                    
                    var btn = $("#btnOpenModelDetail");
                    btn.addClass("shake");
                    setTimeout(function() { btn.removeClass("shake"); }, 500);
                    
                    $('html, body').animate({
                        scrollTop: btn.offset().top - 100
                    }, 500);
                    return;
                }

                var rows = $(".color-row");
                if (rows.length === 0) {
                    showToast("Lütfen en az bir renk/satır ekleyin.", "danger");
                    return;
                }

                var isRowValid = true;
                rows.each(function() {
                    var color = $(this).find('.row-color').val();
                    var fabricator = $(this).find('.row-fabricator').val();
                    if (!color || !fabricator) {
                        isRowValid = false;
                        $(this).find('.row-body').slideDown(250);
                        $(this).find('.toggle-icon').css('transform', 'rotate(180deg)');
                    }
                });

                if (!isRowValid) {
                    showToast("Lütfen tüm renk satırlarında Renk ve Kumaşçı alanlarını doldurunuz.", "danger");
                    return;
                }

                var formData = new FormData(form);
                var commonData = Object.fromEntries(formData.entries());

                var orders = [];
                rows.each(function() {
                    var row = $(this);
                    var orderObj = Object.assign({}, commonData);

                    // Boolean properties from checkboxes
                    orderObj.HasPriceCard = $("#newOrderForm input[name='HasPriceCard']").is(':checked');
                    orderObj.HasWashingInstruction = $("#newOrderForm input[name='HasWashingInstruction']").is(':checked');
                    orderObj.HasInnerBarcode = $("#newOrderForm input[name='HasInnerBarcode']").is(':checked');
                    orderObj.HasYokeLabel = $("#newOrderForm input[name='HasYokeLabel']").is(':checked');
                    orderObj.HasFifLabel = $("#newOrderForm input[name='HasFifLabel']").is(':checked');
                    orderObj.HasOtherCard = $("#newOrderForm input[name='HasOtherCard']").is(':checked');

                    var customAcc = {};
                    customAcc.KetenKarti = $("#newOrderForm input[name='Acc_KetenKarti']").is(':checked');
                    customAcc.Jelatin = $("#newOrderForm input[name='Acc_Jelatin']").is(':checked');
                    customAcc.Cember = $("#newOrderForm input[name='Acc_Cember']").is(':checked');
                    customAcc.Kelebek = $("#newOrderForm input[name='Acc_Kelebek']").is(':checked');
                    customAcc.LotPoseti = $("#newOrderForm input[name='Acc_LotPoseti']").is(':checked');

                    customAcc.Tela1 = parseFloat($("#newOrderForm input[name='Acc_Tela1']").val()) || null;
                    customAcc.Tela2 = parseFloat($("#newOrderForm input[name='Acc_Tela2']").val()) || null;
                    customAcc.Cep = parseFloat($("#newOrderForm input[name='Acc_Cep']").val()) || null;
                    customAcc.Roba = parseFloat($("#newOrderForm input[name='Acc_Roba']").val()) || null;
                    customAcc.Apolet = parseFloat($("#newOrderForm input[name='Acc_Apolet']").val()) || null;
                    customAcc.Diger = parseFloat($("#newOrderForm input[name='Acc_Diger']").val()) || null;

                    orderObj.SelectedAccessoriesJson = JSON.stringify(customAcc);

                    // Map empty decimal/numeric fields to null
                    var unitPriceStr = row.find('.row-unit-price').val() || "";
                    unitPriceStr = unitPriceStr.replace(',', '.');
                    orderObj.UnitPrice = parseFloat(unitPriceStr) || null;
                    if (orderObj.UnitFabricMeterage) orderObj.UnitFabricMeterage = parseFloat(orderObj.UnitFabricMeterage); else orderObj.UnitFabricMeterage = null;
                    if (orderObj.LargeButtonCount) orderObj.LargeButtonCount = parseInt(orderObj.LargeButtonCount); else orderObj.LargeButtonCount = null;
                    if (orderObj.SmallButtonCount) orderObj.SmallButtonCount = parseInt(orderObj.SmallButtonCount); else orderObj.SmallButtonCount = null;
                    if (orderObj.WastageRate) orderObj.WastageRate = parseFloat(orderObj.WastageRate); else orderObj.WastageRate = null;
                    
                    if (!orderObj.CollarInterliningMeterage) orderObj.CollarInterliningMeterage = null;
                    if (!orderObj.CuffInterliningMeterage) orderObj.CuffInterliningMeterage = null;
                    if (!orderObj.PlacketInterliningMeterage) orderObj.PlacketInterliningMeterage = null;
                    if (!orderObj.PocketFlapInterliningMeterage) orderObj.PocketFlapInterliningMeterage = null;

                    orderObj.Color = row.find('.row-color').val();
                    orderObj.OptionCode = "";
                    orderObj.OpenSpecialCode = row.find('.row-open-special-code').val() || "";
                    orderObj.AsortiSpecialCode = row.find('.row-asorti-special-code').val() || "";
                    orderObj.PlannedPackagingEndDate = row.find('.row-inspection-date').val() || null;
                    orderObj.RevisedInspectionDate = row.find('.row-revised-inspection-date').val() || null;
                    orderObj.FabricSupplier = row.find('.row-fabricator').val() || "";
                    orderObj.fabricSupplier = orderObj.FabricSupplier; // Ensure camelCase binding works too

                    orderObj.IsJIT = false;
                    orderObj.SalesRegion = "Yurt İçi";

                    var openDist = Object.assign({}, row.data('openSizes') || {});
                    Object.keys(openDist).forEach(function(key) {
                        if ((parseInt(openDist[key]) || 0) <= 0) {
                            delete openDist[key];
                        }
                    });
                    orderObj.SizeDistributionJson = JSON.stringify(openDist);

                    var asortiDist = Object.assign({}, row.data('asortiSizes') || {});
                    Object.keys(asortiDist).forEach(function(key) {
                        if ((parseInt(asortiDist[key]) || 0) <= 0) {
                            delete asortiDist[key];
                        }
                    });
                    orderObj.AsortiDistributionJson = JSON.stringify(asortiDist);

                    orderObj.SizeS = openDist["S"] || 0;
                    orderObj.SizeM = openDist["M"] || 0;
                    orderObj.SizeL = openDist["L"] || 0;
                    orderObj.SizeXL = openDist["XL"] || 0;
                    orderObj.Size2XL = openDist["2XL"] || 0;
                    orderObj.Size3XL = openDist["3XL"] || 0;

                    orderObj.AsortiSizeS = asortiDist["S"] || 0;
                    orderObj.AsortiSizeM = asortiDist["M"] || 0;
                    orderObj.AsortiSizeL = asortiDist["L"] || 0;
                    orderObj.AsortiSizeXL = asortiDist["XL"] || 0;
                    orderObj.AsortiSize2XL = asortiDist["2XL"] || 0;
                    orderObj.AsortiSize3XL = asortiDist["3XL"] || 0;

                    orderObj.AsortiCount = parseInt(row.find('.row-asorti-count').val()) || 0;
                    orderObj.Quantity = parseInt(row.find('.row-total-qty').val()) || 0;

                    orders.push(orderObj);
                });

                $.ajax({
                    url: '/Order/CreateMultiple',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(orders),
                    success: function(res) {
                        if (res.success) {
                            window.location.href = '/Planning/Index';
                        } else {
                            showToast("Hata: " + res.message, "danger");
                        }
                    },
                    error: function() {
                        showToast("Kayıt sırasında sunucu hatası oluştu.", "danger");
                    }
                });
            });

            function showToast(message, type) {
                $("#floatingToast").remove();

                var bgColor = type === "success" ? "var(--success-bg)" : "var(--danger-bg)";
                var textColor = type === "success" ? "var(--success-text)" : "var(--danger-text)";
                var borderClr = type === "success" ? "rgba(13, 148, 136, 0.2)" : "rgba(220, 38, 38, 0.2)";
                var icon = type === "success" ? "fa-solid fa-circle-check" : "fa-solid fa-circle-exclamation";

                var toast = $('<div id="floatingToast" style="position: fixed; top: 20px; right: 20px; background-color: ' + bgColor + '; color: ' + textColor + '; border: 1px solid ' + borderClr + '; padding: 16px 24px; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); z-index: 9999; display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 0.95rem; min-width: 300px; animation: slideInRight 0.3s cubic-bezier(0.16, 1, 0.3, 1);">' +
                    '<i class="' + icon + '" style="font-size: 1.2rem;"></i>' +
                    '<span>' + message + '</span>' +
                    '</div>');

                $("body").append(toast);

                if ($("#toastStyles").length === 0) {
                    $("head").append('<style id="toastStyles">' +
                        '@@keyframes slideInRight {' +
                        'from { transform: translateX(100%); opacity: 0; }' +
                        'to { transform: translateX(0); opacity: 1; }' +
                        '}' +
                        '</style>');
                }

                setTimeout(function() {
                    $("#floatingToast").fadeOut(400, function() {
                        $(this).remove();
                    });
                }, 3000);
            }



            $("<style type='text/css'> .stock-material-row:hover { cursor: pointer; border-color: #94a3b8 !important; } .stok-detaylari { cursor: default; } </style>").appendTo("head");
        });
    </script>
}
