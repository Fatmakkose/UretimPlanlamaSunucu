@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using UretimPlanlama.Models
@inject UserManager<ApplicationUser> UserManager
@inject IAuthorizationService AuthorizationService
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var fullName = currentUser?.FullName ?? "Misafir";
    var roleTitle = currentUser?.RoleTitle ?? "Kullanıcı";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <script>
        if (window.self !== window.top) {
            document.documentElement.classList.add('in-iframe');
        }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kanuni Tekstil</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="~/images/favicon.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="wrapper modern-layout topbar-layout">
        <!-- YENİ ÜST BAR (TOPBAR) -->
        <header class="main-topbar">
            <!-- Sol Kısım: Logo -->
            <div class="topbar-left">
                <a href="#" id="topbarMenuToggle" title="Menüyü Aç/Kapat">
                    <div class="topbar-logo">
                        <img src="~/images/yeni_logo.png" alt="Kanuni Tekstil Logo" asp-append-version="true" />
                    </div>
                </a>
            </div>

            <!-- ORTA KISIM: SEKMELER -->
            <div id="tab-system-header" class="tab-system-header" style="flex-grow: 1; margin: 0 20px; height: 100%;">
                <div class="tab-list" id="tab-list">
                    <!-- İlk açılış sekmesi (Ana Sayfa) -->
                    <div class="tab-item active" data-tab-id="main-tab" onclick="appTabs.switchTab('main-tab')">
                        <i class="fa-solid fa-house tab-icon"></i>
                        <span class="tab-title" id="main-tab-title">Ana Sayfa</span>
                    </div>
                </div>
            </div>

            <!-- Sağ Kısım: Bildirimler -->
            <div class="topbar-right">
                <div class="notification-container">
                    <button class="bell-btn" id="notificationBellBtn">
                        <i class="fa-regular fa-bell"></i>
                        <span class="notification-badge" id="notificationBadge" style="display: none;">0</span>
                    </button>
                    <div class="notification-dropdown" id="notificationDropdown" style="display: none;">
                        <div class="notification-header">
                            <span>Bildirimler</span>
                            <button id="markAllReadBtn">Tümünü Okundu İşaretle</button>
                        </div>
                        <div class="notification-list" id="notificationList">
                            <div class="notification-empty">
                                <i class="fa-regular fa-bell-slash"></i>
                                <p>Henüz bildiriminiz yok.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <div class="main-container">
            <!-- AÇILIR KAPANIR LACİVERT BAR (İKONLAR) -->
            <aside class="dropdown-sidebar" id="dropdownSidebar" style="display: none;">
                <nav class="sidebar-nav">
                    <ul id="sidebarNavMenu">
                        <li>
                            <a href="/" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" || ViewContext.RouteData.Values["Controller"] == null ? "active" : "")" title="Ana Sayfa">
                                <i class="fa-solid fa-house menu-icon"></i>
                                <span class="nav-text">Ana Sayfa</span>
                            </a>
                        </li>
                        
                        @if ((await AuthorizationService.AuthorizeAsync(User, "SiparisAccess")).Succeeded)
                        {
                            <li>
                                <a href="/Order" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Order" ? "active" : "")" title="Siparişler">
                                    <i class="fa-solid fa-file-invoice menu-icon"></i>
                                    <span class="nav-text">Siparişler</span>
                                </a>
                            </li>
                        }
                        
                        @if ((await AuthorizationService.AuthorizeAsync(User, "PlanlamaAccess")).Succeeded)
                        {
                            <li>
                                <a href="/Planning" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Planning" ? "active" : "")" title="Planlama">
                                    <i class="fa-solid fa-calendar-days menu-icon"></i>
                                    <span class="nav-text">Planlama</span>
                                </a>
                            </li>
                        }

                        @if ((await AuthorizationService.AuthorizeAsync(User, "SurecAccess")).Succeeded)
                        {
                            <li class="has-submenu">
                                <a href="#" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "ProcessTracking" ? "active" : "")" title="Süreç Takibi">
                                    <i class="fa-solid fa-chart-line menu-icon"></i>
                                    <span class="nav-text">Süreç Takibi</span>
                                    <i class="fa-solid fa-chevron-right chevron"></i>
                                </a>
                                <ul class="submenu">
                                    <li><a href="/ProcessTracking"><i class="fa-solid fa-list menu-icon"></i><span class="nav-text">Tüm Süreçler</span></a></li>
                                    <li><a href="/ProcessTracking/Index?step=purchase"><i class="fa-solid fa-truck menu-icon"></i><span class="nav-text">Sevk Onay</span></a></li>
                                    <li><a href="/ProcessTracking/Index?step=timeline"><i class="fa-solid fa-calendar-check menu-icon"></i><span class="nav-text">CPS</span></a></li>
                                    <li><a href="/ProcessTracking/Index?step=cutting"><i class="fa-solid fa-scissors menu-icon"></i><span class="nav-text">Kesim Süreci</span></a></li>
                                    <li><a href="/ProcessTracking/Index?step=packing"><i class="fa-solid fa-box menu-icon"></i><span class="nav-text">Çeki Listesi</span></a></li>
                                    <li><a href="/ProcessTracking/Index?step=fileclosing"><i class="fa-solid fa-file-signature menu-icon"></i><span class="nav-text">Dosya Kapama</span></a></li>
                                </ul>
                            </li>
                            <li>
                                <a href="/WorkshopCapacity" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "WorkshopCapacity" ? "active" : "")" title="Atölye Takibi">
                                    <i class="fa-solid fa-industry menu-icon"></i>
                                    <span class="nav-text">Atölye Takibi</span>
                                </a>
                            </li>
                        }

                        @if ((await AuthorizationService.AuthorizeAsync(User, "RaporAccess")).Succeeded)
                        {
                            <li class="has-submenu">
                                <a href="#" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Finance" ? "active" : "")" title="Cari Yönetimi">
                                    <i class="fa-solid fa-coins menu-icon"></i>
                                    <span class="nav-text">Cari Yönetimi</span>
                                    <i class="fa-solid fa-chevron-right chevron"></i>
                                </a>
                                <ul class="submenu">
                                    <li><a href="/Finance/Definitions"><i class="fa-solid fa-address-book menu-icon"></i><span class="nav-text">Cari Tanımı</span></a></li>
                                    <li><a href="/Finance/Purchase"><i class="fa-solid fa-cart-arrow-down menu-icon"></i><span class="nav-text">Alış İşlemleri</span></a></li>
                                    <li><a href="/Finance/Sales"><i class="fa-solid fa-money-bill-trend-up menu-icon"></i><span class="nav-text">Satış İşlemleri</span></a></li>
                                    <li><a href="/Finance/Reports"><i class="fa-solid fa-list-check menu-icon"></i><span class="nav-text">Raporlar</span></a></li>
                                </ul>
                            </li>
                        }
                        
                        @if ((await AuthorizationService.AuthorizeAsync(User, "DepoAccess")).Succeeded)
                        {
                            <li class="has-submenu">
                                <a href="#" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Stock" ? "active" : "")" title="Stok Yönetimi">
                                    <i class="fa-solid fa-boxes-stacked menu-icon"></i>
                                    <span class="nav-text">Stok Yönetimi</span>
                                    <i class="fa-solid fa-chevron-right chevron"></i>
                                </a>
                                <ul class="submenu">
                                    <li><a href="/Stock/Definitions"><i class="fa-solid fa-box-open menu-icon"></i><span class="nav-text">Stok Tanımı</span></a></li>
                                    <li><a href="/Stock/Movements"><i class="fa-solid fa-arrow-right-arrow-left menu-icon"></i><span class="nav-text">Hareketler</span></a></li>
                                    <li><a href="/Stock/Warehouse"><i class="fa-solid fa-warehouse menu-icon"></i><span class="nav-text">Depo</span></a></li>
                                </ul>
                            </li>
                        }
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="has-submenu">
                                <a href="#" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Definitions" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ColorDef" || ViewContext.RouteData.Values["Controller"]?.ToString() == "Authorization" ? "active" : "")" title="Yönetim">
                                    <i class="fa-solid fa-gears menu-icon"></i>
                                    <span class="nav-text">Yönetim</span>
                                    <i class="fa-solid fa-chevron-right chevron"></i>
                                </a>
                                <ul class="submenu">
                                    <li><a href="/Authorization" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Authorization" ? "active" : "")"><i class="fa-solid fa-user-shield menu-icon"></i><span class="nav-text">Yetkilendirme</span></a></li>
                                    <li><a href="/ColorDef/Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "ColorDef" ? "active" : "")"><i class="fa-solid fa-palette menu-icon"></i><span class="nav-text">Renk Tanımı</span></a></li>
                                    <li><a href="/Definitions/Workshops" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Workshops" ? "active" : "")"><i class="fa-solid fa-industry menu-icon"></i><span class="nav-text">Atölye Tanımı</span></a></li>
                                    <li><a href="/Definitions/Fabricators" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Fabricators" ? "active" : "")"><i class="fa-solid fa-truck menu-icon"></i><span class="nav-text">Kumaşçı Tanımı</span></a></li>
                                    <li><a href="/Definitions/Customers" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Customers" ? "active" : "")"><i class="fa-solid fa-building menu-icon"></i><span class="nav-text">Müşteri Tanımı</span></a></li>
                                    <li><a href="/Definitions/Companies" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Companies" ? "active" : "")"><i class="fa-solid fa-building-user menu-icon"></i><span class="nav-text">Firma Tanımı</span></a></li>
                                    <li><a href="/Definitions/Brands" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Brands" ? "active" : "")"><i class="fa-solid fa-copyright menu-icon"></i><span class="nav-text">Marka Tanımı</span></a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                </nav>

                <div class="sidebar-profile" title="Profil: @fullName">
                    <img src="https://ui-avatars.com/api/?name=@fullName&background=fff&color=1e1e2d" alt="Profile" id="sidebarProfileImg" />
                    <span class="nav-text">@fullName</span>
                </div>
            </aside>

            <!-- ANA İÇERİK -->
            <div class="main-content-wrapper" id="main-content-wrapper">
                
                <!-- Sekme İçerikleri -->
                <div id="tab-system-content" class="tab-system-content">
                    <div class="tab-pane active" id="pane-main-tab">
                        <main class="main-content">
                            @RenderBody()
                        </main>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // TOPBAR - İKONLARI AŞAĞI DOĞRU AÇMA/KAPAMA (LOGOYLA)
            $('#topbarMenuToggle').click(function(e) {
                e.preventDefault();
                e.stopPropagation();
                // .dropdown-sidebar div'ini yavaşça aşağıya süzülerek aç/kapat
                $('#dropdownSidebar').slideToggle(300);
            });

            // Alt menüleri (accordion) açıp kapama
            $('.has-submenu > a').click(function(e) {
                e.preventDefault();
                var $submenu = $(this).siblings('.submenu');
                var $icon = $(this).find('.chevron');
                
                // Toggle clicked submenu
                $submenu.slideToggle(200);
                if ($icon.hasClass('fa-chevron-right')) {
                    $icon.removeClass('fa-chevron-right').addClass('fa-chevron-down');
                } else {
                    $icon.removeClass('fa-chevron-down').addClass('fa-chevron-right');
                }
                
                // Close other submenus
                $(this).parent().siblings().find('.submenu').slideUp(200);
                $(this).parent().siblings().find('.chevron').removeClass('fa-chevron-down').addClass('fa-chevron-right');
            });

            // Menü dışına tıklandığında menüyü kapat
            $(document).click(function(e) {
                if (!$(e.target).closest('#dropdownSidebar').length && !$(e.target).closest('#topbarMenuToggle').length) {
                    $('#dropdownSidebar').slideUp(300);
                }
            });

            // Gereksiz bildirim aç/kapat bloğu silindi (çakışmayı önlemek için)

            $(document).click(function() {
                $('#notificationDropdown').fadeOut(150);
                $('#notificationBellBtn').removeClass('active');
            });


            // --- Gerçek Zamanlı Bildirim Sistemi JS ---
            const $bellBtn = $('#notificationBellBtn');
            const $dropdown = $('#notificationDropdown');
            const $badge = $('#notificationBadge');
            const $list = $('#notificationList');
            const $markAllBtn = $('#markAllReadBtn');
            
            // Açılır menüyü aç/kapat
            $bellBtn.on('click', function(e) {
                e.stopPropagation();
                const isOpen = $dropdown.is(':visible');
                
                // Diğer açılır menüleri kapat
                $('#userProfileDropdown .dropdown-menu').fadeOut(150);
                $('#userProfileDropdown').removeClass('active');
                $('#mainNavbarMenu').removeClass('show-menu');
                
                if (isOpen) {
                    $dropdown.fadeOut(150);
                    $bellBtn.removeClass('active');
                } else {
                    $dropdown.fadeIn(150);
                    $bellBtn.addClass('active');
                }
            });
            
            $dropdown.on('click', function(e) {
                e.stopPropagation();
            });
            
            // Bildirimleri getir
            function loadNotifications() {
                $.ajax({
                    url: '/Notifications/GetUnread',
                    type: 'GET',
                    success: function(data) {
                        renderNotifications(data.notifications, data.unreadCount);
                    }
                });
            }
            
            function renderNotifications(notifications, unreadCount) {
                if (unreadCount > 0) {
                    $badge.text(unreadCount).show();
                } else {
                    $badge.hide();
                }
                
                if (!notifications || notifications.length === 0) {
                    $list.html(`
                        <div class="notification-empty">
                            <i class="fa-regular fa-bell-slash"></i>
                            <p>Henüz bildiriminiz yok.</p>
                        </div>
                    `);
                    return;
                }
                
                let html = '';
                notifications.forEach(function(notif) {
                    let icon = 'fa-bell';
                    let bg = '#f1f5f9';
                    let color = '#475569';
                    
                    if (notif.type === 'Kesim') {
                        icon = 'fa-scissors';
                        bg = '#fffbeb';
                        color = '#d97706';
                    } else if (notif.type === 'Dikim') {
                        icon = 'fa-shirt';
                        bg = '#ecfeff';
                        color = '#0891b2';
                    } else if (notif.type === 'Kumaş') {
                        icon = 'fa-truck';
                        bg = '#e0e7ff';
                        color = '#4f46e5';
                    } else if (notif.type === 'Paket') {
                        icon = 'fa-box';
                        bg = '#fdf2f8';
                        color = '#db2777';
                    }
                    
                    const unreadClass = !notif.isRead ? 'unread' : '';
                    
                    html += `
                        <div class="notification-item ${unreadClass}" data-id="${notif.id}" data-order-id="${notif.orderId || ''}" style="cursor: pointer;">
                            <div class="notification-icon-wrapper" style="background: ${bg}; color: ${color};">
                                <i class="fa-solid ${icon}"></i>
                            </div>
                            <div class="notification-info">
                                <div class="notification-title-row">
                                    <strong class="notification-title">${notif.title}</strong>
                                    <span class="notification-time">${notif.createdAt}</span>
                                </div>
                                <p class="notification-message">${notif.message}</p>
                            </div>
                        </div>
                    `;
                });
                
                $list.html(html);
                
                $('.notification-item').off('click').on('click', function() {
                    const id = $(this).data('id');
                    const orderId = $(this).data('order-id');
                    const $item = $(this);
                    $.ajax({
                        url: '/Notifications/MarkAsRead',
                        type: 'POST',
                        data: { id: id },
                        success: function() {
                            $item.removeClass('unread');
                            loadNotifications();
                            if (orderId) {
                                window.location.href = '/ProcessTracking/Track/' + orderId + '#timeline';
                            }
                        }
                    });
                });
            }
            
            $markAllBtn.on('click', function(e) {
                e.preventDefault();
                $.ajax({
                    url: '/Notifications/MarkAllAsRead',
                    type: 'POST',
                    success: function() {
                        loadNotifications();
                    }
                });
            });
            
            loadNotifications();
            
            // SignalR Kurulumu
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .configureLogging(signalR.LogLevel.Information)
                .build();
                
            connection.on("ReceiveNotification", function(notif) {
                showLiveToast(notif.title, notif.message, notif.type);
                loadNotifications();
            });
            
            connection.start().catch(function(err) {
                return console.error(err.toString());
            });
            
            function showLiveToast(title, message, type) {
                let icon = 'fa-bell';
                let bg = 'var(--primary-color)';
                
                if (type === 'Kesim') {
                    icon = 'fa-scissors';
                    bg = '#eab308';
                } else if (type === 'Dikim') {
                    icon = 'fa-shirt';
                    bg = '#06b6d4';
                } else if (type === 'Kumaş') {
                    icon = 'fa-truck';
                    bg = '#6366f1';
                } else if (type === 'Paket') {
                    icon = 'fa-box';
                    bg = '#ec4899';
                }
                
                const toastId = 'toast-' + Date.now();
                const $toast = $(`
                    <div id="${toastId}" class="live-toast">
                        <div class="live-toast-icon" style="background: ${bg};">
                            <i class="fa-solid ${icon}"></i>
                        </div>
                        <div class="live-toast-content">
                            <div class="live-toast-header">
                                <strong class="live-toast-title">${title}</strong>
                                <button class="live-toast-close" onclick="$('#${toastId}').fadeOut(300, function(){ $(this).remove(); })">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                            <p class="live-toast-message">${message}</p>
                        </div>
                    </div>
                `);
                
                $('body').append($toast);
                
                setTimeout(function() {
                    $(`#${toastId}`).fadeOut(400, function() {
                        $(this).remove();
                    });
                }, 5000);
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
